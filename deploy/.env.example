# Cartex server o'rnatish sozlamalari.
# Nusxa oling: cp .env.example .env — keyin qiymatlarni to'ldiring.
# .env faylni hech qachon git'ga qo'shmang.

# Majburiy
DB_PASSWORD=
JWT_KEY=
DEVELOPER_PASSWORD=
ADMIN_PASSWORD=

# Ixtiyoriy — mijozning barkod prefiksi (default: CTX)
BARCODE_PREFIX=CTX

# minio profili uchun (docker compose --profile minio up -d).
# Bo'sh qoldirsangiz minio ishga tushmaydi — minio profilisiz ular kerak emas.
MINIO_USER=cartex
MINIO_PASSWORD=

# tls YOKI traefik profili uchun (docker compose --profile tls up -d / --profile traefik up -d).
# Ikkalasi ham 80/443 portini so'raydi — bir vaqtda faqat bittasi ishga tushirilsin.
DOMAIN=

# traefik profili uchun (docker compose --profile traefik up -d) — Let's Encrypt HTTPS
# va /pgadmin (baza boshqaruvi) shu profil bilan qo'shiladi.
ACME_EMAIL=
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# backup profili uchun (docker compose --profile backup up -d) — Zaxira agenti.
# PG zaxirasi avtomatik; MinIO ishlatilsa quyidagilarni to'ldiring:
#   BACKUP_MINIO_ENDPOINT=http://minio:9000
#   BACKUP_MINIO_BUCKET=cartex
# Bulutga yuklash uchun deploy/rclone.conf yarating (rclone config) va remote nomini bering:
#   BACKUP_RCLONE_REMOTE=gdrive
#   BACKUP_RCLONE_PATH=backups/cartex
# Jadval (cron): default har kuni 03:00
#   BACKUP_SCHEDULE=0 3 * * *
# Zaxira Hub'ga ulash (ixtiyoriy): ZAXIRA_HUB_URL= / ZAXIRA_HUB_TOKEN=
BACKUP_MINIO_ENDPOINT=
BACKUP_MINIO_BUCKET=
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_PATH=backups/cartex

# Kalit yaratish (Linux/macOS):
#   openssl rand -base64 48
# Windows PowerShell:
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
