# Bu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring:
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env hech qachon repoga yoki boshqa joyga yuborilmaydi.

# ===== Majburiy =====

# Postgres paroli (kuchli, kamida 16 belgi)
DB_PASSWORD=

# JWT imzo kaliti, KAMIDA 64 belgi. Yaratish:
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
#   Linux/Mac:   openssl rand -base64 48
JWT_KEY=

# Birinchi ishga tushishda yaratiladigan foydalanuvchilar parollari
DEVELOPER_PASSWORD=
ADMIN_PASSWORD=

# pgAdmin kirishi (http://localhost:5050)
PGADMIN_EMAIL=admin@cartex.local
PGADMIN_PASSWORD=

# ===== Ixtiyoriy =====

# Imij versiyasi — yangilashda shu raqam ko'tariladi
CARTEX_VERSION=0.0.2

# Ichki barkodlar prefiksi (do'konga xos 3 harf)
BARCODE_PREFIX=CTX

WEB_PORT=8080
PGADMIN_PORT=5050
TZ=Asia/Tashkent

# Faqat --profile minio ishlatilsa kerak bo'ladi
MINIO_USER=cartex
MINIO_PASSWORD=
