<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:QueueViewModel"
    Title="{svc:T queue}">
    <ContentPage.Resources>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="MinimumHeightRequest" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*" RowSpacing="10" Padding="16,12,16,0">

        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Text="{svc:T queue_open}" Style="{StaticResource Chip}"
                        Command="{Binding SelectStatusCommand}" CommandParameter="Open">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedStatus}" Value="Open">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="{svc:T queue_confirmed}" Style="{StaticResource Chip}"
                        Command="{Binding SelectStatusCommand}" CommandParameter="Confirmed">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedStatus}" Value="Confirmed">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="{svc:T queue_sold}" Style="{StaticResource Chip}"
                        Command="{Binding SelectStatusCommand}" CommandParameter="CheckedOut">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedStatus}" Value="CheckedOut">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="{svc:T queue_cancelled}" Style="{StaticResource Chip}"
                        Command="{Binding SelectStatusCommand}" CommandParameter="Cancelled">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedStatus}" Value="Cancelled">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Carts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueueRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:QueueViewModel}}}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding CreatedBy}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                        <Label Text="{Binding TimeText}" Style="{StaticResource MutedLabel}" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding CustomerText}" Style="{StaticResource MutedLabel}" FontSize="13" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SummaryText}" FontSize="13.5" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    <Label Text="{Binding NoteText}" FontAttributes="Italic" FontSize="12.5" IsVisible="{Binding HasNote}"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="{StaticResource IcClose}" FontFamily="MDI" FontSize="18"
                                        WidthRequest="38" HeightRequest="38" MinimumHeightRequest="38" CornerRadius="19" Padding="0"
                                        VerticalOptions="Start" BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                        IsVisible="{Binding CanCancel}"
                                        Command="{Binding CancelCommand, Source={RelativeSource AncestorType={x:Type vm:QueueViewModel}}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="12" Margin="0,60,0,0" HorizontalOptions="Center">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 32" WidthRequest="64" HeightRequest="64"
                                HorizontalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Label Text="{StaticResource IcCart}" Style="{StaticResource Icon}" FontSize="30" />
                        </Border>
                        <Label Text="{svc:T queue_empty}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
