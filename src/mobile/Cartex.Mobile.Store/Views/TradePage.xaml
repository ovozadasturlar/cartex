<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.TradePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:TradeViewModel"
    Title="{svc:T sales}">
    <ContentPage.Resources>
        <Style x:Key="Section" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="QueueChip" TargetType="Button">
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="MinimumHeightRequest" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Padding="16,12,16,0">
        <Grid ColumnDefinitions="*,*" Padding="4" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
            <Button Text="{svc:T queue}" Style="{StaticResource Section}" Command="{Binding ShowQueueCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsQueue}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="{svc:T sales}" Style="{StaticResource Section}" Command="{Binding ShowSalesCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsSales}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding IsQueue}">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding QueueStatuses}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueueStatusChip">
                        <Button Text="{Binding Text}" Style="{StaticResource QueueChip}"
                                Command="{Binding SelectQueueStatusCommand, Source={RelativeSource AncestorType={x:Type vm:TradeViewModel}}}"
                                CommandParameter="{Binding .}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <Grid>
                <CollectionView ItemsSource="{Binding Carts}" IsVisible="{Binding IsQueue}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TradeQueueRow">
                            <SwipeView Margin="0,0,0,10">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem Text="{svc:T edit}" IsVisible="{Binding CanEdit}"
                                                   Command="{Binding EditQueueCommand, Source={RelativeSource AncestorType={x:Type vm:TradeViewModel}}}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenQueueCommand, Source={RelativeSource AncestorType={x:Type vm:TradeViewModel}}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding CreatedBy}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                            <Label Text="{Binding TimeText}" Style="{StaticResource MutedLabel}" FontSize="12" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding CustomerText}" Style="{StaticResource MutedLabel}" FontSize="13" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding SummaryText}" FontSize="13.5" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Label Text="{Binding NoteText}" FontAttributes="Italic" FontSize="12.5" IsVisible="{Binding HasNote}"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="{StaticResource IcClose}" FontFamily="MDI" FontSize="18"
                                            WidthRequest="38" HeightRequest="38" MinimumHeightRequest="38" CornerRadius="19" Padding="0"
                                            VerticalOptions="Start" BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                            IsVisible="{Binding CanCancel}"
                                            Command="{Binding CancelQueueCommand, Source={RelativeSource AncestorType={x:Type vm:TradeViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="12" Margin="0,60,0,0" HorizontalOptions="Center">
                            <Label Text="{svc:T queue_empty}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <ScrollView IsVisible="{Binding IsSales}">
                    <VerticalStackLayout Spacing="12" Padding="0,0,0,16">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{svc:T sales}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <Label Text="{Binding TodayTotal}" FontSize="24" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{svc:T items_short}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <Label Text="{Binding TodayCount}" FontSize="24" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sales}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TradeSaleRow">
                                    <Border Style="{StaticResource Card}" Padding="14,12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding SubLine}" Style="{StaticResource MutedLabel}" FontSize="13" />
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{svc:T cash}" Style="{StaticResource MutedLabel}" FontSize="12" IsVisible="{Binding HasCash}" />
                                                    <Label Text="{svc:T card}" Style="{StaticResource MutedLabel}" FontSize="12" IsVisible="{Binding HasCard}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Total}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{svc:T queue_empty}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center"
                               IsVisible="{Binding IsSalesEmpty}" Margin="0,40" />
                    </VerticalStackLayout>
                </ScrollView>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   VerticalOptions="Center" HorizontalOptions="Center" />
                <Label Text="{Binding Error}" Style="{StaticResource TxDanger}" IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}"
                       VerticalOptions="Center" HorizontalOptions="Center" />
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>
