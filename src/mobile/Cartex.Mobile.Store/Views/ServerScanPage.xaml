<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.ServerScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    Title="{svc:T server_qr}">
    <Grid>
        <scanner:CameraView
            x:Name="Reader"
            BarcodeSymbologies="QRCode"
            OnDetectionFinished="OnDetectionFinished" />
        <Border VerticalOptions="Center" HorizontalOptions="Center"
                WidthRequest="240" HeightRequest="240"
                StrokeThickness="3" StrokeShape="RoundRectangle 24"
                Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                BackgroundColor="Transparent" />
    </Grid>
</ContentPage>
