<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:DevicesViewModel"
    Title="{svc:T devices}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,24" Spacing="14">
            <Border Style="{StaticResource Card}" Padding="18,24">
                <VerticalStackLayout Spacing="14">
                    <Label Text="💻" FontSize="52" HorizontalOptions="Center" />
                    <Label Text="{svc:T link_device_hint}" Style="{StaticResource MutedLabel}" FontSize="13.5"
                           HorizontalTextAlignment="Center" />
                    <Button Text="{svc:T link_device}" Style="{StaticResource BtnPrimary}" Command="{Binding OpenScanCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding Error}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </Border>

            <Label Text="{svc:T this_device}" Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="6,4,0,-6"
                   IsVisible="{Binding Current, Converter={StaticResource NotEmpty}}" />
            <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding Current, Converter={StaticResource NotEmpty}}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="10,12">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                            <Label Text="{StaticResource IcDevices}" Style="{StaticResource Icon}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Current.Name}" FontSize="14.5" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Label Text="{Binding Current.SubLine}" Style="{StaticResource MutedLabel}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Margin="62,0,10,0"
                             Color="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}"
                             IsVisible="{Binding HasOthers}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="10,13" IsVisible="{Binding HasOthers}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TerminateOthersCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="✋" FontSize="19" WidthRequest="40" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{svc:T terminate_all}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Text="{svc:T terminate_all_hint}" Style="{StaticResource MutedLabel}" FontSize="11.5" Margin="6,-6,6,0"
                   IsVisible="{Binding HasOthers}" />

            <Label Text="{svc:T active_sessions}" Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="6,4,0,-6"
                   IsVisible="{Binding HasOthers}" />
            <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding HasOthers}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Others}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,11">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Info}, Dark={StaticResource Info}}">
                                    <Label Text="{StaticResource IcDevices}" Style="{StaticResource Icon}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="14.5" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="{Binding SubLine}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="{svc:T device_revoke}"
                                        BackgroundColor="Transparent" FontSize="13" Padding="10,0" HeightRequest="34"
                                        TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                        Command="{Binding RevokeCommand, Source={RelativeSource AncestorType={x:Type vm:DevicesViewModel}}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
