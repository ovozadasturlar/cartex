<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.CartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:services="clr-namespace:Cartex.Mobile.Store.Services"
    xmlns:models="clr-namespace:Cartex.Shared.Models.Customers;assembly=Cartex.Shared"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    xmlns:ctl="clr-namespace:Cartex.Mobile.Core.Controls;assembly=Cartex.Mobile.Core"
    x:DataType="vm:CartViewModel"
    Title="{svc:T cart_title}">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto">
            
            <VerticalStackLayout Padding="16,12" Spacing="10" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                <Border Style="{StaticResource Card}" Padding="14,6" IsVisible="{Binding HasCustomer}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Text="{StaticResource IcAccount}" Style="{StaticResource Icon}" />
                        <Label Grid.Column="1" Text="{Binding CustomerName}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Button Grid.Column="2" FontFamily="MDI" Text="{StaticResource IcClose}" FontSize="16"
                                WidthRequest="36" HeightRequest="40" CornerRadius="10" Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                Command="{Binding ClearCustomerCommand}" />
                    </Grid>
                </Border>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasCustomer, Converter={StaticResource Invert}}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Placeholder="{svc:T search_customer}" Text="{Binding CustomerSearch}" ClearButtonVisibility="WhileEditing" />
                        </Border>
                        <Button Grid.Column="1" FontFamily="MDI" Text="{StaticResource IcPlus}" FontSize="20"
                                WidthRequest="48" HeightRequest="48" CornerRadius="12" Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                TextColor="White"
                                Command="{Binding OpenCustomerModalCommand}" />
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="6" IsVisible="{Binding HasCustomers}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Customers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomerDto">
                                    <Grid Padding="10,8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PickCustomerCommand, Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="{Binding FullName}" FontSize="14" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                        <Label Grid.Column="1" Text="{Binding Phone}" Style="{StaticResource MutedLabel}" FontSize="12"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Lines}" Margin="16,8"
                            ItemsLayout="VerticalList" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="{svc:T cart_empty}" Style="{StaticResource MutedLabel}" FontSize="15"
                           HorizontalOptions="Center" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:CartLine">
                        <SwipeView Margin="0,0,0,8" SwipeStarted="OnSwipeStarted" SwipeEnded="OnSwipeEnded">
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                    <SwipeItemView Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}}" CommandParameter="{Binding .}">
                                        <Border WidthRequest="58" StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}">
                                            <Label Text="{StaticResource IcDelete}" FontFamily="MDI" FontSize="22"
                                                   HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                    <SwipeItemView Command="{Binding IncrementCommand, Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}}" CommandParameter="{Binding .}">
                                        <Border WidthRequest="52" StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBg}, Dark={StaticResource PrimaryBgDark}}">
                                            <Label Text="+" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        </Border>
                                    </SwipeItemView>
                                    <SwipeItemView>
                                        <Border WidthRequest="64" StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBg}, Dark={StaticResource PrimaryBgDark}}">
                                            <Label Text="{Binding Quantity, StringFormat='{0:0.###}'}" FontSize="16" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                        </Border>
                                    </SwipeItemView>
                                    <SwipeItemView Command="{Binding DecrementCommand, Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}}" CommandParameter="{Binding .}">
                                        <Border WidthRequest="52" StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBg}, Dark={StaticResource PrimaryBgDark}}">
                                            <Label Text="−" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Padding="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenProductModalCommand, Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <ctl:Thumb Source="{Binding ImageKey}" Size="40" Radius="8" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding ProductName}" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                        <Label Style="{StaticResource MutedLabel}" FontSize="12">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding UnitPrice, StringFormat='{0:N0} UZS'}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding UnitName}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Quantity, StringFormat='{0:0.###}'}"
                                           FontAttributes="Bold" FontSize="15" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSwiped}" Value="True">
                                                <Setter Property="Opacity" Value="0" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Grid.Row="2" StrokeThickness="1" Padding="16,12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{svc:T total}" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Label Text="{Binding TotalText}" FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </VerticalStackLayout>
                    
                    <Button Grid.Column="1" Text="→" FontSize="20" FontAttributes="Bold" WidthRequest="64" HeightRequest="48"
                            Style="{StaticResource BtnPrimary}" Command="{Binding NextCommand}"
                            IsEnabled="{Binding IsEmpty, Converter={StaticResource Invert}}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3" BackgroundColor="#CC000000" IsVisible="{Binding IsCustomerModalOpen}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCustomerModalCommand}" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource Card}" Padding="20" Margin="24" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="16">
                    <Label Text="{svc:T add_new}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{svc:T customer}" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Text="{Binding NewCustomerName}" Placeholder="Ism Familiya" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Telefon" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Text="{Binding NewCustomerPhone}" Keyboard="Telephone" Placeholder="+998" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Text="{svc:T cancel}" Style="{StaticResource BtnOutline}" Command="{Binding CloseCustomerModalCommand}" />
                        <Button Grid.Column="1" Text="{svc:T save}" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCustomerCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3" BackgroundColor="#CC000000" IsVisible="{Binding IsProductModalOpen}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseProductModalCommand}" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource Card}" Padding="20" Margin="24" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="16">
                    <Grid HeightRequest="160" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceDark}}">
                        <ctl:Thumb Source="{Binding SelectedProductImage}" Size="160" Stretch="True" Radius="0" />
                        
                        <Button FontFamily="MDI" Text="{StaticResource IcClose}" FontSize="18" Padding="0"
                                WidthRequest="40" HeightRequest="40" CornerRadius="20"
                                VerticalOptions="Start" HorizontalOptions="Start" Margin="10,10,0,0"
                                BackgroundColor="#CC000000" TextColor="White"
                                Command="{Binding CloseProductModalCommand}" />
                    </Grid>

                    <VerticalStackLayout Spacing="4" BindingContext="{Binding SelectedProduct}">
                        <Label Text="{Binding ProductName, FallbackValue=''}" FontAttributes="Bold" FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Style="{StaticResource MutedLabel}" FontSize="14">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding UnitPrice, StringFormat='{0:N0} UZS', FallbackValue=''}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding UnitName, FallbackValue=''}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16" HorizontalOptions="Center" Margin="0,10">
                        <Button Text="−" FontSize="24" WidthRequest="56" HeightRequest="56" CornerRadius="16" Padding="0"
                                Style="{StaticResource BtnOutline}" BorderWidth="1"
                                Command="{Binding DecrementSelectedCommand}" />
                        
                        <Label Grid.Column="1" BindingContext="{Binding SelectedProduct}" Text="{Binding Quantity, StringFormat='{0:0.###}', FallbackValue='0'}" 
                               WidthRequest="80" HorizontalTextAlignment="Center" VerticalOptions="Center" 
                               FontSize="22" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                               
                        <Button Grid.Column="2" Text="+" FontSize="24" WidthRequest="56" HeightRequest="56" CornerRadius="16" Padding="0"
                                Style="{StaticResource BtnOutline}" BorderWidth="1"
                                Command="{Binding IncrementSelectedCommand}" />
                    </Grid>

                    <Button Text="O'chirish" FontFamily="MDI" Style="{StaticResource BtnOutline}" 
                            TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                            BorderColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                            Command="{Binding RemoveSelectedCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
