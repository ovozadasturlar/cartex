<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:Cartex.Mobile.Store.Controls"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border x:Name="StaleBanner" Grid.Row="0" IsVisible="False" BackgroundColor="#9A3412" Padding="12,8">
            <Label x:Name="StaleText" TextColor="White" FontSize="12" HorizontalTextAlignment="Center" />
        </Border>
        <Grid x:Name="Host" Grid.Row="1" />
        <ctl:LiquidTabBar x:Name="Bar" Grid.Row="1" />
        <Grid x:Name="AccessLoading" Grid.RowSpan="2" BackgroundColor="{AppThemeBinding Light=#F7F8F5, Dark=#111814}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label Text="{svc:T loading}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
        <Grid x:Name="AccessFailure" Grid.RowSpan="2" IsVisible="False"
              BackgroundColor="{AppThemeBinding Light=#F7F8F5, Dark=#111814}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="16" Padding="28" MaximumWidthRequest="520">
                <Label Text="{svc:T access_load_failed}" FontSize="22" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="AccessFailureText" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#59645D, Dark=#B8C4BC}" />
                <Button Text="{svc:T retry}" Clicked="RetryAccess_Clicked"
                        HorizontalOptions="Center" MinimumWidthRequest="160" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
