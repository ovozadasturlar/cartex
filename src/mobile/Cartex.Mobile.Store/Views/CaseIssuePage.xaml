<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.CaseIssuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:ctl="clr-namespace:Cartex.Mobile.Core.Controls;assembly=Cartex.Mobile.Core"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:CaseIssueViewModel"
    Title="{svc:T issue_goods}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12" IsVisible="{Binding IsLoaded}">
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding CaseTitle}" FontSize="16" FontAttributes="Bold" />
                        <Label Text="{Binding CustomerName}" Style="{StaticResource MutedLabel}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Style="{StaticResource InputWrap}">
                        <Entry Text="{Binding BarcodeText}" Placeholder="{svc:T scan_or_enter_barcode}" ReturnType="Done" ReturnCommand="{Binding AddBarcodeCommand}" />
                    </Border>
                    <Button Grid.Column="1" Text="{StaticResource IcBarcode}" FontFamily="MDI" WidthRequest="48" HeightRequest="48" Padding="0" Command="{Binding AddBarcodeCommand}" />
                </Grid>
                <Border Style="{StaticResource InputWrap}">
                    <Entry Text="{Binding SearchText}" Placeholder="{svc:T search_product}" ClearButtonVisibility="WhileEditing" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="6" IsVisible="{Binding HasResults}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SearchResults}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CartEditSearchRow">
                                <Grid Padding="10,9" ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding PickProductCommand, Source={RelativeSource AncestorType={x:Type vm:CaseIssueViewModel}}}" CommandParameter="{Binding .}" /></Grid.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2"><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Meta}" Style="{StaticResource MutedLabel}" FontSize="11" /></VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{StaticResource IcPlus}" FontFamily="MDI" Style="{StaticResource Icon}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CartEditLine">
                            <Border Style="{StaticResource Card}" Padding="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <ctl:Thumb Source="{Binding ImageKey}" Size="42" Radius="9" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding ProductName}" FontSize="14" FontAttributes="Bold" />
                                        <Grid ColumnDefinitions="Auto,82,Auto" ColumnSpacing="6">
                                            <ctl:HoldRepeatButton Text="−" WidthRequest="38" HeightRequest="38" Padding="0" Style="{StaticResource BtnOutline}" RepeatCommand="{Binding DecrementCommand, Source={RelativeSource AncestorType={x:Type vm:CaseIssueViewModel}}}" RepeatCommandParameter="{Binding .}" />
                                            <Border Grid.Column="1" Style="{StaticResource InputWrap}" Padding="0"><Entry Text="{Binding QuantityText}" Keyboard="Numeric" ReturnType="Done" HeightRequest="38" HorizontalTextAlignment="Center" FontAttributes="Bold" ReturnCommand="{Binding CommitQuantityCommand, Source={RelativeSource AncestorType={x:Type vm:CaseIssueViewModel}}}" ReturnCommandParameter="{Binding .}" Unfocused="OnQuantityUnfocused" /></Border>
                                            <ctl:HoldRepeatButton Grid.Column="2" Text="+" WidthRequest="38" HeightRequest="38" Padding="0" Style="{StaticResource BtnOutline}" RepeatCommand="{Binding IncrementCommand, Source={RelativeSource AncestorType={x:Type vm:CaseIssueViewModel}}}" RepeatCommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="{StaticResource IcDelete}" FontFamily="MDI" WidthRequest="38" HeightRequest="38" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type vm:CaseIssueViewModel}}}" CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource InputWrap}"><Editor Text="{Binding Note}" Placeholder="{svc:T note_placeholder}" AutoSize="TextChanges" /></Border>
                <Border Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}" IsVisible="{Binding HasError}"><Label Text="{Binding Error}" Style="{StaticResource TxDanger}" /></Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" StrokeThickness="1" Padding="16,12" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="1" VerticalOptions="Center"><Label Text="{svc:T estimated_total}" Style="{StaticResource MutedLabel}" FontSize="11" /><Label Text="{Binding TotalText}" FontSize="19" FontAttributes="Bold" /></VerticalStackLayout>
                <Button Grid.Column="1" Text="{svc:T issue_goods}" Style="{StaticResource BtnPrimary}" WidthRequest="130" Command="{Binding SaveCommand}" IsEnabled="{Binding HasLines}" />
            </Grid>
        </Border>
        <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
