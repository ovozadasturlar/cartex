<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.OfflineSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:OfflineSettingsViewModel"
    Title="{svc:T offline_mode}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,24" Spacing="14">
            <Border Style="{StaticResource Card}" Padding="6,2">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,12">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36"
                            VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBg}, Dark={StaticResource PrimaryBgDark}}">
                        <Label Text="{StaticResource IcSync}" Style="{StaticResource Icon}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{svc:T offline_mode}" FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Text="{Binding OfflineStatus}" Style="{StaticResource MutedLabel}" FontSize="11"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="2" IsToggled="{Binding OfflineEnabled}" VerticalOptions="Center"
                            IsEnabled="{Binding OfflineBusy, Converter={StaticResource Invert}}"
                            OnColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Grid>
            </Border>
            <Label Text="{svc:T offline_mode_hint}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="6,-6,6,0"
                   IsVisible="{Binding OfflineEnabled, Converter={StaticResource Invert}}" />

            <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding HubVisible}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="10,10">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="{svc:T hub_host_enable}" FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Text="{Binding HubStatus}" Style="{StaticResource MutedLabel}" FontSize="11"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding HubEnabled}" VerticalOptions="Center"
                            OnColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding HubQrVisible}">
                <VerticalStackLayout Padding="10,14" Spacing="10" HorizontalOptions="Center">
                    <Image Source="{Binding HubQrSource}" WidthRequest="200" HeightRequest="200"
                           Aspect="AspectFit" BackgroundColor="White" />
                    <Label Text="{svc:T hub_qr_hint}" Style="{StaticResource MutedLabel}" FontSize="12"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{svc:T offline_profile}" Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="6,4,0,-6"
                   IsVisible="{Binding OfflineEnabled}" />
            <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding OfflineEnabled}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="10,6">
                        <Label Text="{svc:T offline_profile_sales}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Switch Grid.Column="1" IsToggled="{Binding CapSales}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Margin="10,0"
                             Color="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="10,6">
                        <Label Text="{svc:T offline_profile_payments}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Switch Grid.Column="1" IsToggled="{Binding CapPayments}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Margin="10,0"
                             Color="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="10,6">
                        <Label Text="{svc:T offline_profile_supplies}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Switch Grid.Column="1" IsToggled="{Binding CapSupplies}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{svc:T offline_sales}" Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="6,4,0,-6"
                   IsVisible="{Binding HasQueueRows}" />
            <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding HasQueueRows}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding QueueRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OfflineQueueRow">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4" Padding="10,10">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="13.5" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="{Binding Error}" FontSize="11" LineBreakMode="WordWrap"
                                           IsVisible="{Binding IsError}"
                                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" FontFamily="MDI" Text="{StaticResource IcSync}" FontSize="18"
                                        WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        IsVisible="{Binding IsError}"
                                        Command="{Binding RetryQueueRowCommand, Source={RelativeSource AncestorType={x:Type vm:OfflineSettingsViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="2" FontFamily="MDI" Text="{StaticResource IcClose}" FontSize="18"
                                        WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                        IsVisible="{Binding IsError}"
                                        Command="{Binding DiscardQueueRowCommand, Source={RelativeSource AncestorType={x:Type vm:OfflineSettingsViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="3" FontFamily="MDI" Text="{StaticResource IcDelete}" FontSize="18"
                                        WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                        IsVisible="{Binding CanCancel}"
                                        Command="{Binding CancelQueueRowCommand, Source={RelativeSource AncestorType={x:Type vm:OfflineSettingsViewModel}}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding OfflineEnabled}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="10,12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ExportQueueCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{svc:T offline_export}" FontSize="15" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    <Label Grid.Column="1" Text="›" FontSize="22" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding ImportVisible}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="10,12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ImportQueueCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{svc:T offline_import}" FontSize="15" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    <Label Grid.Column="1" Text="›" FontSize="22" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
