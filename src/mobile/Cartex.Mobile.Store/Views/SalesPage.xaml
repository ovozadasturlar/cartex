<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.SalesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:SalesViewModel"
    Shell.NavBarIsVisible="False">
    <Grid>
        <VerticalStackLayout IsVisible="{Binding HasAccess, Converter={StaticResource Invert}}"
                             VerticalOptions="Center" Padding="40,0" Spacing="16">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                <Label Text="{StaticResource IcLock}" Style="{StaticResource Icon}" FontSize="30" />
            </Border>
            <Label Text="{svc:T no_access_msg}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <RefreshView IsVisible="{Binding HasAccess}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     RefreshColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
            <ScrollView>
                <VerticalStackLayout Padding="20,18,20,24" Spacing="14">
                    <Label Text="{svc:T sales}" Style="{StaticResource H1}" />

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                            IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}">
                        <Label Text="{Binding Error}" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding TodayCount}" Style="{StaticResource StatValue}" FontSize="24" />
                                <Label Text="{svc:T sales_today}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding TodayTotal}" Style="{StaticResource StatValue}" FontSize="24" />
                                <Label Text="{svc:T today_total}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty}">
                        <VerticalStackLayout Spacing="10" Padding="0,10" HorizontalOptions="Center">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                                <Label Text="{StaticResource IcHistory}" Style="{StaticResource Icon}" FontSize="26" />
                            </Border>
                            <Label Text="{svc:T sales_empty}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding IsEmpty, Converter={StaticResource Invert}}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sales}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SaleRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="10,11">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Total}" FontSize="14.5" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                            <Label Text="{Binding SubLine}" Style="{StaticResource MutedLabel}" FontSize="12.5" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,3" IsVisible="{Binding HasCash}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                                                <Label Text="{svc:T pay_cash}" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                                            </Border>
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,3" IsVisible="{Binding HasCard}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                                                <Label Text="{svc:T pay_card}" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
