<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.CaseReturnPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:ctl="clr-namespace:Cartex.Mobile.Core.Controls;assembly=Cartex.Mobile.Core"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:CaseReturnViewModel"
    Title="{svc:T receive_return}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12" IsVisible="{Binding IsLoaded}">
                <Border Style="{StaticResource Card}" Padding="14"><VerticalStackLayout Spacing="3"><Label Text="{Binding CaseTitle}" FontSize="16" FontAttributes="Bold" /><Label Text="{Binding CustomerName}" Style="{StaticResource MutedLabel}" FontSize="12" /></VerticalStackLayout></Border>
                <Label Text="{svc:T select_return_items}" FontSize="15" FontAttributes="Bold" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CaseReturnLine">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="{Binding Source.ProductName}" FontAttributes="Bold" /><Label Text="{Binding CustodyText}" Style="{StaticResource MutedLabel}" FontSize="11" /><Label Text="{Binding Source.IssueDocumentNumber}" Style="{StaticResource MutedLabel}" FontSize="11" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding IsSelected}" /></Grid>
                                    <VerticalStackLayout Spacing="9" IsVisible="{Binding IsSelected}">
                                        <Grid ColumnDefinitions="Auto,90,Auto" ColumnSpacing="8" HorizontalOptions="Center">
                                            <ctl:HoldRepeatButton Text="−" WidthRequest="42" HeightRequest="42" Padding="0" Style="{StaticResource BtnOutline}" RepeatCommand="{Binding DecrementCommand, Source={RelativeSource AncestorType={x:Type vm:CaseReturnViewModel}}}" RepeatCommandParameter="{Binding .}" />
                                            <Border Grid.Column="1" Style="{StaticResource InputWrap}" Padding="0"><Entry Text="{Binding QuantityText}" Keyboard="Numeric" ReturnType="Done" HeightRequest="42" HorizontalTextAlignment="Center" FontAttributes="Bold" ReturnCommand="{Binding CommitQuantityCommand, Source={RelativeSource AncestorType={x:Type vm:CaseReturnViewModel}}}" ReturnCommandParameter="{Binding .}" Unfocused="OnQuantityUnfocused" /></Border>
                                            <ctl:HoldRepeatButton Grid.Column="2" Text="+" WidthRequest="42" HeightRequest="42" Padding="0" Style="{StaticResource BtnOutline}" RepeatCommand="{Binding IncrementCommand, Source={RelativeSource AncestorType={x:Type vm:CaseReturnViewModel}}}" RepeatCommandParameter="{Binding .}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="3"><Label Text="{svc:T condition}" Style="{StaticResource MutedLabel}" FontSize="11" /><Picker ItemsSource="{Binding Conditions, Source={RelativeSource AncestorType={x:Type vm:CaseReturnViewModel}}}" SelectedItem="{Binding SelectedCondition}" ItemDisplayBinding="{Binding Label}" /></VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="{svc:T disposition}" Style="{StaticResource MutedLabel}" FontSize="11" /><Picker ItemsSource="{Binding Dispositions, Source={RelativeSource AncestorType={x:Type vm:CaseReturnViewModel}}}" SelectedItem="{Binding SelectedDisposition}" ItemDisplayBinding="{Binding Label}" /></VerticalStackLayout>
                                        </Grid>
                                        <Border Style="{StaticResource InputWrap}"><Entry Text="{Binding Reason}" Placeholder="{svc:T return_reason_optional}" /></Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border Style="{StaticResource InputWrap}"><Editor Text="{Binding Note}" Placeholder="{svc:T note_placeholder}" AutoSize="TextChanges" /></Border>
                <Border Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}" IsVisible="{Binding HasError}"><Label Text="{Binding Error}" Style="{StaticResource TxDanger}" /></Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="1" StrokeThickness="1" Padding="16,12" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}">
            <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="1"><Label Text="{svc:T total_quantity}" Style="{StaticResource MutedLabel}" FontSize="11" /><Label Text="{Binding QuantityText}" FontSize="19" FontAttributes="Bold" /></VerticalStackLayout><Button Grid.Column="1" Text="{svc:T receive_return}" Style="{StaticResource BtnPrimary}" WidthRequest="130" Command="{Binding SaveCommand}" IsEnabled="{Binding HasSelection}" /></Grid>
        </Border>
        <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
