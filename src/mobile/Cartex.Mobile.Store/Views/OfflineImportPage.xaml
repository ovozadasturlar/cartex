<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.OfflineImportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:OfflineImportViewModel"
    Title="{svc:T offline_import}">
    <Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,20" RowSpacing="12">
        <Border Style="{StaticResource Card}" Padding="12,4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8">
                <Label Text="{svc:T offline_import_skip_confirm}" FontSize="13" LineBreakMode="WordWrap"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                <Switch Grid.Column="1" IsToggled="{Binding SkipRejected}" VerticalOptions="Center" />
            </Grid>
        </Border>
        <ScrollView Grid.Row="1">
            <Border Style="{StaticResource Card}" Padding="6,2">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OfflineImportRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="10,8">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="13.5" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="{Binding Summary}" Style="{StaticResource MutedLabel}" FontSize="12"
                                           IsVisible="{Binding Summary, Converter={StaticResource NotEmpty}}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding Selected}" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
        <Grid Grid.Row="2">
            <Button Text="{svc:T send}" Style="{StaticResource BtnPrimary}" Command="{Binding UploadCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </Grid>
    </Grid>
</ContentPage>
