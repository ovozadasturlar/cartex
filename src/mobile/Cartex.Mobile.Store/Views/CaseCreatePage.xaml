<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Cartex.Mobile.Store.Views.CaseCreatePage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels" xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core" xmlns:services="clr-namespace:Cartex.Mobile.Store.Services" xmlns:partners="clr-namespace:Cartex.Shared.Models.Partners;assembly=Cartex.Shared" x:DataType="vm:CaseCreateViewModel">
    <Grid RowDefinitions="*,Auto">
        <ScrollView><VerticalStackLayout Padding="16" Spacing="12" IsVisible="{Binding IsLoaded}">
            <Border Style="{StaticResource Card}" Padding="14"><VerticalStackLayout Spacing="2"><Label Text="{svc:T customer}" Style="{StaticResource MutedLabel}" FontSize="11" /><Label Text="{Binding CustomerName}" FontSize="16" FontAttributes="Bold" /></VerticalStackLayout></Border>
            <VerticalStackLayout Spacing="4"><Label Text="{svc:T title}" Style="{StaticResource MutedLabel}" /><Border Style="{StaticResource InputWrap}"><Entry Text="{Binding Title}" /></Border></VerticalStackLayout>
            <VerticalStackLayout Spacing="4"><Label Text="{svc:T site_address}" Style="{StaticResource MutedLabel}" /><Border Style="{StaticResource InputWrap}"><Entry Text="{Binding SiteAddress}" /></Border><Label Text="{svc:T required}" Style="{StaticResource TxDanger}" FontSize="11" IsVisible="{Binding RequireSiteAddress}" /></VerticalStackLayout>
            <VerticalStackLayout Spacing="4" IsVisible="{Binding AllowWorkflowOverride}"><Label Text="{svc:T workflow}" Style="{StaticResource MutedLabel}" /><Picker ItemsSource="{Binding Workflows}" SelectedItem="{Binding SelectedWorkflow}" ItemDisplayBinding="{Binding Label}" /></VerticalStackLayout>
            <VerticalStackLayout Spacing="4" IsVisible="{Binding AllowPricePolicyOverride}"><Label Text="{svc:T price_policy}" Style="{StaticResource MutedLabel}" /><Picker ItemsSource="{Binding PricePolicies}" SelectedItem="{Binding SelectedPricePolicy}" ItemDisplayBinding="{Binding Label}" /></VerticalStackLayout>
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasParticipantRoles}">
                <Label Text="{svc:T participants}" FontSize="15" FontAttributes="Bold" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ParticipantRoles}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:ParticipantRoleSelectionRow">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding Label}" FontAttributes="Bold" FontSize="14" />
                                        <Label Grid.Column="1" Text="{svc:T required}" Style="{StaticResource TxDanger}" FontSize="10" IsVisible="{Binding IsRequired}" />
                                        <Label Grid.Column="2" Text="{Binding LimitText}" Style="{StaticResource MutedLabel}" FontSize="11" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Selections}" Spacing="4" IsVisible="{Binding HasSelections}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="services:CartParticipantDraft">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Text="{Binding PartyName}" FontSize="13" VerticalOptions="Center" />
                                                    <Button Grid.Column="1" Text="{StaticResource IcClose}" FontFamily="MDI" FontSize="14" WidthRequest="34" HeightRequest="34" Padding="0" BackgroundColor="Transparent" Command="{Binding RemoveParticipantCommand, Source={RelativeSource AncestorType={x:Type vm:CaseCreateViewModel}}}" CommandParameter="{Binding .}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <Button Text="{svc:T select_participant}" Style="{StaticResource BtnOutline}" HeightRequest="42" FontSize="13" IsVisible="{Binding CanAdd}" Command="{Binding OpenParticipantModalCommand, Source={RelativeSource AncestorType={x:Type vm:CaseCreateViewModel}}}" CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Border Style="{StaticResource InputWrap}"><Editor Text="{Binding Note}" Placeholder="{svc:T note_placeholder}" AutoSize="TextChanges" /></Border>
            <Border Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}" IsVisible="{Binding HasError}"><Label Text="{Binding Error}" Style="{StaticResource TxDanger}" /></Border>
        </VerticalStackLayout></ScrollView>
        <Border Grid.Row="1" StrokeThickness="1" Padding="16,12" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}"><Button Text="{svc:T create}" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}" /></Border>
        <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Center" />
        <Grid Grid.RowSpan="2" BackgroundColor="#CC000000" IsVisible="{Binding IsParticipantModalOpen}">
            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseParticipantModalCommand}" /></Grid.GestureRecognizers>
            <Border Style="{StaticResource Card}" Padding="20" Margin="20,44" VerticalOptions="Fill">
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="{Binding SelectedParticipantRole.Label}" FontSize="20" FontAttributes="Bold" /><Label Text="{svc:T select_participant_hint}" Style="{StaticResource MutedLabel}" FontSize="12" /></VerticalStackLayout><Button Grid.Column="1" Text="{StaticResource IcClose}" FontFamily="MDI" FontSize="18" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent" Command="{Binding CloseParticipantModalCommand}" /></Grid>
                    <Border Grid.Row="1" Style="{StaticResource InputWrap}"><Entry Text="{Binding ParticipantSearch}" Placeholder="{svc:T search_partner}" ClearButtonVisibility="WhileEditing" /></Border>
                    <Button Grid.Row="2" Text="{svc:T buyer_is_participant}" Style="{StaticResource BtnOutline}" IsVisible="{Binding CanUseBuyerForSelectedRole}" Command="{Binding UseBuyerAsParticipantCommand}" />
                    <CollectionView Grid.Row="3" ItemsSource="{Binding PartnerResults}" SelectionMode="None">
                        <CollectionView.EmptyView><Label Text="{svc:T partner_search_hint}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" Margin="0,28" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate><DataTemplate x:DataType="partners:PartnerDto"><Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PickPartnerCommand, Source={RelativeSource AncestorType={x:Type vm:CaseCreateViewModel}}}" CommandParameter="{Binding .}" /></Border.GestureRecognizers><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="14" /><Label Text="{Binding Phone}" Style="{StaticResource MutedLabel}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding PartnerCode}" Style="{StaticResource MutedLabel}" FontSize="11" VerticalOptions="Center" /></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
