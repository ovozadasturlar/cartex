<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Store.Views.CheckoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:CheckoutViewModel"
    Title="{svc:T checkout}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12" IsVisible="{Binding IsLoaded}">
                
                <!-- Items Summary -->
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CheckoutLine">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding Name}" FontSize="14" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                        <Label Text="{Binding QtyPriceText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding LineTotalText}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Customer Info -->
                <Border Style="{StaticResource Card}" Padding="14,10" IsVisible="{Binding HasCustomer}">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{StaticResource IcAccount}" Style="{StaticResource Icon}" VerticalOptions="Center" />
                        <Label Text="{Binding CustomerName}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Notes Input -->
                <Border Style="{StaticResource InputWrap}">
                    <Entry Placeholder="{svc:T note_placeholder}" Text="{Binding NoteText}" />
                </Border>

                <!-- Total -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{svc:T total}" FontSize="15" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding TotalText}" FontSize="22" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </Grid>
                </Border>

                <!-- Payment Block -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding CanSelfSell}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Style="{StaticResource InputWrap}">
                                <Entry Placeholder="{svc:T pay_cash}" Text="{Binding CashText}" Keyboard="Numeric" />
                            </Border>
                            <Button Grid.Column="1" Text="{svc:T exact_amount}" Style="{StaticResource BtnOutline}"
                                    HeightRequest="44" MinimumHeightRequest="44" FontSize="13" Padding="14,0"
                                    Command="{Binding ExactCommand}" />
                        </Grid>
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Placeholder="{svc:T pay_card}" Text="{Binding CardText}" Keyboard="Numeric" />
                        </Border>
                        <Border Style="{StaticResource InputWrap}" IsVisible="{Binding HasCustomer}">
                            <Entry Placeholder="{svc:T pay_bonus}" Text="{Binding BonusText}" Keyboard="Numeric" />
                        </Border>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{svc:T paid_label}" Style="{StaticResource MutedLabel}" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding PaidText}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ChangeText, Converter={StaticResource NotEmpty}}">
                            <Label Text="{svc:T change_label}" Style="{StaticResource MutedLabel}" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding ChangeText}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding DebtText, Converter={StaticResource NotEmpty}}">
                            <Label Text="{svc:T debt_label}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            <Label Grid.Column="1" Text="{Binding DebtText}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Action Buttons Footer -->
        <Border Grid.Row="1" StrokeThickness="1" Padding="16,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}">
            <VerticalStackLayout Spacing="10">
                <Button Text="{svc:T send_to_queue}" Style="{StaticResource BtnOutline}"
                        Command="{Binding QueueCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
                
                <Button Text="{svc:T checkout_complete}" Style="{StaticResource BtnPrimary}"
                        Command="{Binding CompleteCommand}"
                        IsVisible="{Binding CanSelfSell}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
