<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
             xmlns:vm="clr-namespace:Cartex.Mobile.Store.ViewModels"
             x:Class="Cartex.Mobile.Store.Views.CustomerFormView"
             x:DataType="vm:MobileCustomerPicker"
             IsVisible="{Binding IsFormOpen}"
             svc:AutoFocus.OnVisible="True">
    <Grid BackgroundColor="#CC000000">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseFormCommand}" />
        </Grid.GestureRecognizers>
        <Border Style="{StaticResource Card}" Padding="20" Margin="20" VerticalOptions="Center" MaximumHeightRequest="620">
            <Border.GestureRecognizers>
                <TapGestureRecognizer />
            </Border.GestureRecognizers>
            <ScrollView>
                <VerticalStackLayout Spacing="12">
                    <Label Text="{svc:T add_new}" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{svc:T customer}" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Text="{Binding NewName}" Placeholder="Ism" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Telefon" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Text="{Binding NewPhone}" Keyboard="Telephone" Placeholder="+998" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{svc:T last_name}" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Text="{Binding NewLastName}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{svc:T address}" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Text="{Binding NewAddress}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Text="{Binding NewEmail}" Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{svc:T card_barcode}" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Text="{Binding NewCard}" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{svc:T discount_pct}" Style="{StaticResource MutedLabel}" FontSize="13" />
                            <Border Style="{StaticResource InputWrap}">
                                <Entry Text="{Binding NewDiscount}" Keyboard="Numeric" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{svc:T credit_limit}" Style="{StaticResource MutedLabel}" FontSize="13" />
                            <Border Style="{StaticResource InputWrap}">
                                <Entry Text="{Binding NewCreditLimit}" Keyboard="Numeric" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding CanEnterOpeningBalance}">
                        <Label Text="{svc:T opening_balance}" Style="{StaticResource MutedLabel}" FontSize="13" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Style="{StaticResource InputWrap}">
                                <Entry Text="{Binding NewOpeningBalance}" Keyboard="Numeric" />
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource InputWrap}" MinimumWidthRequest="130">
                                <Picker ItemsSource="{Binding OpeningKinds}" SelectedIndex="{Binding NewOpeningKindIndex}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Text="{svc:T cancel}" Style="{StaticResource BtnOutline}" Command="{Binding CloseFormCommand}" />
                        <Button Grid.Column="1" Text="{svc:T save}" Style="{StaticResource BtnPrimary}"
                                Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentView>
