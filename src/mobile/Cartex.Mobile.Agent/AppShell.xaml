<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Cartex.Mobile.Agent.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Cartex.Mobile.Agent.Views"
    xmlns:svc="clr-namespace:Cartex.Mobile.Agent.Services"
    FlyoutBehavior="Disabled">

    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" Shell.NavBarIsVisible="False" />

    <TabBar Route="main">
        <ShellContent Route="home" Title="{svc:T tab_home}" Icon="tab_home.png" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Route="orders" Title="{svc:T orders}" Icon="tab_order.png" ContentTemplate="{DataTemplate views:OrdersPage}" />
        <ShellContent Route="customers" Title="{svc:T customers}" Icon="tab_customers.png" ContentTemplate="{DataTemplate views:CustomersPage}" />
        <ShellContent Route="transfers" Title="{svc:T tab_transfers}" Icon="tab_truck.png" ContentTemplate="{DataTemplate views:TransfersPage}" />
        <ShellContent Route="profile" Title="{svc:T profile}" Icon="tab_profile.png" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>
