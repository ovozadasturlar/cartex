<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Cartex.Mobile.Agent.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Cartex.Mobile.Agent.Views"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    FlyoutBehavior="Disabled">

    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" Shell.NavBarIsVisible="False" />

    <TabBar Route="main">
        <ShellContent x:Name="CatalogTab" Route="catalog" Title="{svc:T tab_catalog}" Icon="tab_catalog.png" ContentTemplate="{DataTemplate views:CatalogPage}" />
        <ShellContent x:Name="CartTab" Route="cart" Title="{svc:T tab_cart}" Icon="tab_cart.png" ContentTemplate="{DataTemplate views:CartPage}" />
        <ShellContent x:Name="CustomersTab" Route="customers" Title="{svc:T customers}" Icon="tab_customers.png" ContentTemplate="{DataTemplate views:CustomersPage}" />
        <ShellContent x:Name="OrdersTab" Route="orders" Title="{svc:T orders}" Icon="tab_order.png" ContentTemplate="{DataTemplate views:OrdersPage}" />
        <ShellContent Route="profile" Title="{svc:T profile}" Icon="tab_profile.png" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>
