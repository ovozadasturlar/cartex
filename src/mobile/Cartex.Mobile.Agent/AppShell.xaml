<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Cartex.Mobile.Agent.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Cartex.Mobile.Agent.Views"
    FlyoutBehavior="Disabled">

    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" Shell.NavBarIsVisible="False" />

    <TabBar Route="main">
        <ShellContent Route="home" Title="Asosiy" Icon="tab_home.png" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Route="customers" Title="Mijozlar" Icon="tab_customers.png" ContentTemplate="{DataTemplate views:CustomersPage}" />
        <ShellContent Route="transfers" Title="Yuk xati" Icon="tab_truck.png" ContentTemplate="{DataTemplate views:TransfersPage}" />
        <ShellContent Route="outbox" Title="Navbat" Icon="tab_queue.png" ContentTemplate="{DataTemplate views:OutboxPage}" />
    </TabBar>

</Shell>
