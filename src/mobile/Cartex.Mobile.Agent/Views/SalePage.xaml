<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.SalePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:data="clr-namespace:Cartex.Mobile.Agent.Data"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:SaleViewModel"
    Title="{svc:T new_sale}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="{Binding CustomerName}" FontSize="18" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Placeholder="{svc:T search_product}" Text="{Binding Search}" ClearButtonVisibility="WhileEditing" />
            </Border>
            <Border Style="{StaticResource Card}" Padding="6" IsVisible="{Binding HasResults}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="data:LocalVanStock">
                            <Grid Padding="10,8" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddItemCommand, Source={RelativeSource AncestorType={x:Type vm:SaleViewModel}}}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding ProductName}" FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{svc:T stock_label}" />
                                                <Span Text="{Binding Quantity, StringFormat='{0:0.###} '}" />
                                                <Span Text="{Binding UnitName}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding SellingPrice, StringFormat='{0:N0}'}" FontAttributes="Bold"
                                       VerticalOptions="Center" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Lines}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaleLine">
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsOverStock}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="{Binding PriceText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <Label Text="{svc:T over_stock}" FontSize="11" IsVisible="{Binding IsOverStock}"
                                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Button Text="−" FontSize="18" WidthRequest="40" HeightRequest="40" CornerRadius="10" Padding="0"
                                            Style="{StaticResource BtnOutline}" BorderWidth="1" Command="{Binding DecrementCommand}" />
                                    <Entry Text="{Binding Quantity}" Keyboard="Numeric" WidthRequest="56" HorizontalTextAlignment="Center" FontSize="15" />
                                    <Button Text="+" FontSize="18" WidthRequest="40" HeightRequest="40" CornerRadius="10" Padding="0"
                                            Style="{StaticResource BtnOutline}" BorderWidth="1" Command="{Binding IncrementCommand}" />
                                    <Button Text="✕" FontSize="14" WidthRequest="36" HeightRequest="40" CornerRadius="10" Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                            Command="{Binding RemoveLineCommand, Source={RelativeSource AncestorType={x:Type vm:SaleViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasLines}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{svc:T total}" FontSize="15" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding TotalText}" FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </Grid>
                    <Border Style="{StaticResource InputWrap}">
                        <Entry Placeholder="{svc:T paid_cash}" Text="{Binding PaidCashText}" Keyboard="Numeric" />
                    </Border>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{svc:T full_cash}" Style="{StaticResource BtnOutline}" HeightRequest="40" FontSize="13" Command="{Binding FullCashCommand}" />
                        <Button Text="{svc:T on_credit}" Style="{StaticResource BtnOutline}" HeightRequest="40" FontSize="13" Command="{Binding FullDebtCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding DebtInfo}" FontSize="14" FontAttributes="Bold"
                           IsVisible="{Binding DebtInfo, Converter={StaticResource NotEmpty}}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarnBg}, Dark={StaticResource WarnBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding CreditWarning, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding CreditWarning}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
            </Border>
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding Error}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </Border>
            <Button Text="{svc:T save}" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}" IsVisible="{Binding HasLines}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
