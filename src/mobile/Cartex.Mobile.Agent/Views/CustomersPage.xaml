<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:CustomersViewModel"
    Title="{svc:T customers_title}">
    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Border Style="{StaticResource InputWrap}">
                <Entry Placeholder="{svc:T search_customer}" Text="{Binding Search}" ClearButtonVisibility="WhileEditing" />
            </Border>
            <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="48"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenMapCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{StaticResource IcMapSearch}" Style="{StaticResource Icon}" FontSize="22" />
            </Border>
            <Border Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="48"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommand}" />
                </Border.GestureRecognizers>
                <Label Text="+" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
            </Border>
        </Grid>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Customers}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomerRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 21" WidthRequest="42" HeightRequest="42"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                                    <Label Text="{Binding Initials}" FontSize="14" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Customer.FullName}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="{Binding Customer.Phone}" Style="{StaticResource MutedLabel}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding DebtText}" VerticalOptions="Center" FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasDebt}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="{svc:T no_customers}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
