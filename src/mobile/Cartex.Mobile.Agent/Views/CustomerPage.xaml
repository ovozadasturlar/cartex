<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.CustomerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Agent.Services"
    x:DataType="vm:CustomerViewModel"
    Title="{svc:T customer_title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="{Binding FullName}" Style="{StaticResource H1}" />
            <Label Text="{Binding StaleText}" Style="{StaticResource MutedLabel}" Margin="0,-10,0,0" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{svc:T debt}" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding DebtText}" FontSize="24" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasDebt}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding LimitText}" Style="{StaticResource MutedLabel}"
                           IsVisible="{Binding LimitText, Converter={StaticResource NotEmpty}}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Phone}" FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding Address}" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>
            <Button Style="{StaticResource BtnOutline}" Command="{Binding OpenMapCommand}" IsVisible="{Binding HasLocation}"
                    Text="{svc:T open_in_map}" />
            <Button Text="{svc:T sale_action}" Style="{StaticResource BtnPrimary}" Command="{Binding SaleCommand}" />
            <Button Text="{svc:T repay_title}" Style="{StaticResource BtnOutline}" Command="{Binding RepayCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
