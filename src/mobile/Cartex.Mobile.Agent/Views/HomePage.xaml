<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:HomeViewModel"
    Shell.NavBarIsVisible="False">
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                 RefreshColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,24" Spacing="14">
            <VerticalStackLayout Spacing="3">
                <Label Text="{Binding Greeting}" FontSize="23" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                <Label Style="{StaticResource MutedLabel}" FontSize="12.5" LineBreakMode="TailTruncation">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding WarehouseName}" />
                            <Span Text="  •  " />
                            <Span Text="{Binding LastSync}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarnBg}, Dark={StaticResource WarnBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding IsOffline}">
                <Label Text="{svc:T offline_banner}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
            </Border>
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding Error}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </Border>
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding ErrorCount, Converter={StaticResource Positive}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenOutboxCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{svc:T outbox_title}" />
                                <Span Text=": " />
                                <Span Text="{Binding ErrorCount}" />
                                <Span Text=" " />
                                <Span Text="{svc:T status_error}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="›" FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid ColumnDefinitions="*,Auto" RowSpacing="8">
                        <VerticalStackLayout Spacing="2" VerticalOptions="End">
                            <Label Text="{Binding CustomerCount}" Style="{StaticResource StatValue}" FontSize="24" />
                            <Label Text="{svc:T customers}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Label Text="{StaticResource IcPeople}" Style="{StaticResource Icon}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                    <Grid ColumnDefinitions="*,Auto" RowSpacing="8">
                        <VerticalStackLayout Spacing="2" VerticalOptions="End">
                            <Label Text="{Binding PendingDeliveries}" Style="{StaticResource StatValue}" FontSize="24" />
                            <Label Text="{svc:T deliver_pending}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Label Text="{StaticResource IcTruck}" Style="{StaticResource Icon}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                    <Grid ColumnDefinitions="*,Auto" RowSpacing="8">
                        <VerticalStackLayout Spacing="2" VerticalOptions="End">
                            <Label Text="{Binding YesterdayOrders}" Style="{StaticResource StatValue}" FontSize="24"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Label Text="{svc:T yesterday_orders}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Label Text="{StaticResource IcOutbox}" Style="{StaticResource Icon}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                    <Grid ColumnDefinitions="*,Auto" RowSpacing="8">
                        <VerticalStackLayout Spacing="2" VerticalOptions="End">
                            <Label Text="{Binding YesterdayDelivered}" Style="{StaticResource StatValue}" FontSize="24"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Label Text="{svc:T yesterday_delivered}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Label Text="{StaticResource IcCheck}" Style="{StaticResource Icon}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenStockCommand}" />
                    </Grid.GestureRecognizers>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                        <Label Text="{StaticResource IcBox}" Style="{StaticResource Icon}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding VanValue}" Style="{StaticResource StatValue}" FontSize="21" />
                        <Label Text="{svc:T van_value}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Button Text="{svc:T new_order}" Style="{StaticResource BtnPrimary}" Command="{Binding NewOrderCommand}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Text="{svc:T new_sale}" Style="{StaticResource BtnOutline}" FontSize="13.5" Command="{Binding NewSaleCommand}" />
                <Button Grid.Column="1" Text="{svc:T orders}" Style="{StaticResource BtnOutline}" FontSize="13.5" Command="{Binding OpenOrdersCommand}" />
                <Button Grid.Column="2" Text="{svc:T products}" Style="{StaticResource BtnOutline}" FontSize="13.5" Command="{Binding OpenStockCommand}" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{svc:T last7days}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                    <Label Text="{Binding Week7Total}" FontSize="24" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding WeekBars}" JustifyContent="SpaceBetween" Margin="0,10,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayBar">
                                <VerticalStackLayout Spacing="6" WidthRequest="28">
                                    <Grid HeightRequest="72">
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" WidthRequest="14"
                                                VerticalOptions="End" HorizontalOptions="Center"
                                                HeightRequest="{Binding Height}" IsVisible="{Binding IsMax}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" WidthRequest="14"
                                                VerticalOptions="End" HorizontalOptions="Center"
                                                HeightRequest="{Binding Height}" IsVisible="{Binding IsMax, Converter={StaticResource Invert}}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}" />
                                    </Grid>
                                    <Label Text="{Binding Day}" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDaySummaryCommand}" />
                    </Grid.GestureRecognizers>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                        <Label Text="{StaticResource IcCash}" Style="{StaticResource Icon}" />
                    </Border>
                    <Label Grid.Column="1" Text="{svc:T day_summary}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    <Label Grid.Column="2" Text="{StaticResource IcChevron}" Style="{StaticResource Icon}" FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,-4">
                <Label Text="{svc:T visit_today}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="34" HeightRequest="34"
                        IsVisible="{Binding VisitsEmpty, Converter={StaticResource Invert}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenRouteCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{StaticResource IcRoute}" Style="{StaticResource Icon}" FontSize="18" />
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}" IsVisible="{Binding VisitsEmpty}">
                <VerticalStackLayout Spacing="10" Padding="0,10" HorizontalOptions="Center">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                        <Label Text="{StaticResource IcPin}" Style="{StaticResource Icon}" FontSize="26" />
                    </Border>
                    <Label Text="{svc:T no_visits}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="6,2" IsVisible="{Binding VisitsEmpty, Converter={StaticResource Invert}}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Visits}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:VisitRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,11">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenOrdersCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}}" />
                                </Grid.GestureRecognizers>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                                    <Label Text="{Binding Initials}" FontSize="14" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="14.5" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="{Binding SubLine}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="22" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
