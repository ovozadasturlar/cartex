<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:ChangePasswordViewModel"
    Title="{svc:T change_password}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18" Spacing="12">
            <Border Style="{StaticResource InputWrap}">
                <Entry Placeholder="{svc:T current_password}" Text="{Binding Current}" IsPassword="True" ReturnType="Next" />
            </Border>
            <Border Style="{StaticResource InputWrap}">
                <Entry Placeholder="{svc:T new_password}" Text="{Binding Next}" IsPassword="True" ReturnType="Next" />
            </Border>
            <Border Style="{StaticResource InputWrap}">
                <Entry Placeholder="{svc:T repeat_password}" Text="{Binding Repeat}" IsPassword="True"
                       ReturnType="Go" ReturnCommand="{Binding SaveCommand}" />
            </Border>
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding Error}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </Border>
            <Button Text="{svc:T save}" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}" Margin="0,6,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
