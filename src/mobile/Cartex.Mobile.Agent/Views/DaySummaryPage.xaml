<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.DaySummaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:DaySummaryViewModel"
    Title="{svc:T day_summary}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,24" Spacing="14">
            <Border Style="{StaticResource Card}" Padding="18,16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="48" HeightRequest="48" VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                        <Label Text="{StaticResource IcCash}" Style="{StaticResource Icon}" FontSize="24" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{svc:T cash_collected}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                        <Label Text="{Binding CashText}" Style="{StaticResource StatValue}" FontSize="26" />
                        <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" FontSize="11.5" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarnBg}, Dark={StaticResource WarnBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding PendingWarning, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding PendingWarning}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding SalesCount}" Style="{StaticResource StatValue}" FontSize="24" />
                        <Label Text="{svc:T sales_today}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                        <Label Text="{Binding SalesTotalText}" FontSize="12.5" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding DeliveredCount}" Style="{StaticResource StatValue}" FontSize="24"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Text="{svc:T delivered_today}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding DebtGivenText}" FontSize="17" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                        <Label Text="{svc:T debt_given}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding DebtCollectedText}" FontSize="17" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="{svc:T debt_collected}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                        <Label Text="{StaticResource IcBox}" Style="{StaticResource Icon}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding VanValueText}" FontSize="17" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Text="{svc:T van_value}" Style="{StaticResource MutedLabel}" FontSize="12.5" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
