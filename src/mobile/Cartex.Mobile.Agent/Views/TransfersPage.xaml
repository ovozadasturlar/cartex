<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.TransfersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:TransfersViewModel"
    Title="{svc:T transfers_title}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8,16,0" RowSpacing="10">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarnBg}, Dark={StaticResource WarnBgDark}}"
                StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}">
            <Label Text="{Binding Error}" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
        </Border>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}"
                           Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Transfers}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TransferRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Line}" FontAttributes="Bold" FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="{Binding SubLine}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <Label Text="{Binding StatusText}" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="{svc:T transfer_receive}" Style="{StaticResource BtnOutline}"
                                        HeightRequest="38" FontSize="12" VerticalOptions="Center"
                                        IsVisible="{Binding CanReceive}"
                                        Command="{Binding ReceiveCommand, Source={RelativeSource AncestorType={x:Type vm:TransfersViewModel}}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="{svc:T no_transfers}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
