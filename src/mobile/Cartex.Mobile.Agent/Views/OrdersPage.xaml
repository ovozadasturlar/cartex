<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Agent.Services"
    x:DataType="vm:OrdersViewModel"
    Title="{svc:T orders}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10" Padding="16,12,16,0">

        <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4"
                BackgroundColor="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource SurfaceDark}}">
            <Grid ColumnDefinitions="*,*">
                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="0,9"
                        BackgroundColor="Transparent">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ShowLoad}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Tertiary}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowOrdersCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{svc:T orders}" FontSize="13.5" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ShowLoad}" Value="False">
                                <Setter Property="FontAttributes" Value="Bold" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="0,9"
                        BackgroundColor="Transparent">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ShowLoad}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Tertiary}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowLoadListCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{svc:T load_list}" FontSize="13.5" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ShowLoad}" Value="True">
                                <Setter Property="FontAttributes" Value="Bold" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Grid.Triggers>
                <DataTrigger TargetType="Grid" Binding="{Binding ShowLoad}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Grid.Triggers>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding TotalCount}" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    <Label Text="{svc:T stat_total}" Style="{StaticResource MutedLabel}" FontSize="11.5" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding DeliveredCount}" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="{svc:T order_delivered}" Style="{StaticResource MutedLabel}" FontSize="11.5" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding PendingCount}" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                    <Label Text="{svc:T stat_pending}" Style="{StaticResource MutedLabel}" FontSize="11.5" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <RefreshView.Triggers>
                <DataTrigger TargetType="RefreshView" Binding="{Binding ShowLoad}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </RefreshView.Triggers>
            <CollectionView ItemsSource="{Binding Orders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40"
                                        VerticalOptions="Center"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource InfoBg}, Dark={StaticResource InfoBgDark}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Order.Status}" Value="synced">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnBg}, Dark={StaticResource WarnBgDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Order.Status}" Value="delivered">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Path Data="{StaticResource IcBox}" Aspect="Uniform" WidthRequest="18" HeightRequest="18"
                                              HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding CanDeliver}"
                                              Fill="{AppThemeBinding Light={StaticResource InfoBrush}, Dark={StaticResource InfoDarkBrush}}">
                                            <Path.Triggers>
                                                <DataTrigger TargetType="Path" Binding="{Binding Order.Status}" Value="synced">
                                                    <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource WarnBrush}, Dark={StaticResource WarnDarkBrush}}" />
                                                </DataTrigger>
                                            </Path.Triggers>
                                        </Path>
                                        <Path Data="{StaticResource IcCheck}" Aspect="Uniform" WidthRequest="18" HeightRequest="18"
                                              HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsDelivered}"
                                              Fill="{AppThemeBinding Light={StaticResource PrimaryBrush}, Dark={StaticResource SecondaryDarkTextBrush}}" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="{Binding SubLine}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,3" HorizontalOptions="End"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource InfoBg}, Dark={StaticResource InfoBgDark}}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Order.Status}" Value="synced">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnBg}, Dark={StaticResource WarnBgDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Order.Status}" Value="delivered">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Info}, Dark={StaticResource InfoDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Order.Status}" Value="synced">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Order.Status}" Value="delivered">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                    <Button Text="{svc:T deliver_btn}" Style="{StaticResource BtnPrimary}"
                                            HeightRequest="34" MinimumHeightRequest="34" FontSize="12" CornerRadius="10" Padding="14,0"
                                            IsVisible="{Binding CanDeliver}"
                                            Command="{Binding DeliverCommand, Source={RelativeSource AncestorType={x:Type vm:OrdersViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="12" Margin="0,60,0,0" HorizontalOptions="Center">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 32" WidthRequest="64" HeightRequest="64"
                                HorizontalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Path Data="{StaticResource IcBox}" Aspect="Uniform" WidthRequest="26" HeightRequest="26"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource PrimaryBrush}, Dark={StaticResource SecondaryDarkTextBrush}}" />
                        </Border>
                        <Label Text="{svc:T no_orders}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <RefreshView Grid.Row="2" IsVisible="False" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <RefreshView.Triggers>
                <DataTrigger TargetType="RefreshView" Binding="{Binding ShowLoad}" Value="True">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </RefreshView.Triggers>
            <CollectionView ItemsSource="{Binding Load}">
                <CollectionView.Header>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="2,0,2,10">
                        <Label Text="{svc:T load_hint}" Style="{StaticResource MutedLabel}" FontSize="12" VerticalOptions="Center" />
                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,3"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Label Text="{Binding LoadKindsText}" FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                        </Border>
                    </Grid>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoadRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="32" HeightRequest="32"
                                        VerticalOptions="Center"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                                    <Path Data="{StaticResource IcBox}" Aspect="Uniform" WidthRequest="15" HeightRequest="15"
                                          HorizontalOptions="Center" VerticalOptions="Center"
                                          Fill="{AppThemeBinding Light={StaticResource PrimaryBrush}, Dark={StaticResource SecondaryDarkTextBrush}}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalOptions="Center" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                <Label Grid.Column="2" Text="{Binding QtyText}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="12" Margin="0,60,0,0" HorizontalOptions="Center">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 32" WidthRequest="64" HeightRequest="64"
                                HorizontalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Path Data="{StaticResource IcTruck}" Aspect="Uniform" WidthRequest="26" HeightRequest="26"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource PrimaryBrush}, Dark={StaticResource SecondaryDarkTextBrush}}" />
                        </Border>
                        <Label Text="{svc:T load_empty}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="3" Text="{svc:T new_order}" Style="{StaticResource BtnPrimary}" Margin="0,2,0,14"
                Command="{Binding NewOrderCommand}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding ShowLoad}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
</ContentPage>
