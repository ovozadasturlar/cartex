<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Agent.Services"
    x:DataType="vm:OrdersViewModel"
    Title="{svc:T orders}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{svc:T new_order}" Command="{Binding NewOrderCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8" Padding="16,10,16,6">
            <Button Grid.Column="0" Text="{svc:T orders}" HeightRequest="40" FontSize="13" Style="{StaticResource BtnOutline}"
                    Command="{Binding ShowOrdersCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowLoad}" Value="False">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="{svc:T load_list}" HeightRequest="40" FontSize="13" Style="{StaticResource BtnOutline}"
                    Command="{Binding ShowLoadListCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowLoad}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" Margin="16,4,16,0">
            <CollectionView ItemsSource="{Binding Orders}">
                <CollectionView.Triggers>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding ShowLoad}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </CollectionView.Triggers>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="{Binding SubLine}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <Label Text="{Binding StatusText}" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDelivered}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="{svc:T deliver_btn}" Style="{StaticResource BtnOutline}" HeightRequest="36" FontSize="12"
                                        VerticalOptions="Center" IsVisible="{Binding CanDeliver}"
                                        Command="{Binding DeliverCommand, Source={RelativeSource AncestorType={x:Type vm:OrdersViewModel}}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="{svc:T no_orders}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <RefreshView Grid.Row="1" IsVisible="False" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" Margin="16,4,16,0">
            <RefreshView.Triggers>
                <DataTrigger TargetType="RefreshView" Binding="{Binding ShowLoad}" Value="True">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </RefreshView.Triggers>
            <CollectionView ItemsSource="{Binding Load}">
                <CollectionView.Header>
                    <Label Text="{svc:T load_hint}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="2,0,2,8" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoadRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding Name}" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                <Label Grid.Column="1" Text="{Binding QtyText}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="{svc:T load_empty}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
