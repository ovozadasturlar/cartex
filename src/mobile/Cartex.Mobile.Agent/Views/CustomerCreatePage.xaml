<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.CustomerCreatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    x:DataType="vm:CustomerCreateViewModel"
    Title="{svc:T add_customer}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,24" Spacing="12">
            <Label Text="{svc:T basic_info}" Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="6,0,0,-6" />
            <Border Style="{StaticResource InputWrap}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="{StaticResource IcAccount}" Style="{StaticResource Icon}" FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    <Entry Grid.Column="1" Placeholder="{svc:T customer_name}" Text="{Binding Name}" ReturnType="Next" />
                </Grid>
            </Border>
            <Border Style="{StaticResource InputWrap}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="{StaticResource IcPhone}" Style="{StaticResource Icon}" FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    <Entry Grid.Column="1" Placeholder="{svc:T phone}" Text="{Binding Phone}" Keyboard="Telephone" ReturnType="Next" />
                </Grid>
            </Border>
            <Border Style="{StaticResource InputWrap}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="{StaticResource IcMapMarkerOutline}" Style="{StaticResource Icon}" FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    <Entry Grid.Column="1" Placeholder="{svc:T customer_address}" Text="{Binding Address}" ReturnType="Next" />
                </Grid>
            </Border>
            <Border Style="{StaticResource InputWrap}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="{StaticResource IcCash}" Style="{StaticResource Icon}" FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    <Entry Grid.Column="1" Placeholder="{svc:T credit_limit}" Text="{Binding CreditLimit}" Keyboard="Numeric" />
                </Grid>
            </Border>

            <Label Text="{svc:T customer_location}" Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="6,4,0,-6" />
            <Border Style="{StaticResource Card}" Padding="14,12">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Label Text="{StaticResource IcPin}" Style="{StaticResource Icon}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{svc:T location_hint}" Style="{StaticResource MutedLabel}" FontSize="12"
                                   IsVisible="{Binding HasLocation, Converter={StaticResource Invert}}" />
                            <Label Text="{Binding LocationText}" FontSize="13.5" FontAttributes="Bold"
                                   IsVisible="{Binding HasLocation}"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{StaticResource IcClose}" Style="{StaticResource Icon}" FontSize="18" Padding="8"
                               VerticalOptions="Center" IsVisible="{Binding HasLocation}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearLocationCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasLocation, Converter={StaticResource Invert}}">
                        <Border StrokeThickness="1.3" StrokeShape="RoundRectangle 12" Padding="0,11" BackgroundColor="Transparent"
                                Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CaptureLocationCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                                <Label Text="{StaticResource IcGps}" Style="{StaticResource Icon}" FontSize="17"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Text="{svc:T gps}" FontSize="13.5" FontAttributes="Bold" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" StrokeThickness="1.3" StrokeShape="RoundRectangle 12" Padding="0,11" BackgroundColor="Transparent"
                                Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickOnMapCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                                <Label Text="{StaticResource IcMapSearch}" Style="{StaticResource Icon}" FontSize="17"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Text="{svc:T map_pick}" FontSize="13.5" FontAttributes="Bold" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14,8" HorizontalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}"
                            IsVisible="{Binding HasLocation}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickOnMapCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{StaticResource IcMapSearch}" Style="{StaticResource Icon}" FontSize="15" />
                            <Label Text="{svc:T map_adjust}" FontSize="12.5" FontAttributes="Bold" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
            <ActivityIndicator IsRunning="{Binding Locating}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding Error}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </Border>

            <Button Text="{svc:T save}" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}" Margin="0,6,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
