<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.CustomerCreatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Agent.Services"
    x:DataType="vm:CustomerCreateViewModel"
    Title="{svc:T add_customer}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18" Spacing="12">
            <Border Style="{StaticResource InputWrap}">
                <Entry Placeholder="{svc:T customer_name}" Text="{Binding Name}" ReturnType="Next" />
            </Border>
            <Border Style="{StaticResource InputWrap}">
                <Entry Placeholder="{svc:T phone}" Text="{Binding Phone}" Keyboard="Telephone" ReturnType="Next" />
            </Border>
            <Border Style="{StaticResource InputWrap}">
                <Entry Placeholder="{svc:T customer_address}" Text="{Binding Address}" ReturnType="Next" />
            </Border>
            <Border Style="{StaticResource InputWrap}">
                <Entry Placeholder="{svc:T credit_limit}" Text="{Binding CreditLimit}" Keyboard="Numeric" />
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                        <Path Data="{StaticResource IcPin}" Aspect="Uniform" WidthRequest="18" HeightRequest="18"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              Fill="{AppThemeBinding Light={StaticResource PrimaryBrush}, Dark={StaticResource SecondaryDarkTextBrush}}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{svc:T customer_location}" FontSize="14.5" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Text="{svc:T location_hint}" Style="{StaticResource MutedLabel}" FontSize="12"
                               IsVisible="{Binding HasLocation, Converter={StaticResource Invert}}" />
                        <Label Text="{Binding LocationText}" FontSize="12.5" FontAttributes="Bold"
                               IsVisible="{Binding HasLocation}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Style="{StaticResource BtnOutline}" HeightRequest="40" FontSize="13" Padding="14,0"
                            Text="{svc:T get_location}" Command="{Binding CaptureLocationCommand}"
                            IsVisible="{Binding HasLocation, Converter={StaticResource Invert}}" />
                    <Button Grid.Column="2" HeightRequest="40" FontSize="13" Padding="14,0" BackgroundColor="Transparent"
                            Text="✕" Command="{Binding ClearLocationCommand}" IsVisible="{Binding HasLocation}"
                            TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </Grid>
            </Border>
            <ActivityIndicator IsRunning="{Binding Locating}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                    IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding Error}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </Border>

            <Button Text="{svc:T save}" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}" Margin="0,6,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
