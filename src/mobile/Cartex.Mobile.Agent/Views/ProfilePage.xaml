<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Cartex.Mobile.Agent.ViewModels"
    xmlns:svc="clr-namespace:Cartex.Mobile.Agent.Services"
    x:DataType="vm:ProfileViewModel"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,24" Spacing="14">
            <Border Style="{StaticResource Card}" Padding="18,20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 34" WidthRequest="68" HeightRequest="68"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            HorizontalOptions="Center">
                        <Label Text="{Binding Initials}" FontSize="25" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </Border>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding FullName}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Text="{Binding Subtitle}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{svc:T actions}" Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="6,4,0,-6" />
            <Border Style="{StaticResource Card}" Padding="6,2">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenDevicesCommand}" />
                        </Grid.GestureRecognizers>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Path Data="{StaticResource IcDevices}" Aspect="Uniform" WidthRequest="17" HeightRequest="17"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                        </Border>
                        <Label Grid.Column="1" Text="{svc:T devices}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Grid.Column="2" Text="›" FontSize="22" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    </Grid>
                    <BoxView HeightRequest="1" Margin="58,0,10,0"
                             Color="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="10,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenOutboxCommand}" />
                        </Grid.GestureRecognizers>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Path Data="{StaticResource IcOutbox}" Aspect="Uniform" WidthRequest="17" HeightRequest="17"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                        </Border>
                        <Label Grid.Column="1" Text="{svc:T outbox_title}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Border Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,3"
                                IsVisible="{Binding HasOutbox}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource DangerBg}, Dark={StaticResource DangerBgDark}}">
                            <Label Text="{Binding OutboxBadge}" FontSize="12" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                        </Border>
                        <Label Grid.Column="3" Text="›" FontSize="22" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    </Grid>
                    <BoxView HeightRequest="1" Margin="58,0,10,0"
                             Color="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SyncCommand}" />
                        </Grid.GestureRecognizers>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Path Data="{StaticResource IcSync}" Aspect="Uniform" WidthRequest="17" HeightRequest="17"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                        </Border>
                        <Label Grid.Column="1" Text="{svc:T sync}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsBusy}" WidthRequest="20" HeightRequest="20"
                                           Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{svc:T settings}" Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="6,4,0,-6" />
            <Border Style="{StaticResource Card}" Padding="6,2">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="10,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChooseLanguageCommand}" />
                        </Grid.GestureRecognizers>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Path Data="{StaticResource IcGlobe}" Aspect="Uniform" WidthRequest="17" HeightRequest="17"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                        </Border>
                        <Label Grid.Column="1" Text="{svc:T language}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Grid.Column="2" Text="{Binding LanguageName}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="22" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    </Grid>
                    <BoxView HeightRequest="1" Margin="58,0,10,0"
                             Color="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                        </Grid.GestureRecognizers>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Path Data="{StaticResource IcKey}" Aspect="Uniform" WidthRequest="17" HeightRequest="17"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                        </Border>
                        <Label Grid.Column="1" Text="{svc:T change_password}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Grid.Column="2" Text="›" FontSize="22" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{svc:T security}" Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="6,4,0,-6" />
            <Border Style="{StaticResource Card}" Padding="6,2">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="10,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePinCommand}" />
                        </Grid.GestureRecognizers>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Path Data="{StaticResource IcLock}" Aspect="Uniform" WidthRequest="17" HeightRequest="17"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                        </Border>
                        <Label Grid.Column="1" Text="{svc:T pin_code}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label Grid.Column="2" Text="{Binding PinStatus}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="22" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    </Grid>
                    <BoxView HeightRequest="1" Margin="58,0,10,0"
                             Color="{AppThemeBinding Light={StaticResource Stroke}, Dark={StaticResource StrokeDark}}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,7" IsEnabled="{Binding BioAllowed}">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                            <Path Data="{StaticResource IcFingerprint}" Aspect="Uniform" WidthRequest="17" HeightRequest="17"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                        </Border>
                        <Label Grid.Column="1" Text="{svc:T biometric}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Switch Grid.Column="2" IsToggled="{Binding BioEnabled}" VerticalOptions="Center"
                                OnColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="{svc:T logout}" Command="{Binding LogoutCommand}" Margin="0,8,0,0"
                    BackgroundColor="Transparent" BorderWidth="1.4" CornerRadius="14" HeightRequest="48"
                    FontSize="15" FontAttributes="Bold"
                    BorderColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            <Label Text="{Binding Footer}" Style="{StaticResource MutedLabel}" FontSize="11.5"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
