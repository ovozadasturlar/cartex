<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.MapPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    Title="{svc:T map_pick_title}">
    <Grid>
        <WebView x:Name="Web" />
        <Button Text="{svc:T map_confirm}" Style="{StaticResource BtnPrimary}" Clicked="OnConfirm"
                VerticalOptions="End" Margin="20,0,20,24" />
    </Grid>
</ContentPage>
