<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cartex.Mobile.Agent.Views.CustomersMapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:svc="clr-namespace:Cartex.Mobile.Core;assembly=Cartex.Mobile.Core"
    Title="{svc:T customers_map}">
    <Grid>
        <WebView x:Name="Web" />
        <Label x:Name="Empty" Text="{svc:T map_empty}" Style="{StaticResource MutedLabel}" FontSize="14"
               IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
