<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Cartex.Mobile.Agent"
             xmlns:conv="clr-namespace:Cartex.Mobile.Agent.Converters"
             xmlns:core="clr-namespace:Cartex.Mobile.Core.Resources.Styles;assembly=Cartex.Mobile.Core"
             x:Class="Cartex.Mobile.Agent.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <core:CoreColors />
                <core:CoreTokens />
                <core:CoreTypography />
                <core:CoreComponents />
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NotEmptyConverter x:Key="NotEmpty" />
            <conv:PositiveConverter x:Key="Positive" />
            <conv:InvertConverter x:Key="Invert" />
            <conv:DotFillConverter x:Key="DotFill" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
