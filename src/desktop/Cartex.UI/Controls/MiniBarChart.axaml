<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cartex.UI.Controls.MiniBarChart"
             x:CompileBindings="False">

    <ItemsControl ItemsSource="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Height="210" VerticalAlignment="Bottom">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid RowDefinitions="*,Auto,Auto" Margin="3,0">
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Bars}"
                                  VerticalAlignment="Bottom" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="16" Height="{Binding Height}" Background="{Binding Fill}"
                                        CornerRadius="3,3,0,0" VerticalAlignment="Bottom" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="1" Text="{Binding ValueText}" FontSize="10" Margin="0,4,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="10"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
