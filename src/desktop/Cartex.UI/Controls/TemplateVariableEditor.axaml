<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             x:Class="Cartex.UI.Controls.TemplateVariableEditor"
             x:Name="Root"
             x:CompileBindings="True">
    <StackPanel Spacing="7">
        <TextBlock Text="{Binding #Root.Label}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
        <ItemsControl ItemsSource="{Binding #Root.Variables}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                    <Border Background="{DynamicResource SidebarItemHover}" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Margin="0,0,6,5">
                        <Grid ColumnDefinitions="Auto,Auto">
                            <Button Content="{Binding .}" Tag="{Binding .}" Click="OnVariableClick"
                                    Background="Transparent" BorderThickness="0" Padding="9,4,4,4"
                                    FontSize="11.5" FontFamily="Consolas" Cursor="Hand" />
                            <TextBlock Grid.Column="1" Text="⠿" Tag="{Binding .}" PointerPressed="OnDragHandlePressed"
                                       Padding="3,4,7,4" Cursor="SizeAll" Foreground="{DynamicResource TextMuted}"
                                       ToolTip.Tip="{Binding #Root.DragHint}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="Editor" Text="{Binding #Root.Text, Mode=TwoWay}" MinHeight="82"
                 AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="{Binding #Root.PlaceholderText}"
                 DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop" />
    </StackPanel>
</UserControl>
