<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BrandPrimary">#255D3A</Color>
    <Color x:Key="BrandPrimaryHover">#2E7448</Color>
    <Color x:Key="BrandLight">#DEEDE4</Color>
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="SuccessHover">#047857</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerHover">#B91C1C</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningHover">#D97706</Color>
    <Color x:Key="Info">#0EA5E9</Color>
    <Color x:Key="DarkBg">#111318</Color>
    <Color x:Key="DarkSurface">#1A1D24</Color>
    <Color x:Key="LightBg">#F5F5F0</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>

</ResourceDictionary>
