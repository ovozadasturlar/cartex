<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Cartex.UI.Controls"
                    xmlns:conv="using:Cartex.UI.Converters"
                    xmlns:vm="using:Cartex.UI.ViewModels.Common"
                    xmlns:mi="using:Material.Icons.Avalonia">

    <ControlTheme x:Key="{x:Type c:PageHeader}" TargetType="c:PageHeader">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Title}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{TemplateBinding Subtitle}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"
                                   IsVisible="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:FieldLabel}" TargetType="c:FieldLabel">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="{TemplateBinding Text}" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="*" FontSize="12.5" FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding Required, RelativeSource={RelativeSource TemplatedParent}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:FilterBar}" TargetType="c:FilterBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                             PlaceholderText="{TemplateBinding Watermark}" MaxWidth="380" MinHeight="38"
                             HorizontalAlignment="Left">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0"
                                             Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:Pager}" TargetType="c:Pager">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid DataContext="{TemplateBinding State}" x:DataType="vm:PaginationState"
                      ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0"
                      IsVisible="{Binding TotalCount, Converter={x:Static conv:IntPositiveConverter.Instance}}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="FormatListNumbered" Width="15" Height="15"
                                         Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding TotalCount}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                    </StackPanel>
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                      Margin="20,0,0,0"
                                      DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}"
                                  MinWidth="76" VerticalAlignment="Center" />
                        <Button Classes="icon" Command="{Binding FirstCommand}" IsEnabled="{Binding CanPrev}">
                            <mi:MaterialIcon Kind="ChevronDoubleLeft" Width="16" Height="16" />
                        </Button>
                        <Button Classes="icon" Command="{Binding PrevCommand}" IsEnabled="{Binding CanPrev}">
                            <mi:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
                        </Button>
                        <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" MinWidth="56"
                                   TextAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                        <Button Classes="icon" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}">
                            <mi:MaterialIcon Kind="ChevronRight" Width="16" Height="16" />
                        </Button>
                        <Button Classes="icon" Command="{Binding LastCommand}" IsEnabled="{Binding CanNext}">
                            <mi:MaterialIcon Kind="ChevronDoubleRight" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:StatCard}" TargetType="c:StatCard">
        <Setter Property="Accent" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{TemplateBinding Value}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="46" Height="46" CornerRadius="10"
                                Background="{TemplateBinding Accent}" VerticalAlignment="Top">
                            <mi:MaterialIcon Kind="{TemplateBinding Icon}" Width="24" Height="24"
                                             Foreground="White" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:EmptyState}" TargetType="c:EmptyState">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="380">
                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                            Background="{DynamicResource SidebarItemHover}">
                        <mi:MaterialIcon Kind="{TemplateBinding Icon}" Width="34" Height="34"
                                         Foreground="{DynamicResource TextMuted}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{TemplateBinding Message}" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" />
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:Skeleton}" TargetType="c:Skeleton">
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource SidebarItemHover}" CornerRadius="6" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^">
            <Style.Animations>
                <Animation Duration="0:0:1.3" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.9" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

</ResourceDictionary>
