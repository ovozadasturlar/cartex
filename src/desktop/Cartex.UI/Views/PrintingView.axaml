<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cartex.UI.Controls"
             x:Class="Cartex.UI.Views.PrintingView"
             x:CompileBindings="False">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">

            <c:PageHeader Title="{Binding L[printing]}" />

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[printer_receipt]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding ReceiptPrinter}"
                                  HorizontalAlignment="Stretch" PlaceholderText="—" />
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[printer_zreport]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding ZReportPrinter}"
                                  HorizontalAlignment="Stretch" PlaceholderText="—" />
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[printer_barcode]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding BarcodePrinter}"
                                  HorizontalAlignment="Stretch" PlaceholderText="—" />
                        <StackPanel Spacing="5" Margin="0,10,0,0">
                            <TextBlock Text="{Binding L[label_size]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <Grid ColumnDefinitions="Auto,8,110,8,110">
                                <ComboBox MinWidth="110" ItemsSource="{Binding LabelPresets}" SelectedItem="{Binding SelectedLabelPreset}" />
                                <NumericUpDown Grid.Column="2" Value="{Binding LabelWidthMm}" Minimum="20" Maximum="120" FormatString="0" MinHeight="34" />
                                <NumericUpDown Grid.Column="4" Value="{Binding LabelHeightMm}" Minimum="20" Maximum="120" FormatString="0" MinHeight="34" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[printer_document]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding DocumentPrinter}"
                                  HorizontalAlignment="Stretch" PlaceholderText="—" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ToggleSwitch IsChecked="{Binding AutoPrintReceipt}" />
                        <TextBlock Text="{Binding L[printer_auto]}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[printer_server_url]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding ServerUrl}" MinHeight="38" PlaceholderText="http://..." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}" />
                        <Button Classes="outline" Command="{Binding TestPrintCommand}" Content="{Binding L[printer_test]}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
