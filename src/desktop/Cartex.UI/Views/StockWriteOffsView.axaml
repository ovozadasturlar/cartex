<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.StockWriteOffsView"
             c:Shortcuts.Source="{Binding Shortcuts}"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="DockPanel.editor TextBlock.field">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Border.total">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- ================= REPORT ================= -->
        <DockPanel Margin="24" IsVisible="{Binding !IsEditorOpen}" Classes.blurred="{Binding IsDetailOpen}">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[write_offs]}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
                    <Button Classes="brand" Command="{Binding OpenEditorCommand}" IsVisible="{Binding CanWriteOff}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[write_off_new]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,16"
                  IsVisible="{Binding CanViewReport}">
                <TextBlock Text="{Binding L[date_from]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,16,0" />
                <TextBlock Grid.Column="2" Text="{Binding L[date_to]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="3" SelectedDate="{Binding DateTo, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,16,0" />
                <TextBlock Grid.Column="4" Text="{Binding L[warehouse]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <ComboBox Grid.Column="5" MinWidth="150" MinHeight="36" Margin="8,0,16,0"
                          ItemsSource="{Binding FilterWarehouses}" SelectedItem="{Binding FilterWarehouse}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="6" Text="{Binding L[reason]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <ComboBox Grid.Column="7" MinWidth="150" MinHeight="36" Margin="8,0,0,0"
                          ItemsSource="{Binding FilterReasons}" SelectedItem="{Binding FilterReason}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="8" Classes="icon" HorizontalAlignment="Right" Command="{Binding RefreshCommand}"
                        ToolTip.Tip="{Binding L[refresh]}">
                    <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" />
                </Button>
            </Grid>

            <TabControl IsVisible="{Binding CanViewReport}">
                <TabItem Header="{Binding L[write_off_documents]}">
                    <DockPanel Margin="0,10,0,0">
                        <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}" />
                        <Panel>
                            <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <DataGrid ItemsSource="{Binding Documents}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserSortColumns="False"
                                          c:GridDoubleClick.Command="{Binding OpenDetailCommand}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="Auto" Binding="{Binding Document.DocumentNumber}"
                                                            Header="{Binding [write_off_document], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="Auto" Binding="{Binding Document.BusinessDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                            Header="{Binding [date], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="*" Binding="{Binding Document.WarehouseName}"
                                                            Header="{Binding [warehouse], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="Auto" Binding="{Binding Document.Lines.Count}"
                                                            Header="{Binding [items], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="Auto" Binding="{Binding Document.TotalCost, StringFormat='{}{0:N0}'}"
                                                            Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="Auto" Binding="{Binding Document.SupplierClaimAmount, StringFormat='{}{0:N0}'}"
                                                            Header="{Binding [write_off_claim_total], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="*" Binding="{Binding Document.UserName}"
                                                            Header="{Binding [user], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTemplateColumn Width="Auto"
                                                                Header="{Binding [status], Source={x:Static svc:LocalizationManager.Instance}}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Margin="6,4" Padding="8,2" CornerRadius="8" IsVisible="{Binding HasStatus}"
                                                            Background="{DynamicResource AppBg}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Status}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondary}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Classes="icon" IsVisible="{Binding CanReverse}"
                                                                Command="{Binding $parent[DataGrid].DataContext.ReverseCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[write_off_reverse]}">
                                                            <mi:MaterialIcon Kind="Undo" Width="17" Height="17"
                                                                             Foreground="{DynamicResource DangerBrush}" />
                                                        </Button>
                                                        <Button Classes="icon"
                                                                Command="{Binding $parent[DataGrid].DataContext.OpenDetailCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[details]}">
                                                            <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18"
                                                                             Foreground="{DynamicResource TextSecondary}" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <c:EmptyState Icon="PackageVariantRemove" Title="{Binding L[write_off_empty]}" IsVisible="{Binding IsEmpty}" />
                        </Panel>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{Binding L[write_off_balances]}">
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[write_off_balances_hint]}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,10" />
                        <Panel>
                            <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <DataGrid ItemsSource="{Binding Balances}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserSortColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*" Binding="{Binding WarehouseName}"
                                                            Header="{Binding [warehouse], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTemplateColumn Width="Auto"
                                                                Header="{Binding [write_off_location], Source={x:Static svc:LocalizationManager.Instance}}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="10,0" VerticalAlignment="Center"
                                                               Text="{Binding Location, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=disposition}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Width="2*" Binding="{Binding ProductName}"
                                                            Header="{Binding [product_name], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="Auto" Binding="{Binding Quantity, StringFormat='{}{0:N3}'}"
                                                            Header="{Binding [quantity], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <c:EmptyState Icon="ScaleBalance" Title="{Binding L[no_data]}" IsVisible="{Binding NoBalances}" />
                        </Panel>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- ================= EDITOR ================= -->
        <DockPanel Margin="24" Classes="editor" IsVisible="{Binding IsEditorOpen}" c:FormBehaviors.AutoFocus="True">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                <Button Classes="icon" Command="{Binding CloseEditorCommand}" ToolTip.Tip="{Binding L[back]}">
                    <mi:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding L[write_off_new]}" Classes="h1" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>

            <Border DockPanel.Dock="Top" Classes="form" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="14" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto,2*" ColumnSpacing="14">
                    <StackPanel MinWidth="0">
                        <TextBlock Classes="field" Text="{Binding L[warehouse]}" />
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding EditorWarehouse}"
                                  MinHeight="34" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="field" Text="{Binding L[date]}" />
                        <DatePicker SelectedDate="{Binding BusinessDate, Mode=TwoWay}" MinHeight="34" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" MinWidth="0">
                        <TextBlock Classes="field" Text="{Binding L[note]}" />
                        <TextBox Text="{Binding Note, Mode=TwoWay}" PlaceholderText="{Binding L[note]}" MinHeight="34" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="{DynamicResource AppBg}" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <AutoCompleteBox MinHeight="34" AsyncPopulator="{Binding ProductPopulator}"
                                     FilterMode="None" MinimumPrefixLength="1"
                                     Text="{Binding ProductSearch, Mode=TwoWay}"
                                     SelectedItem="{Binding LineProduct, Mode=TwoWay}"
                                     ValueMemberBinding="{Binding Name}"
                                     PlaceholderText="{Binding L[select_product]}">
                        <AutoCompleteBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                    <TextBlock Text="{Binding L[write_off_mixed_batches_hint]}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding HasMixedClaimBatches}" />
                </StackPanel>
            </Border>

            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Margin="0,10,0,0">
                <Border Classes="total">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding TotalCost, StringFormat='{}{0:N0}'}" FontWeight="Bold"
                                   Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="total">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding L[write_off_claim_total]}" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding ClaimTotal, StringFormat='{}{0:N0}'}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                    <Button Classes="outline" MinWidth="120" Command="{Binding CloseEditorCommand}" Content="{Binding L[cancel]}" />
                    <Button Classes="brand" MinWidth="140" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding HasLines}" Content="{Binding L[save]}" />
                </StackPanel>
            </Grid>

            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding ProductName}"
                                                Header="{Binding [product], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <!-- BRAK-03: qator aynan shu partiyadan chiqadi va ro'yxatda har
                                 partiyaning qaytarish imkoni yozib qo'yilgan. -->
                            <DataGridTemplateColumn Width="2*"
                                                    Header="{Binding [write_off_batch], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox MinHeight="30" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Batches}" SelectedItem="{Binding Batch, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="Auto" IsReadOnly="True" Binding="{Binding Available, StringFormat='{}{0:0.###}'}"
                                                Header="{Binding [write_off_available], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="130"
                                                    Header="{Binding [qty], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <NumericUpDown Minimum="0" Maximum="{Binding Available}" Increment="1"
                                                       FormatString="0.###" ShowButtonSpinner="False" MinHeight="30"
                                                       Value="{Binding Quantity, Mode=TwoWay, Converter={x:Static conv:EmptyKeepsValueConverter.Instance}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- BRAK-01: sabab ro'yxatdan tanlanadi, erkin matn emas. -->
                            <DataGridTemplateColumn Width="160"
                                                    Header="{Binding [reason], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox MinHeight="30" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ReasonOptions}" SelectedItem="{Binding Reason, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=write_off_reason}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="170"
                                                    Header="{Binding [ret_disposition], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox MinHeight="30" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding DispositionOptions}" SelectedItem="{Binding Disposition, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=disposition}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="Auto" IsReadOnly="True" Binding="{Binding LineCost, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding Note, Mode=TwoWay}"
                                                Header="{Binding [note], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="icon"
                                                Command="{Binding $parent[DataGrid].DataContext.RemoveLineCommand}"
                                                CommandParameter="{Binding}">
                                            <mi:MaterialIcon Kind="Delete" Width="17" Height="17"
                                                             Foreground="{DynamicResource DangerBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="PackageVariantClosed" Title="{Binding L[write_off_no_lines]}" IsVisible="{Binding !HasLines}" />
            </Panel>
        </DockPanel>

        <!-- ================= DETAIL ================= -->
        <Border IsVisible="{Binding IsDetailOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CloseDetailCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="760" MaxHeight="620"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="24">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedDocument.DocumentNumber}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14" />
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" ColumnSpacing="14" Margin="0,0,0,14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding L[date]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedDocument.BusinessDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding L[warehouse]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedDocument.WarehouseName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{Binding L[user]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedDocument.UserName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedDocument.TotalCost, StringFormat='{}{0:N0}'}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrandPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,14,0,0">
                        <TextBlock Text="{Binding SelectedDocument.Note}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}" FontSize="12" />
                        <Button Grid.Column="1" Classes="outline" IsVisible="{Binding CanReverseSelected}"
                                Command="{Binding ReverseCommand}" CommandParameter="{Binding SelectedRow}"
                                Content="{Binding L[write_off_reverse]}" />
                        <Button Grid.Column="2" Classes="brand" Command="{Binding CloseDetailCommand}" Content="{Binding L[close]}" />
                    </Grid>

                    <Border Background="{DynamicResource AppBg}" CornerRadius="10" ClipToBounds="True"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding SelectedDocument.Lines}" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding ProductName}"
                                                    Header="{Binding [product], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding Quantity, StringFormat='{}{0:0.###}'}"
                                                    Header="{Binding [qty], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTemplateColumn Width="Auto"
                                                        Header="{Binding [reason], Source={x:Static svc:LocalizationManager.Instance}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="10,0" VerticalAlignment="Center"
                                                       Text="{Binding Reason, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=write_off_reason}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="Auto"
                                                        Header="{Binding [ret_disposition], Source={x:Static svc:LocalizationManager.Instance}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="10,0" VerticalAlignment="Center"
                                                       Text="{Binding Disposition, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=disposition}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="*" Binding="{Binding SupplierName}"
                                                    Header="{Binding [supplier], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding LineCost, StringFormat='{}{0:N0}'}"
                                                    Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="*" Binding="{Binding Note}"
                                                    Header="{Binding [note], Source={x:Static svc:LocalizationManager.Instance}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
