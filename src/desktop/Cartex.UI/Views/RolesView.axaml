<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             x:Class="Cartex.UI.Views.RolesView"
             x:CompileBindings="False">

    <UserControl.Resources>
        <DataTemplate x:Key="PermGroupTemplate">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}"
                                      Margin="6,1" FontSize="13" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Panel>
        <DockPanel Margin="24" Classes.blurred="{Binding IsEditOpen}">

            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[roles]}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
                    <Button Classes="brand" Command="{Binding OpenCreateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[create_role]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader>

            <TextBox DockPanel.Dock="Top" Classes="search" Margin="0,0,0,14"
                     PlaceholderText="{Binding L[search]}" Text="{Binding SearchText, Mode=TwoWay}" />

            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              c:GridDoubleClick.Command="{Binding OpenEditCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding Name}"
                                                Header="{Binding [name], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="2*" Binding="{Binding Description}"
                                                Header="{Binding [description], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding StartPage}"
                                                Header="{Binding [start_page], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding Priority}"
                                                Header="{Binding [priority], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding Permissions.Count}"
                                                Header="{Binding [permissions], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="icon" Margin="6,0"
                                                Command="{Binding $parent[DataGrid].DataContext.OpenEditCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[edit]}">
                                            <mi:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                                             Foreground="{DynamicResource TextSecondary}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="ShieldAccount" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
            </Panel>
        </DockPanel>

        <Border IsVisible="{Binding IsEditOpen}" Background="#30000000">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="940" MaxHeight="640"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <DockPanel Margin="24">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding EditTitle}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="10" Margin="0,16,0,0">
                        <Button Classes="outline" Command="{Binding CancelEditCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="280,*" RowSpacing="0" ColumnSpacing="20">

                        <StackPanel Grid.Column="0" Spacing="12">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <TextBox Text="{Binding EditName}" MinHeight="38" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[description]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <TextBox Text="{Binding EditDescription}" MinHeight="38" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[start_page]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <ComboBox ItemsSource="{Binding StartPages}" SelectedItem="{Binding SelectedStartPage}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[priority]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <NumericUpDown Value="{Binding EditPriority, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Maximum="1000" Increment="10"
                                               FormatString="0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource AppBg}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                            <TabControl>
                                <TabItem Header="{Binding L[permissions]}" FontSize="13">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding PermissionGroups}"
                                                      ItemTemplate="{StaticResource PermGroupTemplate}" Margin="10,4,10,10" />
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{Binding L[grantable_permissions]}" FontSize="13"
                                         IsVisible="{Binding ShowGrantableTab}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[grantable_hint]}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="10,6,10,4" />
                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{Binding GrantablePermissionGroups}"
                                                          ItemTemplate="{StaticResource PermGroupTemplate}" Margin="10,4,10,10" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="{Binding L[assignable_roles]}" FontSize="13"
                                         IsVisible="{Binding HasUsersManageSelected}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[assignable_roles_hint]}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="10,6,10,4" />
                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{Binding AssignableRoleItems}" Margin="10,4,10,10">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
