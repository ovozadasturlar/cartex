<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.AdjustStockDialog"
             x:CompileBindings="False">

    <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="420"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            BoxShadow="0 18 50 0 #33000000" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding L[stock_count]}" Classes="h2" />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding ProductName}" Classes="caption" />
                <TextBlock Text="{Binding UnitName}" Classes="caption" />
            </StackPanel>

            <Grid ColumnDefinitions="*,12,*">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{Binding L[system_quantity]}" Classes="caption" />
                    <TextBlock Text="{Binding SystemQuantity, StringFormat={}{0:N0}}" FontWeight="SemiBold"
                               MinHeight="38" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="{Binding L[counted]}" Classes="caption" />
                    <NumericUpDown Value="{Binding CountedQuantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" FormatString="0.##" MinHeight="38" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="{Binding L[difference]}" Classes="caption" />
                <TextBlock Text="{Binding Difference, StringFormat={}{0:N0}}" FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningBrush}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{Binding L[reason]}" Classes="caption" />
                <TextBox Text="{Binding Reason, Mode=TwoWay}" MinHeight="40" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                <Button Grid.Column="1" Classes="outline" Margin="0,0,10,0" MinWidth="100"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CancelCommand}" Content="{Binding L[cancel]}" />
                <Button Grid.Column="2" Classes="brand" MinWidth="120" HorizontalContentAlignment="Center"
                        Command="{Binding ConfirmCommand}" Content="{Binding L[save]}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
