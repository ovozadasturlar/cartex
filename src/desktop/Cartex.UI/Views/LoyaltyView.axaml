<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:svc="using:Cartex.UI.Services"
             x:Class="Cartex.UI.Views.LoyaltyView"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Button.subnav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.subnav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
        </Style>
        <Style Selector="Button.subnav.active">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <DockPanel Margin="24">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[loyalty]}" Margin="0,0,0,16" />

            <Grid ColumnDefinitions="220,*">
                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="8" Margin="0,0,16,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                        <Button Classes="subnav" Classes.active="{Binding IsDiscountSection}" Content="{Binding L[discounts]}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="discounts" />
                        <Button Classes="subnav" Classes.active="{Binding IsCashbackSection}" Content="{Binding L[cashback_rules]}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="cashback" />
                        <Button Classes="subnav" Classes.active="{Binding IsSettingsSection}" Content="{Binding L[app_settings]}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="settings" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1">
                    <Panel HorizontalAlignment="Stretch">

                        <StackPanel Spacing="16" IsVisible="{Binding IsDiscountSection}">
                            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding L[discounts]}" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="brand" Command="{Binding OpenCreateDiscountCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                                <TextBlock Text="{Binding L[add_rule]}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                        <DataGrid ItemsSource="{Binding DiscountRules}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" MinHeight="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="*" Binding="{Binding Dto.Name}"
                                                                    Header="{Binding [name], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTextColumn Width="*" Binding="{Binding ScopeText}"
                                                                    Header="{Binding [type], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTextColumn Width="Auto" Binding="{Binding ValueText}"
                                                                    Header="{Binding [value], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTextColumn Width="Auto" Binding="{Binding ConditionText}"
                                                                    Header="{Binding [discount_min_amount], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTextColumn Width="Auto" Binding="{Binding PeriodText}"
                                                                    Header="{Binding [discount_period], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTextColumn Width="Auto" Binding="{Binding Dto.Priority}"
                                                                    Header="{Binding [priority], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTemplateColumn Width="Auto"
                                                                        Header="{Binding [status], Source={x:Static svc:LocalizationManager.Instance}}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="999" Padding="10,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource SidebarItemHover}">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                                           Foreground="{DynamicResource TextSecondary}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}" Margin="4,0"
                                                                              Command="{Binding $parent[DataGrid].DataContext.ToggleDiscountCommand}"
                                                                              CommandParameter="{Binding}" />
                                                                <Button Classes="icon" Margin="4,0"
                                                                        Command="{Binding $parent[DataGrid].DataContext.OpenEditDiscountCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <mi:MaterialIcon Kind="Pencil" Width="15" Height="15"
                                                                                     Foreground="{DynamicResource TextSecondary}" />
                                                                </Button>
                                                                <Button Classes="icon" Margin="4,0"
                                                                        Command="{Binding $parent[DataGrid].DataContext.DeleteDiscountCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <mi:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15"
                                                                                     Foreground="{DynamicResource DangerBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                    <TextBlock Text="{Binding L[discount_hint]}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="11.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left" IsVisible="{Binding IsCashbackSection}">
                            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ToggleSwitch IsChecked="{Binding IsEnabled}" />
                                        <TextBlock Text="{Binding L[active]}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding L[cashback_rounding]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                        <ComboBox ItemsSource="{Binding RoundingOptions}" SelectedIndex="{Binding RoundingIndex}"
                                                  MinWidth="240" HorizontalAlignment="Left" MinHeight="38" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding L[cashback_percent]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                        <NumericUpDown Value="{Binding TotalPercent}" Minimum="0" Maximum="100" Increment="0.5"
                                                       FormatString="0.##" MinWidth="240" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding L[cashback_hint]}" Foreground="{DynamicResource TextMuted}"
                                                   FontSize="11.5" TextWrapping="Wrap" MaxWidth="420" />
                                    </StackPanel>
                                    <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding L[cashback_rules]}" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="brand" Command="{Binding OpenCreateRuleCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                                <TextBlock Text="{Binding L[add_rule]}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                        <DataGrid ItemsSource="{Binding Rules}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" MinHeight="120">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="Auto" Binding="{Binding Scope}"
                                                                    Header="{Binding [type], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTextColumn Width="*" Binding="{Binding TargetName}"
                                                                    Header="{Binding [name], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTextColumn Width="Auto" Binding="{Binding Method}"
                                                                    Header="{Binding [method], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTextColumn Width="Auto" Binding="{Binding Value, StringFormat='{}{0:0.##}'}"
                                                                    Header="{Binding [value], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTextColumn Width="Auto" Binding="{Binding Priority}"
                                                                    Header="{Binding [priority], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                <DataGridTemplateColumn Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Classes="icon" Margin="4,0"
                                                                        Command="{Binding $parent[DataGrid].DataContext.OpenEditRuleCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <mi:MaterialIcon Kind="Pencil" Width="15" Height="15"
                                                                                     Foreground="{DynamicResource TextSecondary}" />
                                                                </Button>
                                                                <Button Classes="icon" Margin="4,0"
                                                                        Command="{Binding $parent[DataGrid].DataContext.DeleteRuleCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <mi:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15"
                                                                                     Foreground="{DynamicResource DangerBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left" IsVisible="{Binding IsSettingsSection}">
                            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{Binding L[discount_combine_mode]}" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <StackPanel Spacing="8">
                                        <RadioButton GroupName="combine" Content="{Binding L[discount_combine_priority]}"
                                                     IsChecked="{Binding !CombineModeIndex}" />
                                        <RadioButton GroupName="combine" Content="{Binding L[discount_combine_stack]}"
                                                     IsChecked="{Binding CombineModeIndex}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding L[discount_combine_hint]}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="11.5" TextWrapping="Wrap" />
                                    <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Panel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <Border IsVisible="{Binding IsRuleOpen}" Background="#80000000">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="440"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="24" Spacing="14">
                    <TextBlock Text="{Binding L[cashback_rules]}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[type]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding RuleScope}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding IsProductScope}">
                        <TextBlock Text="{Binding L[product]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding RuleProduct}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding !IsProductScope}">
                        <TextBlock Text="{Binding L[category]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding RuleCategory}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[method]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding RuleMethod}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="{Binding L[value]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <NumericUpDown Value="{Binding RuleValue}" Minimum="0" FormatString="0.##" MinHeight="38" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{Binding L[priority]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <NumericUpDown Value="{Binding RulePriority}" Minimum="0" FormatString="0" MinHeight="38" />
                        </StackPanel>
                    </Grid>
                    <CheckBox IsChecked="{Binding RuleExcludeFromTotal}" Content="{Binding L[exclude_from_total]}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                        <Button Classes="outline" Command="{Binding CancelRuleCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" Command="{Binding SaveRuleCommand}" Content="{Binding L[save]}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding IsDiscountOpen}" Background="#80000000">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="520" MaxHeight="640"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer>
                    <StackPanel Margin="24" Spacing="12">
                        <TextBlock Text="{Binding L[discounts]}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <Grid ColumnDefinitions="*,12,Auto">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <TextBox Text="{Binding DiscountName}" MinHeight="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="{Binding L[active]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <ToggleSwitch IsChecked="{Binding DiscountEnabled}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[type]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <ComboBox ItemsSource="{Binding DiscountScopes}" SelectedItem="{Binding DiscountScope}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="{Binding L[method]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <ComboBox ItemsSource="{Binding DiscountMethods}" SelectedItem="{Binding DiscountMethod}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="5" IsVisible="{Binding IsDiscountProductScope}">
                            <TextBlock Text="{Binding L[product]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding DiscountProduct}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="5" IsVisible="{Binding IsDiscountCategoryScope}">
                            <TextBlock Text="{Binding L[category]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding DiscountCategory}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="5" IsVisible="{Binding IsDiscountManufacturerScope}">
                            <TextBlock Text="{Binding L[manufacturer]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ComboBox ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding DiscountManufacturer}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding L[customer]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding DiscountCustomer}" HorizontalAlignment="Stretch"
                                          PlaceholderText="{Binding L[all_customers]}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullName}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Classes="icon" Command="{Binding ClearDiscountCustomerCommand}">
                                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource TextSecondary}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,*,12,*">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[value]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <NumericUpDown Value="{Binding DiscountValue}" Minimum="0" FormatString="0.##" MinHeight="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="{Binding L[discount_min_amount]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <NumericUpDown Value="{Binding DiscountMinAmount}" Minimum="0" FormatString="0" MinHeight="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="5">
                                <TextBlock Text="{Binding L[priority]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <NumericUpDown Value="{Binding DiscountPriority}" Minimum="0" FormatString="0" MinHeight="36" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[discount_starts]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <DatePicker SelectedDate="{Binding DiscountStartsOn}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="{Binding L[discount_ends]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <DatePicker SelectedDate="{Binding DiscountEndsOn}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding L[discount_exceptions]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                                <ComboBox ItemsSource="{Binding ExceptionScopes}" SelectedItem="{Binding ExceptionScope}" MinWidth="150">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <Panel Grid.Column="2">
                                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding ExceptionProduct}"
                                              HorizontalAlignment="Stretch" IsVisible="{Binding IsExceptionProduct}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding ExceptionCategory}"
                                              HorizontalAlignment="Stretch" IsVisible="{Binding IsExceptionCategory}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding ExceptionManufacturer}"
                                              HorizontalAlignment="Stretch" IsVisible="{Binding IsExceptionManufacturer}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Panel>
                                <Button Grid.Column="4" Classes="outline" Command="{Binding AddExceptionCommand}" Content="+" MinWidth="40" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DiscountExceptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="999" Padding="10,4" Margin="0,4,6,0"
                                                Background="{DynamicResource SidebarItemHover}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <Button Classes="icon" Padding="0"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveExceptionCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Close" Width="12" Height="12"
                                                                     Foreground="{DynamicResource TextSecondary}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                            <Button Classes="outline" Command="{Binding CancelDiscountCommand}" Content="{Binding L[cancel]}" />
                            <Button Classes="brand" Command="{Binding SaveDiscountCommand}" Content="{Binding L[save]}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Panel>
</UserControl>
