<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:il="using:AsyncImageLoader"
             xmlns:views="using:Cartex.UI.Views"
             x:Class="Cartex.UI.Views.ProductsView"
             c:Shortcuts.Source="{Binding Shortcuts}"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Button.icon-sm">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-sm:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <DockPanel Margin="24" Classes.blurred="{Binding IsModalOpen}">

            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[products]}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="outline" Command="{Binding Import.OpenCommand}" IsVisible="{Binding CanImport}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="FileExcel" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[import_excel]}" />
                        </StackPanel>
                    </Button>
                    <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
                    <Button Classes="brand" Command="{Binding OpenCreateCommand}" IsVisible="{Binding CanCreate}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[add_product]}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader>

            <c:FilterBar DockPanel.Dock="Top" SearchText="{Binding SearchText, Mode=TwoWay}"
                         Watermark="{Binding L[search]}" SearchWidth="380" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding FilterMinPrice}" Minimum="0" ShowButtonSpinner="False"
                                   MinWidth="112" PlaceholderText="{Binding L[price_from]}" />
                    <NumericUpDown Value="{Binding FilterMaxPrice}" Minimum="0" ShowButtonSpinner="False"
                                   MinWidth="112" PlaceholderText="{Binding L[price_to]}" />
                    <ComboBox ItemsSource="{Binding FilterCategories}" SelectedItem="{Binding FilterCategory}"
                              MinWidth="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox MinWidth="130" ItemsSource="{Binding Paging.SortOptions}" SelectedItem="{Binding Paging.SelectedSort}" />
                    <Button Classes="icon" Command="{Binding Paging.ToggleDirectionCommand}" ToolTip.Tip="{Binding L[sort]}">
                        <Panel>
                            <mi:MaterialIcon Kind="SortAscending" Width="18" Height="18" IsVisible="{Binding !Paging.Descending}" />
                            <mi:MaterialIcon Kind="SortDescending" Width="18" Height="18" IsVisible="{Binding Paging.Descending}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </c:FilterBar>

            <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding L[total_quantity]}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding Totals.TotalOnHand, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                </StackPanel>
            </c:Pager>

            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" CanUserResizeColumns="False"
                              HeadersVisibility="Column" c:GridDoubleClick.Command="{Binding OpenEditCommand}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="34" Height="34" Margin="8,4" Padding="0" BorderThickness="0"
                                                Background="Transparent" VerticalAlignment="Center"
                                                Command="{Binding $parent[DataGrid].DataContext.OpenProductImageCommand}"
                                                CommandParameter="{Binding}">
                                            <Border CornerRadius="7" ClipToBounds="True" Background="{DynamicResource AppBg}">
                                                <Panel>
                                                    <mi:MaterialIcon Kind="ImageOutline" Width="16" Height="16"
                                                                     Foreground="{DynamicResource TextMuted}" />
                                                    <Image il:ImageLoader.Source="{Binding ImageUrl, Converter={x:Static conv:ThumbImageUrlConverter.Instance}}" Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="2.1*" MinWidth="160" Binding="{Binding Name}"
                                                Header="{Binding [name], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="1.3*" MinWidth="100" Binding="{Binding CategoryName}"
                                                Header="{Binding [category], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="75" Binding="{Binding UnitName}"
                                                Header="{Binding [unit], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="82" Binding="{Binding OnHand, Mode=OneWay, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [on_hand], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="0.5*" MinWidth="104" Binding="{Binding MinStock, Mode=OneWay, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [min_stock], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="1.2*" MinWidth="100" Binding="{Binding ProductTypeName}"
                                                Header="{Binding [product_type], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="70"
                                                    Header="{Binding [active], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}" Margin="8,0"
                                                      VerticalAlignment="Center"
                                                      IsEnabled="{Binding $parent[DataGrid].DataContext.CanToggleProduct}"
                                                      Command="{Binding $parent[DataGrid].DataContext.ToggleEnabledCommand}"
                                                      CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="132">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="icon-sm" VerticalAlignment="Center" Margin="4,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.OpenPrintBarcodeCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding $parent[DataGrid].DataContext.CanPrintBarcode}"
                                                    ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[barcode_print]}">
                                                <mi:MaterialIcon Kind="BarcodeScan" Width="16" Height="16"
                                                                 Foreground="{DynamicResource TextSecondary}" />
                                            </Button>
                                            <Button Classes="icon-sm" VerticalAlignment="Center" Margin="4,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.OpenVariantsCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[variants]}">
                                                <mi:MaterialIcon Kind="FormatListBulletedType" Width="16" Height="16"
                                                                 Foreground="{DynamicResource TextSecondary}" />
                                            </Button>
                                            <Button Classes="icon-sm" VerticalAlignment="Center" Margin="4,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.OpenEditCommand}"
                                                    IsVisible="{Binding $parent[DataGrid].DataContext.CanEdit}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                                                 Foreground="{DynamicResource TextSecondary}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <c:EmptyState Icon="PackageVariantClosed" Title="{Binding L[no_data]}"
                              IsVisible="{Binding IsEmpty}" />
            </Panel>
        </DockPanel>

        <views:ProductEditorDialog />
        <Border Background="#30000000" IsVisible="{Binding IsVariantsOpen}" c:OverlayBehaviors.DismissCommand="{Binding CloseVariantsCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="560" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    BoxShadow="0 18 50 0 #33000000" Padding="24">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding L[variants]}" Classes="h2" />
                            <TextBlock Text="{Binding VariantProductName}" Classes="caption" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="brand" Command="{Binding OpenVariantCreateCommand}"
                                IsVisible="{Binding CanEdit}"
                                Content="{Binding L[add_variant]}" VerticalAlignment="Center" />
                    </Grid>
                    <Button DockPanel.Dock="Bottom" Classes="outline" HorizontalAlignment="Right" Margin="0,14,0,0"
                            Command="{Binding CloseVariantsCommand}" Content="{Binding L[close]}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Variants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SidebarItemHover}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <Border Background="{DynamicResource BrandPrimaryBrush}" CornerRadius="4" Padding="6,1"
                                                            IsVisible="{Binding IsDefault}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding $parent[ItemsControl].DataContext.L[default]}"
                                                                   FontSize="11" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Code}" Classes="caption" />
                                                <TextBlock Text="{Binding Barcodes, Converter={x:Static conv:StringJoinConverter.Instance}}"
                                                           Classes="caption" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="icon-sm" Margin="4,0"
                                                    Command="{Binding $parent[ItemsControl].DataContext.OpenVariantEditCommand}"
                                                    IsVisible="{Binding $parent[ItemsControl].DataContext.CanEdit}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                                                 Foreground="{DynamicResource TextSecondary}" />
                                            </Button>
                                            <Panel Grid.Column="2"
                                                   IsVisible="{Binding $parent[ItemsControl].DataContext.CanDeleteVariant}">
                                                <Button Classes="icon-sm" Margin="4,0" IsVisible="{Binding !IsDefault}"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DeleteVariantCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16"
                                                                     Foreground="{DynamicResource DangerBrush}" />
                                                </Button>
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <Border Background="#30000000" IsVisible="{Binding IsVariantEditOpen}" c:OverlayBehaviors.DismissCommand="{Binding CancelVariantEditCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="460" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    BoxShadow="0 18 50 0 #33000000" Padding="24">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding L[add_variant]}" Classes="h2" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L[variant_name]}" Classes="caption" />
                            <TextBox Text="{Binding VName, Mode=TwoWay}" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L[sku_code]}" Classes="caption" />
                            <TextBox Text="{Binding VCode, Mode=TwoWay}" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L[barcode]}" Classes="caption" />
                            <TextBox Text="{Binding VBarcodes, Mode=TwoWay}" MinHeight="40" PlaceholderText="4780000000001, 4780000000002*6, ..." />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding VHasAttributes}">
                            <TextBlock Text="{Binding L[attribute_values]}" Classes="caption" />
                            <ItemsControl ItemsSource="{Binding VAttributes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="4" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Display}" Classes="caption" />
                                            <TextBox Text="{Binding TextValue, Mode=TwoWay}" MinHeight="38" IsVisible="{Binding IsText}" />
                                            <NumericUpDown Value="{Binding NumberValue, Mode=TwoWay, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" MinHeight="38" IsVisible="{Binding IsNumber}" />
                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectValue, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" PlaceholderText="—" IsVisible="{Binding IsSelect}" />
                                            <ToggleSwitch IsChecked="{Binding BoolValue, Mode=TwoWay}" IsVisible="{Binding IsBool}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L[image]}" Classes="caption" />
                            <Grid ColumnDefinitions="Auto,12,*" VerticalAlignment="Center">
                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SidebarItemHover}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Image Source="{Binding VImagePreview}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <Button Classes="outline" HorizontalAlignment="Left"
                                            Command="{Binding PickVariantImageCommand}" Content="{Binding L[choose_image]}" />
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding VImageUrl}" PlaceholderText="{Binding L[image_url]}" />
                                        <Button Grid.Column="2" Classes="outline" VerticalAlignment="Stretch"
                                                Command="{Binding FetchImageCommand}" CommandParameter="variant"
                                                ToolTip.Tip="{Binding L[image_url]}">
                                            <mi:MaterialIcon Kind="Download" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                            <Button Grid.Column="1" Classes="outline" Margin="0,0,10,0" MinWidth="100"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding CancelVariantEditCommand}" Content="{Binding L[cancel]}" />
                            <Button Grid.Column="2" Classes="brand" MinWidth="120" HorizontalContentAlignment="Center"
                                    Command="{Binding SaveVariantCommand}" Content="{Binding L[save]}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <views:BarcodeLabelDialog DataContext="{Binding BarcodePrint}" />

        <views:ProductImportView DataContext="{Binding Import}" />
    </Panel>
</UserControl>
