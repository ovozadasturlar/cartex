<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Cartex.UI.ViewModels"
             x:Class="Cartex.UI.Views.TransactionDetailDialog"
             x:DataType="vm:TransactionDetailViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource CardBg}" CornerRadius="16" Width="520"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22"
            BoxShadow="0 24 80 0 #44000000">
        <StackPanel Spacing="18">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Operation}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding OccurredAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                               Classes="label" />
                </StackPanel>
                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4"
                        Cursor="Hand" Command="{Binding CloseCommand}" VerticalAlignment="Top">
                    <mi:MaterialIcon Kind="Close" Width="18" Height="18"
                                     Foreground="{DynamicResource TextMuted}" />
                </Button>
            </Grid>

            <Border Background="{DynamicResource AppBg}" CornerRadius="12" Padding="16"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding L[amount]}" Classes="label" />
                        <TextBlock Text="{Binding AmountText}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"
                                   IsVisible="{Binding !IsIncrease}" />
                        <TextBlock Text="{Binding AmountText}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   IsVisible="{Binding IsIncrease}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding L[balance]}" Classes="label" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding BalanceAfter, StringFormat='{}{0:N0}'}"
                                   FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding Currency}" Classes="label" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="3" IsVisible="{Binding HasDocumentNumber}">
                <TextBlock Text="{Binding L[document]}" Classes="label" />
                <TextBlock Text="{Binding DocumentNumber}" Classes="value" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" IsVisible="{Binding HasActions}">
                <Button Grid.Column="1" Classes="outline" MinHeight="42" Padding="16,0"
                        Command="{Binding OpenSaleCommand}" IsVisible="{Binding CanOpenSale}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="ReceiptTextOutline" Width="16" Height="16" />
                        <TextBlock Text="{Binding L[open_sale]}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="danger" MinHeight="42" Padding="16,0"
                        Command="{Binding VoidPaymentCommand}" IsVisible="{Binding CanVoidPayment}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="UndoVariant" Width="16" Height="16" />
                        <TextBlock Text="{Binding L[void_payment]}" />
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
