<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:cust="using:Cartex.Shared.Models.Customers"
             x:Class="Cartex.UI.Views.ConsolidatedActDialog"
             x:DataType="vm:ConsolidatedActViewModel"
             Width="820">

    <Border Background="{DynamicResource CardBg}" CornerRadius="14" Padding="22">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding L[consolidated_act]}" Classes="h2" />
                    <TextBlock Text="{Binding CustomerName}" Foreground="{DynamicResource TextSecondary}" FontSize="13" />
                </StackPanel>
                <Button Grid.Column="1" Classes="icon" Command="{Binding CloseCommand}" VerticalAlignment="Top">
                    <mi:MaterialIcon Kind="Close" Width="18" Height="18" />
                </Button>
            </Grid>

            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,14,0,0">
                <StackPanel Spacing="2" IsVisible="{Binding HasAct}">
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondary}">
                        <Run Text="{Binding L[consumed_goods]}" /><Run Text=": " />
                        <Run Text="{Binding Act.ConsumedAmount, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                        <Run Text="    " />
                        <Run Text="{Binding L[settled]}" /><Run Text=": " />
                        <Run Text="{Binding Act.PaidAmount, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}">
                        <Run Text="{Binding L[remaining_debt]}" /><Run Text=": " />
                        <Run Text="{Binding Act.RemainingDebt, StringFormat='{}{0:N0}'}" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Classes="outline" MinHeight="40" Padding="16,0"
                        Command="{Binding GenerateCommand}" IsEnabled="{Binding HasSelection}"
                        Content="{Binding L[generate]}" />
                <Button Grid.Column="2" Classes="brand" MinHeight="40" Padding="16,0"
                        Command="{Binding PrintCommand}" IsVisible="{Binding HasAct}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Printer" Width="16" Height="16" />
                        <TextBlock Text="{Binding L[print]}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid ColumnDefinitions="*,14,*" MaxHeight="420">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[documents]}" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[no_items]}" IsVisible="{Binding !HasDocuments}"
                               Foreground="{DynamicResource TextMuted}" FontSize="12.5" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Documents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActDocumentRow">
                                    <Border Background="{DynamicResource AppBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel Grid.Column="2" IsVisible="{Binding HasAct}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[consumed_goods]}" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,8" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="cust:ConsolidatedActLineDto">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding ProductName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="11">
                                                <Run Text="{Binding NetQuantity, StringFormat='{}{0:0.###}'}" />
                                                <Run Text="{Binding UnitName}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding NetAmount, StringFormat='{}{0:N0}'}"
                                                   FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
