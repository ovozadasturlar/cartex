<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:controls="using:Cartex.UI.Controls"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="Cartex.UI.Views.DesktopShell"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
        </Style>

        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
        </Style>
        <Style Selector="Button.nav-item.active">
            <Setter Property="Background" Value="{DynamicResource SidebarItemActive}" />
        </Style>

        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.menu-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
        </Style>

        <Style Selector="Border.popup">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #22000000" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                Width="{Binding IsSidebarCollapsed, Converter={x:Static conv:SidebarWidthConverter.Instance}}"
                ClipToBounds="True" Classes.blurred="{Binding IsShellOverlayOpen}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>

            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="16,18,12,14">
                    <controls:CxLogo
                           Width="{Binding IsSidebarCollapsed, Converter={x:Static conv:SidebarWidthConverter.LogoSize}}"
                           Height="{Binding IsSidebarCollapsed, Converter={x:Static conv:SidebarWidthConverter.LogoSize}}"
                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="CARTEX" FontSize="22" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrandPrimaryBrush}"
                               IsVisible="{Binding !IsSidebarCollapsed}" />
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,10" IsVisible="{Binding CanOpenSettings}">
                    <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="14,4,14,6" />
                    <Panel Margin="10,1">
                        <Button Classes="nav-item" Classes.active="{Binding IsSettingsActive}"
                                Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{Binding L[settings]}">
                            <Grid ColumnDefinitions="24,*">
                                <mi:MaterialIcon Kind="Cog" Width="20" Height="20" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding L[settings]}" FontSize="13.5"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{DynamicResource TextPrimary}"
                                           IsVisible="{Binding !IsSidebarCollapsed}" />
                            </Grid>
                        </Button>
                        <Border Width="3" CornerRadius="0,2,2,0" Background="{DynamicResource BrandPrimaryBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="-10,6"
                                IsVisible="{Binding IsSettingsActive}" />
                    </Panel>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,6">
                    <ItemsControl ItemsSource="{Binding MenuSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel IsVisible="{Binding IsVisible}" Margin="0,2,0,8">
                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}" Margin="22,6,0,4"
                                               IsVisible="{Binding !$parent[UserControl].DataContext.IsSidebarCollapsed}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Panel Margin="10,1" IsVisible="{Binding IsVisible}">
                                                    <Button Classes="nav-item" Classes.active="{Binding IsActive}"
                                                            Command="{Binding $parent[UserControl].DataContext.SelectMenuItemCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="{Binding Title}">
                                                        <Grid ColumnDefinitions="24,*">
                                                            <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20"
                                                                             Classes.nav-active="{Binding IsActive}"
                                                                             Foreground="{DynamicResource TextSecondary}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5"
                                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       IsVisible="{Binding !$parent[UserControl].DataContext.IsSidebarCollapsed}" />
                                                        </Grid>
                                                    </Button>
                                                    <Border Width="3" CornerRadius="0,2,2,0"
                                                            Background="{DynamicResource BrandPrimaryBrush}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                            Margin="-10,6" IsVisible="{Binding IsActive}" />
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Background="{DynamicResource AppBg}" Classes.blurred="{Binding IsShellOverlayOpen}">

            <Border DockPanel.Dock="Top" Background="#B45309" Padding="14,7"
                    IsVisible="{Binding !Connectivity.IsOnline}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <mi:MaterialIcon Kind="CloudOffOutline" Width="16" Height="16" Foreground="White" />
                    <TextBlock Text="{Binding L[offline_banner]}" Foreground="White" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="14,10">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">

                    <Button Grid.Column="0" Classes="icon" Command="{Binding ToggleSidebarCommand}"
                            AutomationProperties.Name="{Binding L[menu]}" ToolTip.Tip="{Binding L[menu]}">
                        <mi:MaterialIcon Kind="Menu" Width="20" Height="20"
                                         Foreground="{DynamicResource TextSecondary}" />
                    </Button>

                    <TextBox Grid.Column="1" x:Name="SearchBox" Width="300" Margin="10,0,0,0" MinHeight="36"
                             PlaceholderText="{Binding L[search]}" Text="{Binding NavFilter, Mode=TwoWay}">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0"
                                             Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <Button Grid.Column="2" HorizontalAlignment="Left" Margin="12,0,0,0"
                            Command="{Binding OpenPaletteCommand}"
                            Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,7" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="Ctrl+K" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                        <ComboBox ItemsSource="{Binding Branch.Branches}" SelectedItem="{Binding Branch.SelectedBranch}"
                                  MinWidth="130" VerticalAlignment="Center"
                                  IsVisible="{Binding Branch.HasMultipleBranches}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ComboBox ItemsSource="{Binding Branch.Warehouses}" SelectedItem="{Binding Branch.SelectedWarehouse}"
                                  MinWidth="150" VerticalAlignment="Center"
                                  IsVisible="{Binding Branch.HasMultipleWarehouses}"
                                  PlaceholderText="{Binding L[warehouse]}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Panel>
                            <Button Classes="icon" Command="{Binding ToggleThemePopupCommand}"
                                    AutomationProperties.Name="{Binding L[theme]}"
                                    ToolTip.Tip="{Binding L[theme]}">
                                <mi:MaterialIcon Kind="{Binding ThemeIcon}" Width="18" Height="18"
                                                 Foreground="{DynamicResource TextSecondary}" />
                            </Button>
                            <Popup IsOpen="{Binding IsThemePopupOpen, Mode=TwoWay}"
                                   Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True">
                                <Border Classes="popup">
                                    <StackPanel Spacing="2">
                                        <Button Classes="menu-item" Command="{Binding SelectThemeCommand}" CommandParameter="Light">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="WeatherSunny" Width="18" Height="18" />
                                                <TextBlock Text="{Binding L[light]}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="menu-item" Command="{Binding SelectThemeCommand}" CommandParameter="Dark">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="WeatherNight" Width="18" Height="18" />
                                                <TextBlock Text="{Binding L[dark]}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Panel>

                        <Panel>
                            <Button Classes="icon" Command="{Binding ToggleLanguagePopupCommand}"
                                    AutomationProperties.Name="{Binding L[language]}"
                                    ToolTip.Tip="{Binding L[language]}">
                                <Border Background="{DynamicResource SidebarItemHover}" CornerRadius="4" Padding="6,3">
                                    <TextBlock Text="{Binding CurrentLanguageFlag}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                            </Button>
                            <Popup IsOpen="{Binding IsLanguagePopupOpen, Mode=TwoWay}"
                                   Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True">
                                <Border Classes="popup" MinWidth="200">
                                    <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="menu-item"
                                                        Command="{Binding $parent[UserControl].DataContext.SelectLanguageCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Border Background="{DynamicResource SidebarItemHover}" CornerRadius="4" Padding="6,3">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageFlagConverter.Instance}}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimary}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageDisplayConverter.Instance}}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Panel>

                        <Panel>
                            <Button Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand"
                                    CornerRadius="8" Command="{Binding ToggleUserMenuCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{DynamicResource BrandPrimaryBrush}">
                                        <TextBlock Text="{Binding UserInitial}" Foreground="White" FontWeight="SemiBold"
                                                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding UserDisplayName}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                    <mi:MaterialIcon Kind="ChevronDown" Width="16" Height="16"
                                                     Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Button>
                            <Popup IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}"
                                   Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True">
                                <Border Classes="popup" MinWidth="220">
                                    <StackPanel Spacing="2">
                                        <StackPanel Margin="12,8,12,8">
                                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding UserRole}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                        <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="4,2" />
                                        <Button Classes="menu-item" Command="{Binding LogoutCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="Logout" Width="18" Height="18"
                                                                 Foreground="{DynamicResource DangerBrush}" />
                                                <TextBlock Text="{Binding L[logout]}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Panel>

                    </StackPanel>
                </Grid>
            </Border>

            <Panel>
                <TransitioningContentControl Content="{Binding CurrentPage}"
                                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.18" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>

                <ProgressBar IsVisible="{Binding Busy.IsPageBusy}" IsIndeterminate="True"
                             VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="3"
                             MinWidth="0" CornerRadius="0" IsHitTestVisible="False" />

                <Border IsVisible="{Binding Busy.IsBusy}" Background="#30000000" IsHitTestVisible="False">
                    <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="26,22"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="14" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="190" />
                            <TextBlock Text="{Binding Busy.Message}" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>
            </Panel>

        </DockPanel>

        <Border Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsPaletteOpen}"
                Background="#30000000"
                controls:OverlayBehaviors.DismissCommand="{Binding ClosePaletteCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Width="580" MaxHeight="460"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,100,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    BoxShadow="0 18 50 0 #44000000">
                <DockPanel Margin="8">
                    <TextBox DockPanel.Dock="Top" x:Name="PaletteInput" Margin="4,4,4,8"
                             Text="{Binding PaletteQuery, Mode=TwoWay}" PlaceholderText="{Binding L[search]}"
                             MinHeight="46" FontSize="15">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="10,0,0,0"
                                             Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <ListBox ItemsSource="{Binding PaletteResults}" SelectedItem="{Binding SelectedPaletteItem}"
                             DoubleTapped="OnPaletteItemActivated"
                             MaxHeight="380" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="2">
                                    <mi:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18"
                                                     Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsShortcutHelpOpen}"
                Background="#30000000"
                controls:OverlayBehaviors.DismissCommand="{Binding ToggleShortcutHelpCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Width="440" MaxHeight="540"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    BoxShadow="0 18 50 0 #44000000" Padding="22">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[shortcuts_title]}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding ShortcutHelpRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="112,*" Margin="0,4">
                                        <Border Background="{DynamicResource AppBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Gesture}" FontSize="12" FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextSecondary}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsOnboardingOpen}"
                Background="#30000000">
            <ContentControl Content="{Binding Onboarding}" />
        </Border>

        <u:OverlayDialogHost Grid.Column="0" Grid.ColumnSpan="2" />

    </Grid>
</UserControl>
