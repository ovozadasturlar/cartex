<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:stocks="using:Cartex.Shared.Models.Stocks"
             x:Class="Cartex.UI.Views.GoodsIssueDialog"
             x:DataType="vm:GoodsIssueViewModel"
             x:CompileBindings="True">
    <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="720" MaxHeight="700"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            BoxShadow="0 18 50 0 #33000000" Padding="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding L[tc_issue]}" Classes="h2" Margin="0,0,0,16" />

            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Total, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontSize="16"
                               Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Currency}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="outline" Command="{Binding CancelCommand}" Content="{Binding L[cancel]}" />
                    <Button Classes="brand" Command="{Binding SubmitCommand}" Content="{Binding L[tc_issue]}"
                            IsEnabled="{Binding HasLines}" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                    <TextBox Text="{Binding ProductSearch, Mode=TwoWay}" PlaceholderText="{Binding L[search]}" MinHeight="40">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0"
                                             Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Border Background="{DynamicResource AppBg}" CornerRadius="10" MaxHeight="160"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            IsVisible="{Binding HasResults}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding ProductResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="stocks:StockOnHandDto">
                                        <Button Background="Transparent" BorderThickness="0" Padding="12,9" Cursor="Hand"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Command="{Binding $parent[ItemsControl].((vm:GoodsIssueViewModel)DataContext).AddProductCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding UnitName}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Text="{Binding Quantity, StringFormat='{}{0:0.###}'}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                                           Text="{Binding SellingPrice, StringFormat='{}{0:N0}'}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <Border Background="{DynamicResource AppBg}" CornerRadius="10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,90,110,100,36" Background="{DynamicResource SidebarItemHover}">
                            <TextBlock Text="{Binding L[product]}" FontWeight="SemiBold" Padding="12,8" />
                            <TextBlock Grid.Column="1" Text="{Binding L[quantity]}" FontWeight="SemiBold" Padding="8" />
                            <TextBlock Grid.Column="2" Text="{Binding L[price]}" FontWeight="SemiBold" Padding="8" />
                            <TextBlock Grid.Column="3" Text="{Binding L[amount]}" FontWeight="SemiBold" Padding="8" />
                            <Panel Grid.Column="4" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="280">
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GoodsIssueLineRow">
                                        <Grid ColumnDefinitions="*,90,110,100,36" MinHeight="46">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,6,8,6" Spacing="2">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding UnitName}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                               Text="{Binding Stock, StringFormat='• {0:0.###}'}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Margin="4"
                                                           Value="{Binding Quantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                                           Minimum="0" Increment="1" FormatString="{Binding QtyFormat}"
                                                           ShowButtonSpinner="False" />
                                            <NumericUpDown Grid.Column="2" VerticalAlignment="Center" Margin="4"
                                                           Value="{Binding UnitPrice, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                                           Minimum="0" Increment="1" FormatString="N0"
                                                           ShowButtonSpinner="False" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Padding="8"
                                                       TextAlignment="Right" FontWeight="SemiBold"
                                                       Text="{Binding LineTotal, StringFormat='{}{0:N0}'}" />
                                            <Button Grid.Column="4" Classes="icon" VerticalAlignment="Center" Margin="0,0,4,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:GoodsIssueViewModel)DataContext).RemoveLineCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Close" Width="15" Height="15" Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
