<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:il="using:AsyncImageLoader"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:products="using:Cartex.Shared.Models.Products"
             x:Class="Cartex.UI.Views.BarcodePrintView"
             x:DataType="vm:BarcodePrintViewModel"
             c:Shortcuts.Source="{Binding Shortcuts}">

    <UserControl.Styles>
        <Style Selector="ListBox#ChipsList ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="ListBox#ChipsList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="24">
        <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[barcode_print]}" Margin="0,0,0,16" />

        <Grid ColumnDefinitions="400,24,Auto">
            <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="14" Padding="16"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Text="{Binding Search}" MinHeight="42" Margin="0,0,0,12"
                             PlaceholderText="{Binding L[search_product_hint]}">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="10,0,0,0"
                                             Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}" Margin="0,12,0,0" />
                    <ListBox x:Name="ProductsList" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="products:ProductDto">
                                <Grid ColumnDefinitions="44,10,*" Margin="2,5">
                                    <Border Width="44" Height="44" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource AppBg}">
                                        <Grid>
                                            <mi:MaterialIcon Kind="PackageVariant" Width="20" Height="20" HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                            <Image il:ImageLoader.Source="{Binding ImageUrl, Converter={x:Static conv:ThumbImageUrlConverter.Instance}}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}">
                                            <Run Text="{Binding Barcodes.Count}" /><Run Text=" " /><Run Text="{Binding [barcode_count_label], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Panel Grid.Column="2">
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding HasSelection}">
                    <Grid RowDefinitions="Auto,16,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="184,20,Auto">
                            <Border Width="184" Height="184" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Center"
                                    Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <mi:MaterialIcon Kind="ImageOutline" Width="44" Height="44" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                    <Image il:ImageLoader.Source="{Binding SelectedProductImageUrl, Converter={x:Static conv:ThumbImageUrlConverter.Instance}}"
                                           Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <Grid Grid.Column="2" MaxWidth="320" RowDefinitions="Auto,2,Auto,10,44,10,Auto,10,128">
                                <TextBlock Text="{Binding SelectedProductName}" FontSize="18" FontWeight="Bold" MaxHeight="46"
                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,8,Auto">
                                    <TextBlock Text="{Binding SelectedProductUnitName}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontSize="12"
                                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                                </Grid>
                                <ListBox x:Name="ChipsList" Grid.Row="4" ItemsSource="{Binding BarcodeOptions}" SelectedItem="{Binding SelectedBarcode}"
                                         IsVisible="{Binding HasBarcodes}" Background="Transparent" BorderThickness="0" Padding="0" Height="44"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding FocusQuantityCommand}" />
                                    </ListBox.KeyBindings>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BarcodeChoice">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Code}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="4" Text="{Binding L[no_barcode_hint]}" IsVisible="{Binding !HasBarcodes}"
                                           Foreground="{DynamicResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" />
                                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding L[label_default_with_price]}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    <ToggleSwitch IsChecked="{Binding PrintWithPrice}" IsEnabled="{Binding CanOverridePrice}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding L[label_show_sku]}" FontSize="12" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    <ToggleSwitch IsChecked="{Binding PrintWithSku}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Image Grid.Row="8" Source="{Binding Preview}" Height="128" HorizontalAlignment="Center"
                                       Stretch="Uniform" IsVisible="{Binding HasCode}" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,6,Auto,6,Auto,*,Auto,10,Auto">
                            <Button Classes="outline" Width="38" Height="38" Padding="0" Command="{Binding DecrementCommand}">
                                <mi:MaterialIcon Kind="Minus" Width="18" Height="18" />
                            </Button>
                            <NumericUpDown x:Name="QuantityBox" Grid.Column="2"
                                           Value="{Binding Quantity, Converter={x:Static conv:EmptyKeepsValueConverter.Instance}}"
                                           Minimum="1" Increment="1" FormatString="0" Width="86" Height="38"
                                           ShowButtonSpinner="False" HorizontalContentAlignment="Center">
                                <NumericUpDown.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding RequestPrintCommand}" />
                                </NumericUpDown.KeyBindings>
                            </NumericUpDown>
                            <Button Grid.Column="4" Classes="outline" Width="38" Height="38" Padding="0" Command="{Binding IncrementCommand}">
                                <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            </Button>
                            <Button Grid.Column="6" Classes="outline" MinWidth="108" HorizontalContentAlignment="Center"
                                    Command="{Binding ClearSelectionCommand}" Content="{Binding L[cancel]}" />
                            <Button x:Name="PrintButton" Grid.Column="8" Classes="brand" Command="{Binding PrintCommand}" MinHeight="38" MinWidth="136"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="Printer" Width="18" Height="18" />
                                    <TextBlock Text="{Binding L[print]}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding !HasSelection}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="BarcodeScan" Width="52" Height="52" Foreground="{DynamicResource TextMuted}"
                                         HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding L[search_product_hint]}" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Panel>
        </Grid>
    </DockPanel>
</UserControl>
