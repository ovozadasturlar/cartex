<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:il="using:AsyncImageLoader"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:svc="using:Cartex.UI.Services"
             x:Class="Cartex.UI.Views.BarcodePrintView"
             x:CompileBindings="False"
             c:Shortcuts.Source="{Binding Shortcuts}">

    <UserControl.Styles>
        <Style Selector="ListBox#ChipsList ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="ListBox#ChipsList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="24">
        <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[barcode_print]}" Margin="0,0,0,16" />

        <Grid ColumnDefinitions="360,16,*" MaxWidth="980" HorizontalAlignment="Left">

            <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Text="{Binding Search}" MinHeight="40" Margin="0,0,0,10"
                             PlaceholderText="{Binding L[search_product_hint]}">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0"
                                             Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}" Margin="0,10,0,0" />
                    <ListBox x:Name="ProductsList" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}">
                                        <Run Text="{Binding Barcodes.Count}" /><Run Text=" " /><Run Text="{Binding [barcode_count_label], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Panel Grid.Column="2">
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="22" VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding HasSelection}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,16,*">
                            <Border Width="132" Height="132" CornerRadius="12" ClipToBounds="True"
                                    Background="{DynamicResource AppBg}" VerticalAlignment="Top">
                                <Panel>
                                    <mi:MaterialIcon Kind="ImageOutline" Width="36" Height="36"
                                                     Foreground="{DynamicResource TextMuted}" />
                                    <Image il:ImageLoader.Source="{Binding SelectedProduct.ImageUrl, Converter={x:Static conv:ThumbImageUrlConverter.Instance}}"
                                           Stretch="UniformToFill" />
                                </Panel>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding SelectedProduct.Name}" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Spacing="7">
                            <TextBlock Text="{Binding L[barcode]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ListBox x:Name="ChipsList" ItemsSource="{Binding BarcodeOptions}"
                                     SelectedItem="{Binding SelectedBarcode}"
                                     IsVisible="{Binding HasBarcodes}"
                                     Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding FocusQuantityCommand}" />
                                </ListBox.KeyBindings>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Code}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding L[no_barcode_hint]}" IsVisible="{Binding !HasBarcodes}"
                                       Foreground="{DynamicResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="White" CornerRadius="12" Padding="20" MinHeight="150"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                IsVisible="{Binding HasCode}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedProduct.Name}" Foreground="Black" FontWeight="SemiBold"
                                           FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Text="{Binding SelectedBarcode.Display}" Foreground="Black" FontSize="11.5"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding SelectedBarcode.IsPack, FallbackValue=False}" />
                                <Image Source="{Binding Preview}" Height="96" Stretch="Uniform" />
                                <TextBlock Text="{Binding CurrentCode}" Foreground="Black" FontFamily="Consolas" FontSize="13.5"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="Auto,16,Auto" VerticalAlignment="Bottom">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="{Binding L[quantity]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="outline" Width="40" Height="40" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Command="{Binding DecrementCommand}">
                                        <mi:MaterialIcon Kind="Minus" Width="16" Height="16" />
                                    </Button>
                                    <NumericUpDown x:Name="QuantityBox" Value="{Binding Quantity, Converter={x:Static conv:EmptyKeepsValueConverter.Instance}}"
                                                   Minimum="1" Increment="1" FormatString="0" Width="90" Height="40"
                                                   ShowButtonSpinner="False" HorizontalContentAlignment="Center">
                                        <NumericUpDown.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding PrintCommand}" />
                                        </NumericUpDown.KeyBindings>
                                    </NumericUpDown>
                                    <Button Classes="outline" Width="40" Height="40" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Command="{Binding IncrementCommand}">
                                        <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Bottom">
                                <TextBlock Text=" " FontSize="12.5" />
                                <Button x:Name="PrintButton" Classes="brand" Command="{Binding PrintCommand}" MinHeight="42" MinWidth="170"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <mi:MaterialIcon Kind="Printer" Width="18" Height="18" />
                                        <TextBlock Text="{Binding L[print]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="PrinterOutline" Width="14" Height="14"
                                             Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PrinterInfo}" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding L[barcode_printer_hint]}" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="40" VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding !HasSelection}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="BarcodeScan" Width="42" Height="42" Foreground="{DynamicResource TextMuted}"
                                         HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding L[search_product_hint]}" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Panel>
        </Grid>
    </DockPanel>
</UserControl>
