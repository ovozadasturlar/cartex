<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.SettingsView"
             x:CompileBindings="False">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

            <c:PageHeader Title="{Binding L[app_settings]}" Subtitle="{Binding L[appearance]}" />

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding L[appearance]}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding L[dark_theme]}" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding L[theme]}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkTheme}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding L[language]}" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="200" SelectedItem="{Binding SelectedLanguage}"
                                  ItemsSource="{Binding AvailableLanguages}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageDisplayConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding L[api_url]}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimary}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding ApiUrl}" Width="380" MinHeight="38"
                                 PlaceholderText="{Binding L[api_url]}" />
                        <Button Classes="brand" Command="{Binding SaveApiUrlCommand}" Content="{Binding L[save]}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    IsVisible="{Binding ServerQr, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding L[server_qr]}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding L[server_qr_hint]}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}" />
                    <Border Width="180" Height="180" Background="White" CornerRadius="8" Padding="8"
                            HorizontalAlignment="Left">
                        <Image Source="{Binding ServerQr}" />
                    </Border>
                    <TextBlock Text="{Binding ServerQrUrl}" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    IsVisible="{Binding OfflineVisible}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding L[offline_cache]}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding L[offline_cache_hint]}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[offline_profile]}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <CheckBox IsChecked="{Binding OfflineAllowSales}" Content="{Binding L[offline_profile_sales]}" />
                            <CheckBox IsChecked="{Binding OfflineAllowPayments}" Content="{Binding L[offline_profile_payments]}" />
                            <CheckBox IsChecked="{Binding OfflineAllowSupplies}" Content="{Binding L[offline_profile_supplies]}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding OfflineHolderText}" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanEnableOffline}">
                        <ComboBox MinWidth="220" ItemsSource="{Binding OfflineWarehouses}"
                                  SelectedItem="{Binding SelectedOfflineWarehouse}"
                                  PlaceholderText="{Binding L[offline_cache_warehouse]}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="brand" Command="{Binding ToggleOfflineCommand}" Content="{Binding L[offline_cache_enable]}" />
                    </StackPanel>
                    <Button Classes="danger" Command="{Binding ReleaseRemoteOfflineCommand}"
                            Content="{Binding L[offline_cache_release_remote]}" IsVisible="{Binding OfflineAssignedElsewhere}"
                            HorizontalAlignment="Left" />
                    <StackPanel Spacing="10" IsVisible="{Binding OfflineEnabled}">
                        <TextBlock Text="{Binding OfflineSyncText}" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding L[hub_enable]}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding HubStatusText}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HubEnabled}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="8"
                                    IsVisible="{Binding HubQr, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding L[hub_qr]}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding L[hub_qr_hint]}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}" />
                            <Border Width="180" Height="180" Background="White" CornerRadius="8" Padding="8"
                                    HorizontalAlignment="Left">
                                <Image Source="{Binding HubQr}" />
                            </Border>
                            <TextBlock Text="{Binding HubQrUrl}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <Button Classes="danger" Command="{Binding ToggleOfflineCommand}"
                                Content="{Binding L[disconnect]}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding QueueRows}" IsVisible="{Binding HasQueueRows}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None"
                              CanUserResizeColumns="False" CanUserSortColumns="False" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="4,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding KindText}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding When}" FontSize="12"
                                                           Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock Text="{Binding Details}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Error}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="#DC2626" IsVisible="{Binding IsError}" />
                                            <TextBlock Text="{Binding Warning}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="#D97706"
                                                       IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="icon" IsVisible="{Binding CanAct}"
                                                    Command="{Binding $parent[DataGrid].DataContext.RetryQueueRowCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[offline_retry]}">
                                                <mi:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                                            </Button>
                                            <Button Classes="icon" IsVisible="{Binding CanAct}"
                                                    Command="{Binding $parent[DataGrid].DataContext.DiscardQueueRowCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[offline_discard]}">
                                                <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                                            </Button>
                                            <Button Classes="icon" IsVisible="{Binding CanCancel}"
                                                    Command="{Binding $parent[DataGrid].DataContext.CancelQueueRowCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[offline_cancel]}">
                                                <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="outline" Command="{Binding ExportQueueCommand}"
                                Content="{Binding L[offline_export]}" IsVisible="{Binding HasQueueRows}" />
                        <Button Classes="outline" Command="{Binding ImportQueueCommand}"
                                Content="{Binding L[offline_import]}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
