<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:sales="using:Cartex.Shared.Models.Sales"
             x:Class="Cartex.UI.Views.SalesHistoryView"
             x:CompileBindings="False">

    <Panel>
        <DockPanel Margin="24" Classes.blurred="{Binding IsModalOpen}">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[sale_history]}" Margin="0,0,0,16">
                <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
            </c:PageHeader>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,0,0,16">
                <TextBlock Text="{Binding L[date_from]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,16,0" />
                <TextBlock Grid.Column="2" Text="{Binding L[date_to]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="3" SelectedDate="{Binding DateTo, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,0,0" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <ComboBox MinWidth="130" VerticalAlignment="Center"
                              ItemsSource="{Binding Paging.SortOptions}" SelectedItem="{Binding Paging.SelectedSort}" />
                    <Button Classes="icon" Command="{Binding Paging.ToggleDirectionCommand}" ToolTip.Tip="{Binding L[sort]}">
                        <Panel>
                            <mi:MaterialIcon Kind="SortAscending" Width="18" Height="18" IsVisible="{Binding !Paging.Descending}" />
                            <mi:MaterialIcon Kind="SortDescending" Width="18" Height="18" IsVisible="{Binding Paging.Descending}" />
                        </Panel>
                    </Button>
                    <Button Classes="brand" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" />
                            <TextBlock Text="{Binding L[refresh]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding Totals.TotalAmount, StringFormat='{}{0:N0}'}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding L[discount]}" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding Totals.TotalDiscount, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding L[debt]}" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding Totals.TotalDebt, StringFormat='{}{0:N0}'}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                </StackPanel>
            </c:Pager>

            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              c:GridDoubleClick.Command="{Binding OpenReceiptCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="Auto" Binding="{Binding SaleDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                Header="{Binding [sale_date], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding TotalAmount, Mode=OneWay, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding PaidCash, Mode=OneWay, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [cash], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding PaidCard, Mode=OneWay, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [card], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding DebtAmount, Mode=OneWay, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [debt], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding Status}"
                                                Header="{Binding [status], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding CustomerName}"
                                                Header="{Binding [customer], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding UserName}"
                                                Header="{Binding [sold_by], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="icon" Margin="6,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.OpenReceiptCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[receipt]}">
                                                <mi:MaterialIcon Kind="ReceiptTextOutline" Width="17" Height="17"
                                                                 Foreground="{DynamicResource BrandPrimaryBrush}" />
                                            </Button>
                                            <Button Classes="icon" Margin="6,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.ReturnSaleCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[return]}"
                                                    IsVisible="{Binding Status, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter='Completed,PartialReturn'}">
                                                <mi:MaterialIcon Kind="UndoVariant" Width="17" Height="17"
                                                                 Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="ReceiptTextOutline" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
            </Panel>
        </DockPanel>

        <!-- ===== RECEIPT DIALOG (horizontal 2-column) ===== -->
        <Border IsVisible="{Binding IsReceiptOpen}" Background="#44000000"
                c:OverlayBehaviors.DismissCommand="{Binding CloseReceiptCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="16" Width="740" MinHeight="530" MaxHeight="600"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 24 80 0 #44000000">
                <DockPanel>

                    <!-- Action buttons at bottom -->
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,10,Auto,10,Auto" Margin="24,14">
                        <Button Grid.Column="0" Classes="brand" HorizontalAlignment="Stretch"
                                Command="{Binding CloseReceiptCommand}" Content="{Binding L[close]}" />
                        <Button Grid.Column="2" Classes="outline" Command="{Binding PrintReceiptCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <mi:MaterialIcon Kind="Printer" Width="16" Height="16" />
                                <TextBlock Text="{Binding L[print]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Classes="outline" Command="{Binding ResendReceiptCommand}"
                                IsVisible="{Binding CanResendReceipt}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <mi:MaterialIcon Kind="SendOutline" Width="16" Height="16" />
                                <TextBlock Text="{Binding L[resend_receipt]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Thin separator -->
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- 2-column body -->
                    <Grid ColumnDefinitions="290,1,*">

                        <!-- LEFT PANEL: company + totals + QR -->
                        <ScrollViewer Grid.Column="0" Padding="20">
                            <StackPanel Spacing="14" DataContext="{Binding Receipt}">

                                <!-- Business badge -->
                                <Border Background="{DynamicResource SidebarItemActive}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding BusinessName}" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BranchName}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        <TextBlock Text="{Binding BranchAddress}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   IsVisible="{Binding BranchAddress, Converter={x:Static conv:NullToBoolConverter.Instance}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Meta rows -->
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding [sale_date], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SaleDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding [cashier], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding CustomerName, Converter={x:Static conv:NullToBoolConverter.Instance}}">
                                        <TextBlock Text="{Binding [customer], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                                <!-- Totals -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}"
                                                   FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding DiscountAmount, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [discount], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding PaidCash, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [cash], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PaidCash, StringFormat='{}{0:N0}'}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding PaidCard, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [card], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PaidCard, StringFormat='{}{0:N0}'}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding PaidBonus, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [bonus], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PaidBonus, StringFormat='{}{0:N0}'}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding DebtAmount, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [debt], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource DangerBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DebtAmount, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding CashbackEarned, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [cashback_earned], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CashbackEarned, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{DynamicResource SuccessBrush}" />
                                    </Grid>
                                </StackPanel>

                                <!-- QR Code -->
                                <Border Background="{DynamicResource AppBg}" CornerRadius="10" Padding="12"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding $parent[UserControl].DataContext.ReceiptQrCode, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <Image Source="{Binding $parent[UserControl].DataContext.ReceiptQrCode}" Width="120" Height="120"
                                               HorizontalAlignment="Center" Stretch="Uniform" />
                                        <TextBlock Text="{Binding ReceiptToken}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                                   MaxWidth="180" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Vertical divider -->
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

                        <!-- RIGHT PANEL: products list -->
                        <DockPanel Grid.Column="2">
                            <!-- Header row -->
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,70,80,90"
                                  Background="{DynamicResource SidebarItemHover}">
                                <TextBlock Grid.Column="0" Text="{Binding [product], Source={x:Static svc:LocalizationManager.Instance}}"
                                           Padding="20,10,8,10" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding [quantity], Source={x:Static svc:LocalizationManager.Instance}}"
                                           Padding="8,10" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Grid.Column="2" Text="{Binding [price], Source={x:Static svc:LocalizationManager.Instance}}"
                                           Padding="8,10" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Grid.Column="3" Text="{Binding [amount], Source={x:Static svc:LocalizationManager.Instance}}"
                                           Padding="8,10,20,10" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Grid>

                            <!-- Items -->
                            <ScrollViewer DataContext="{Binding Receipt}">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sales:ReceiptItemDto">
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="*,70,80,90" MinHeight="46">
                                                    <StackPanel Grid.Column="0" Margin="20,10,8,10" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding UnitName}" FontSize="11"
                                                                   Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0:0.###}'}"
                                                               VerticalAlignment="Center" Padding="8" TextAlignment="Right"
                                                               FontSize="13" />
                                                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='{}{0:N0}'}"
                                                               VerticalAlignment="Center" Padding="8" TextAlignment="Right"
                                                               FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat='{}{0:N0}'}"
                                                               VerticalAlignment="Center" Padding="8,8,20,8" TextAlignment="Right"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- ===== RETURN DIALOG ===== -->
        <Border IsVisible="{Binding IsReturnOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CloseReturnCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="480" MaxHeight="660"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="24">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[return]}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Command="{Binding CloseReturnCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="danger" Command="{Binding ConfirmReturnCommand}" Content="{Binding L[confirm]}" />
                    </StackPanel>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding ReturnLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding [remaining], Source={x:Static svc:LocalizationManager.Instance}}"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                    <TextBlock Text="{Binding Remaining, StringFormat='{}{0:0.###}'}"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <NumericUpDown Value="{Binding Quantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Maximum="{Binding Remaining}"
                                                               Increment="1" Width="140" />
                                                <CheckBox Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding Restock}"
                                                          Content="{Binding [restock], Source={x:Static svc:LocalizationManager.Instance}}" />
                                            </Grid>
                                            <TextBox Text="{Binding Reason}"
                                                     PlaceholderText="{Binding [reason], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
