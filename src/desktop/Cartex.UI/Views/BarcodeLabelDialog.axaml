<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:il="using:AsyncImageLoader"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:vm="using:Cartex.UI.ViewModels"
             x:Class="Cartex.UI.Views.BarcodeLabelDialog"
             x:DataType="vm:BarcodeLabelSession">

    <UserControl.Styles>
        <Style Selector="ListBox#BarcodeChoices ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="ListBox#BarcodeChoices ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <Border Background="#30000000" IsVisible="{Binding IsOpen}"
            c:OverlayBehaviors.DismissCommand="{Binding CancelCommand}">
        <Border Classes="form" Background="{DynamicResource CardBg}" CornerRadius="14" MaxWidth="640" MaxHeight="560" Margin="20" Padding="16"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 18 50 0 #33000000">
            <Border.KeyBindings>
                <KeyBinding Gesture="Ctrl+Enter" Command="{Binding PrintCommand}" />
            </Border.KeyBindings>
            <Grid RowDefinitions="Auto,16,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="200,20,Auto">
                    <Border Width="200" Height="200" CornerRadius="12" ClipToBounds="True"
                            Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <mi:MaterialIcon Kind="PackageVariant" Width="48" Height="48" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                            <Image il:ImageLoader.Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                <Grid Grid.Column="2" MaxWidth="320" RowDefinitions="Auto,2,Auto,10,44,10,Auto,10,128">
                    <TextBlock Text="{Binding ProductName}" FontSize="18" FontWeight="Bold" MaxHeight="46"
                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,8,Auto">
                        <TextBlock Text="{Binding UnitName}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontSize="12"
                                   Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </Grid>

                    <ListBox x:Name="BarcodeChoices" Grid.Row="4" ItemsSource="{Binding Barcodes}" SelectedItem="{Binding SelectedBarcode}"
                             Background="Transparent" BorderThickness="0" Padding="0" Height="44"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding FocusQuantityCommand}" />
                                </ListBox.KeyBindings>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BarcodeLabelChoice">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Code}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding [print_with_price], Source={x:Static svc:LocalizationManager.Instance}}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <ToggleSwitch IsChecked="{Binding PrintWithPrice}" IsEnabled="{Binding CanOverridePrice}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Image Grid.Row="8" Source="{Binding Preview}" Height="128" HorizontalAlignment="Center"
                           Stretch="Uniform" IsVisible="{Binding Code, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                </Grid>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,6,Auto,6,Auto,*,Auto,10,Auto">
                    <Button Classes="outline" Width="38" Height="38" Padding="0" Command="{Binding DecrementCommand}">
                        <mi:MaterialIcon Kind="Minus" Width="18" Height="18" />
                    </Button>
                    <NumericUpDown x:Name="QuantityBox" Grid.Column="2"
                                   Value="{Binding Quantity, Converter={x:Static conv:EmptyKeepsValueConverter.Instance}}"
                                   Minimum="1" Increment="1" FormatString="0" Width="86" Height="38"
                                   ShowButtonSpinner="False" HorizontalContentAlignment="Center">
                        <NumericUpDown.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding PrintCommand}" />
                        </NumericUpDown.KeyBindings>
                    </NumericUpDown>
                    <Button Grid.Column="4" Classes="outline" Width="38" Height="38" Padding="0" Command="{Binding IncrementCommand}">
                        <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                    </Button>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="10">
                        <Button Classes="outline" MinWidth="108" HorizontalContentAlignment="Center"
                                Command="{Binding CancelCommand}"
                                Content="{Binding [cancel], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <Button Classes="brand" MinWidth="136" HorizontalContentAlignment="Center"
                                Command="{Binding PrintCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Printer" Width="18" Height="18" />
                                <TextBlock Text="{Binding [print], Source={x:Static svc:LocalizationManager.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
