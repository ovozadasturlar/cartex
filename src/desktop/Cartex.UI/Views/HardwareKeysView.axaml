<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             x:Class="Cartex.UI.Views.HardwareKeysView"
             x:CompileBindings="False">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <c:PageHeader Title="{Binding L[hardware_keys]}" />

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[user]}" Classes="caption" />
                        <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  HorizontalAlignment="Stretch" MinHeight="42">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[usb_drive]}" Classes="caption" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding DetectDriveCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="Usb" Width="18" Height="18" />
                                    <TextBlock Text="{Binding L[detect_drive]}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding DriveInfo}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Classes="brand" Command="{Binding IssueKeyCommand}"
                            Content="{Binding L[issue_key]}" HorizontalAlignment="Left" Margin="0,4,0,0" />

                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding L[issued_keys]}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />

                    <ItemsControl ItemsSource="{Binding KeyGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBg}" CornerRadius="10" Padding="14,10"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                            <mi:MaterialIcon Kind="Usb" Width="15" Height="15" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="{Binding Serial}" FontFamily="Consolas" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding $parent[UserControl].DataContext.L[key_group_drive]}"
                                                       Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                                        <Grid ColumnDefinitions="*,110,110,96">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" />
                                                                <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding IssuedAt, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                                       Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                                            <Panel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <Border Background="#22DC2626" CornerRadius="10" Padding="9,3"
                                                                        IsVisible="{Binding RevokedAt, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                    <TextBlock Text="{Binding $parent[UserControl].DataContext.L[revoked]}"
                                                                               Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="SemiBold" />
                                                                </Border>
                                                                <Panel IsVisible="{Binding RevokedAt, Converter={x:Static ObjectConverters.IsNull}}">
                                                                    <Border Background="#2216A34A" CornerRadius="10" Padding="9,3" IsVisible="{Binding IsEnabled}">
                                                                        <TextBlock Text="{Binding $parent[UserControl].DataContext.L[key_active]}"
                                                                                   Foreground="{DynamicResource BrandPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <Border Background="#22F59E0B" CornerRadius="10" Padding="9,3" IsVisible="{Binding !IsEnabled}">
                                                                        <TextBlock Text="{Binding $parent[UserControl].DataContext.L[key_disabled]}"
                                                                                   Foreground="#B45309" FontSize="11" FontWeight="SemiBold" />
                                                                    </Border>
                                                                </Panel>
                                                            </Panel>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                                                                        IsVisible="{Binding RevokedAt, Converter={x:Static ObjectConverters.IsNull}}">
                                                                <Button Classes="icon" IsVisible="{Binding IsEnabled}"
                                                                        Command="{Binding $parent[UserControl].DataContext.ToggleKeyCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding $parent[UserControl].DataContext.L[key_disable]}">
                                                                    <mi:MaterialIcon Kind="PauseCircleOutline" Width="16" Height="16" Foreground="#B45309" />
                                                                </Button>
                                                                <Button Classes="icon" IsVisible="{Binding !IsEnabled}"
                                                                        Command="{Binding $parent[UserControl].DataContext.ToggleKeyCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding $parent[UserControl].DataContext.L[key_enable]}">
                                                                    <mi:MaterialIcon Kind="PlayCircleOutline" Width="16" Height="16" Foreground="{DynamicResource BrandPrimaryBrush}" />
                                                                </Button>
                                                                <Button Classes="icon"
                                                                        Command="{Binding $parent[UserControl].DataContext.RevokeKeyCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding $parent[UserControl].DataContext.L[revoke]}">
                                                                    <mi:MaterialIcon Kind="Close" Width="15" Height="15" Foreground="{DynamicResource DangerBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
