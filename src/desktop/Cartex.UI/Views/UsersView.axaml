<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:svc="using:Cartex.UI.Services"
             x:Class="Cartex.UI.Views.UsersView"
             c:Shortcuts.Source="{Binding Shortcuts}"
             x:CompileBindings="False">

    <Panel>
        <DockPanel Margin="24" Classes.blurred="{Binding IsEditOpen}">

            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[users]}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
                    <Button Classes="brand" Command="{Binding OpenCreateCommand}" IsVisible="{Binding CanCreate}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[create_user]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,14" ColumnDefinitions="*,Auto,Auto">
                <TextBox Classes="search" PlaceholderText="{Binding L[search]}" Text="{Binding SearchText, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="130" VerticalAlignment="Stretch"
                          ItemsSource="{Binding Paging.SortOptions}" SelectedItem="{Binding Paging.SelectedSort}" />
                <Button Grid.Column="2" Classes="icon" Margin="6,0,0,0" Command="{Binding Paging.ToggleDirectionCommand}"
                        ToolTip.Tip="{Binding L[sort]}">
                    <Panel>
                        <mi:MaterialIcon Kind="SortAscending" Width="18" Height="18" IsVisible="{Binding !Paging.Descending}" />
                        <mi:MaterialIcon Kind="SortDescending" Width="18" Height="18" IsVisible="{Binding Paging.Descending}" />
                    </Panel>
                </Button>
            </Grid>

            <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}" />

            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              c:GridDoubleClick.Command="{Binding OpenEditCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding FullName}"
                                                Header="{Binding [full_name], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding Username}"
                                                Header="{Binding [username], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding RoleNames, Converter={x:Static conv:StringJoinConverter.Instance}}"
                                                Header="{Binding [roles], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding DefaultBranchName}"
                                                Header="{Binding [default_branch], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto"
                                                    Header="{Binding [active], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsActive}" IsEnabled="False" IsHitTestVisible="False"
                                                  HorizontalAlignment="Center" Margin="12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="icon" Margin="6,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.OpenEditCommand}"
                                                    IsVisible="{Binding $parent[DataGrid].DataContext.CanEdit}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[edit]}">
                                                <mi:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                                                 Foreground="{DynamicResource TextSecondary}" />
                                            </Button>
                                            <Button Classes="icon" Margin="0,0,6,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.OpenChangeUsernameCommand}"
                                                    IsVisible="{Binding $parent[DataGrid].DataContext.CanChangeUsername}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Username o'zgartirish">
                                                <mi:MaterialIcon Kind="AccountEdit" Width="16" Height="16"
                                                                 Foreground="{DynamicResource BrandPrimaryBrush}" />
                                            </Button>
                                            <Button Classes="icon" Margin="0,0,6,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.DeleteCommand}"
                                                    IsVisible="{Binding $parent[DataGrid].DataContext.CanDelete}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[delete]}">
                                                <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"
                                                                 Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="AccountGroup" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
            </Panel>
        </DockPanel>

        <Border IsVisible="{Binding IsEditOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CancelEditCommand}">
            <Border Classes="form" Background="{DynamicResource CardBg}" CornerRadius="14" Width="760" MaxHeight="660"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"
                    c:FormBehaviors.AutoFocus="True"
                    c:FormBehaviors.EnterSubmits="{Binding SaveCommand}"
                    c:FormBehaviors.EscCancels="{Binding CancelEditCommand}">
                <DockPanel Margin="24">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding EditTitle}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="10" Margin="0,16,0,0">
                        <Button Classes="outline" Command="{Binding CancelEditCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="320,*" ColumnSpacing="20">

                        <StackPanel Grid.Column="0" Spacing="12">
                            <StackPanel Spacing="5">
                                <c:FieldLabel Text="{Binding L[full_name]}" Required="True" />
                                <TextBox Text="{Binding EditFullName}" MinHeight="38" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <c:FieldLabel Text="{Binding L[username]}" Required="True" />
                                <TextBox Text="{Binding EditUsername}" MinHeight="38" IsEnabled="{Binding IsNew}" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding PasswordLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <TextBox Text="{Binding EditPassword}" PasswordChar="●" MinHeight="38" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[default_branch]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <ComboBox ItemsSource="{Binding DefaultBranches}" SelectedItem="{Binding SelectedDefaultBranch}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[start_page]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <ComboBox ItemsSource="{Binding StartPages}" SelectedItem="{Binding SelectedStartPage}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[cart_destination]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <ComboBox ItemsSource="{Binding CartDestinations}" SelectedItem="{Binding SelectedCartDestination}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsNew}">
                                <ToggleSwitch IsChecked="{Binding EditIsActive}" />
                                <TextBlock Text="{Binding L[active]}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="14">

                            <Border Grid.Row="0" Background="{DynamicResource AppBg}" CornerRadius="10"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[roles]}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,6" />
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding EditRoles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}"
                                                              IsEnabled="{Binding IsEnabled}" Margin="4,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{DynamicResource AppBg}" CornerRadius="10"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[accessible_branches]}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,6" />
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding EditBranches}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="4,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- ===== CHANGE USERNAME DIALOG (developer only) ===== -->
        <Border IsVisible="{Binding IsChangeUsernameOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CancelChangeUsernameCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="400"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 16 60 0 #44000000">
                <StackPanel Margin="28" Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Username o'zgartirish" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding ChangeUsernameTarget}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <c:FieldLabel Text="Yangi username" Required="True" />
                        <TextBox Text="{Binding NewUsername}" MinHeight="38"
                                 PlaceholderText="yangi_username" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Classes="outline" Command="{Binding CancelChangeUsernameCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" Command="{Binding ConfirmChangeUsernameCommand}" Content="{Binding L[save]}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
