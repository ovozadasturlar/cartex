<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:vm="using:Cartex.UI.ViewModels"
             x:Class="Cartex.UI.Views.TradeCaseSettleDialog"
             x:DataType="vm:TradeCaseSettleViewModel"
             x:CompileBindings="True">
    <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="720" MaxHeight="720"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            BoxShadow="0 18 50 0 #33000000" Padding="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding L[tc_settle]}" Classes="h2" Margin="0,0,0,16" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="outline" Command="{Binding CancelCommand}" Content="{Binding L[cancel]}" />
                <Button Classes="brand" Command="{Binding SubmitCommand}" Content="{Binding L[tc_settle]}"
                        IsEnabled="{Binding HasLines}" />
            </StackPanel>

            <ScrollViewer>
                <StackPanel Spacing="14">
                    <Border Background="{DynamicResource AppBg}" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,90,100,110" Background="{DynamicResource SidebarItemHover}">
                                <TextBlock Text="{Binding L[product]}" FontWeight="SemiBold" Padding="12,8" />
                                <TextBlock Grid.Column="1" Text="{Binding L[tc_custody]}" FontWeight="SemiBold" Padding="8" />
                                <TextBlock Grid.Column="2" Text="{Binding L[quantity]}" FontWeight="SemiBold" Padding="8" />
                                <TextBlock Grid.Column="3" Text="{Binding L[amount]}" FontWeight="SemiBold" Padding="8" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="260">
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettleLineRow">
                                            <Grid ColumnDefinitions="*,90,100,110" MinHeight="46">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,6,8,6" Spacing="2">
                                                    <TextBlock Text="{Binding Line.ProductName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <TextBlock Text="{Binding Line.UnitName}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                                   Text="{Binding Line.UnitPrice, StringFormat='× {0:N0}'}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Padding="8"
                                                           Text="{Binding CustodyQuantity, StringFormat='{}{0:0.###}'}" />
                                                <NumericUpDown Grid.Column="2" VerticalAlignment="Center" Margin="4"
                                                               Value="{Binding Quantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                                               Minimum="0" Maximum="{Binding CustodyQuantity}"
                                                               Increment="1" FormatString="0.###"
                                                               ShowButtonSpinner="False" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Padding="8"
                                                           TextAlignment="Right" FontWeight="SemiBold"
                                                           Text="{Binding LineTotal, StringFormat='{}{0:N0}'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,12,*" ColumnSpacing="0">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[discount]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <NumericUpDown Value="{Binding DiscountAmount, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                               Minimum="0" FormatString="N0" ShowButtonSpinner="False" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[cash]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <NumericUpDown Value="{Binding PaidCash, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                               Minimum="0" FormatString="N0" ShowButtonSpinner="False" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[card]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <NumericUpDown Value="{Binding PaidCard, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                               Minimum="0" FormatString="N0" ShowButtonSpinner="False" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="10">
                            <Border Background="{DynamicResource SidebarItemActive}" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="15"
                                                   Text="{Binding SubTotal, StringFormat='{}{0:N0}'}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding L[debt]}" Foreground="{DynamicResource DangerBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <TextBlock FontWeight="Bold" FontSize="15" Foreground="{DynamicResource DangerBrush}"
                                                       Text="{Binding DebtAmount, StringFormat='{}{0:N0}'}" />
                                            <TextBlock Text="{Binding Currency}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <CheckBox IsChecked="{Binding UseCustomerAdvance, Mode=TwoWay}"
                                      Content="{Binding L[tc_use_advance]}" />
                            <CheckBox IsChecked="{Binding CloseWhenEmpty, Mode=TwoWay}"
                                      Content="{Binding L[tc_close_when_empty]}" />
                            <TextBox Text="{Binding Note, Mode=TwoWay}" PlaceholderText="{Binding L[note]}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
