<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:vm="using:Cartex.UI.ViewModels"
             x:Class="Cartex.UI.Views.RemindersView"
             x:DataType="vm:RemindersViewModel"
             x:CompileBindings="True">
    <ScrollViewer>
        <StackPanel Classes="form" Margin="24" MaxWidth="880" HorizontalAlignment="Left" Spacing="16"
                    c:FormBehaviors.EnterSubmits="{Binding SaveCommand}">
            <c:PageHeader Title="{Binding L[customer_messages]}" Subtitle="{Binding L[customer_messages_hint]}" />

            <Border Classes="card" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding L[sms_gateway_quiet_hours]}" FontWeight="SemiBold" FontSize="18" />
                            <TextBlock Text="{Binding L[sms_quiet_hours_scope_hint]}" Classes="hint" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding QuietHoursEnabled}" IsEnabled="{Binding CanEditSms}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*" IsEnabled="{Binding QuietHoursEnabled}">
                        <StackPanel Spacing="5"><TextBlock Text="{Binding L[sms_gateway_send_window_start]}" Classes="caption" /><TextBox Text="{Binding SendWindowStart}" IsEnabled="{Binding CanEditSms}" /></StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="{Binding L[sms_gateway_send_window_end]}" Classes="caption" /><TextBox Text="{Binding SendWindowEnd}" IsEnabled="{Binding CanEditSms}" /></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding L[sms_gateway_debt]}" FontWeight="SemiBold" FontSize="18" />
                            <TextBlock Text="{Binding L[customer_messages_debt_hint]}" Classes="hint" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DebtReminderEnabled}" IsEnabled="{Binding CanEditSms}" />
                    </Grid>
                    <c:TemplateVariableEditor Label="{Binding L[sms_template]}" Text="{Binding DebtReminderTemplate}"
                                              Variables="{Binding DebtVariables}" DragHint="{Binding L[drag_to_message]}"
                                              IsEnabled="{Binding CanEditSms}" />
                    <Separator Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding L[reminder_enabled]}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding L[reminder_enabled_hint]}" Classes="hint" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanEditReminders}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto">
                        <Border Background="{DynamicResource AppBg}" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="10">
                                <CheckBox IsChecked="{Binding NotifyBeforeDue}" IsEnabled="{Binding CanEditReminders}" Content="{Binding L[notify_before_due]}" />
                                <Grid ColumnDefinitions="*,120" IsEnabled="{Binding NotifyBeforeDue}">
                                    <TextBlock Text="{Binding L[days_before_due]}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding DaysBeforeDue}" Minimum="1" Maximum="365" FormatString="0" IsEnabled="{Binding CanEditReminders}" />
                                </Grid>
                                <CheckBox IsChecked="{Binding NotifyOnDueDate}" IsEnabled="{Binding CanEditReminders}" Content="{Binding L[notify_on_due_date]}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource AppBg}" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,120"><TextBlock Text="{Binding L[reminder_min_days]}" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Value="{Binding MinDaysOverdue}" Minimum="0" Maximum="365" FormatString="0" IsEnabled="{Binding CanEditReminders}" /></Grid>
                                <Grid ColumnDefinitions="*,120"><TextBlock Text="{Binding L[reminder_repeat_days]}" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Value="{Binding RepeatEveryDays}" Minimum="1" Maximum="365" FormatString="0" IsEnabled="{Binding CanEditReminders}" /></Grid>
                                <Grid ColumnDefinitions="*,120"><TextBlock Text="{Binding L[reminder_min_balance]}" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Value="{Binding MinBalance}" Minimum="0" FormatString="N0" ShowButtonSpinner="False" IsEnabled="{Binding CanEditReminders}" /></Grid>
                                <Grid ColumnDefinitions="*,120"><TextBlock Text="{Binding L[reminder_send_hour]}" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Value="{Binding SendHourLocal}" Minimum="0" Maximum="23" FormatString="0" IsEnabled="{Binding CanEditReminders}" /></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <CheckBox IsChecked="{Binding ChannelTelegram}" Content="Telegram" IsEnabled="{Binding CanEditReminders}" />
                        <CheckBox IsChecked="{Binding ChannelSms}" Content="SMS" IsEnabled="{Binding CanEditReminders}" />
                        <CheckBox IsChecked="{Binding ChannelEmail}" Content="Email" IsEnabled="{Binding CanEditReminders}" />
                    </StackPanel>
                    <c:TemplateVariableEditor Label="{Binding L[due_soon_template]}" Text="{Binding DueSoonTemplate}" DragHint="{Binding L[drag_to_message]}" IsEnabled="{Binding CanEditReminders}" />
                    <c:TemplateVariableEditor Label="{Binding L[due_today_template]}" Text="{Binding DueTodayTemplate}" DragHint="{Binding L[drag_to_message]}" IsEnabled="{Binding CanEditReminders}" />
                    <c:TemplateVariableEditor Label="{Binding L[reminder_template]}" Text="{Binding OverdueTemplate}" DragHint="{Binding L[drag_to_message]}" IsEnabled="{Binding CanEditReminders}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding L[sms_gateway_receipt]}" FontWeight="SemiBold" FontSize="18" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReceiptLinkEnabled}" IsEnabled="{Binding CanEditSms}" />
                    </Grid>
                    <c:TemplateVariableEditor Label="{Binding L[sms_template]}" Text="{Binding ReceiptLinkTemplate}"
                                              Variables="{Binding ReceiptVariables}" DragHint="{Binding L[drag_to_message]}"
                                              IsEnabled="{Binding CanEditSms}" />
                    <ToggleSwitch IsChecked="{Binding SendReceiptOnSale}" Content="{Binding L[send_receipt_on_sale]}" IsEnabled="{Binding CanEditSms}" />
                    <TextBlock Text="{Binding L[send_receipt_on_sale_hint]}" Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding L[sms_gateway_promotion]}" FontWeight="SemiBold" FontSize="18" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding PromotionEnabled}" IsEnabled="{Binding CanEditSms}" />
                    </Grid>
                    <c:TemplateVariableEditor Label="{Binding L[sms_template]}" Text="{Binding PromotionTemplate}"
                                              Variables="{Binding PromotionVariables}" DragHint="{Binding L[drag_to_message]}"
                                              IsEnabled="{Binding CanEditSms}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding L[sms_gateway_manual]}" FontWeight="SemiBold" FontSize="18" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ManualEnabled}" IsEnabled="{Binding CanEditSms}" />
                    </Grid>
                    <c:TemplateVariableEditor Label="{Binding L[sms_template]}" Text="{Binding ManualTemplate}"
                                              Variables="{Binding ManualVariables}" DragHint="{Binding L[drag_to_message]}"
                                              IsEnabled="{Binding CanEditSms}" />
                </StackPanel>
            </Border>

            <Button Classes="brand" HorizontalAlignment="Left" MinWidth="150" HorizontalContentAlignment="Center"
                    Command="{Binding SaveCommand}" Content="{Binding L[save]}" IsVisible="{Binding CanEdit}" Margin="0,0,0,24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
