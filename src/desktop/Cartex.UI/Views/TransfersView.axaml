<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.TransfersView"
             c:Shortcuts.Source="{Binding Shortcuts}"
             x:CompileBindings="False">

    <Panel>
        <DockPanel Margin="24" Classes.blurred="{Binding IsModalOpen}">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[transfers]}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
                    <Button Classes="brand" Command="{Binding OpenCreateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[add]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,16">
                <TextBlock Text="{Binding L[date_from]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,16,0" />
                <TextBlock Grid.Column="2" Text="{Binding L[date_to]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="3" SelectedDate="{Binding DateTo, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,16,0" />
                <TextBlock Grid.Column="4" Text="{Binding L[warehouse]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <ComboBox Grid.Column="5" MinWidth="160" MinHeight="36" Margin="8,0,0,0"
                          ItemsSource="{Binding FilterWarehouseOptions}" SelectedItem="{Binding FilterWarehouse}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="6" Classes="brand" HorizontalAlignment="Right" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" />
                        <TextBlock Text="{Binding L[refresh]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding L[total_quantity]}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding Totals.TotalQuantity, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                </StackPanel>
            </c:Pager>

            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Transfers}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              c:GridDoubleClick.Command="{Binding OpenDetailCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="Auto" Binding="{Binding CreatedAt, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                Header="{Binding [time], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding ProductName}"
                                                Header="{Binding [product_name], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [quantity], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding FromWarehouse}"
                                                Header="{Binding [from_account], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding ToWarehouse}"
                                                Header="{Binding [to_account], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding Status}"
                                                Header="{Binding [status], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding UserName}"
                                                Header="{Binding [user], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="outline" Margin="6,4" Padding="10,4"
                                                IsVisible="{Binding Status, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Sent}"
                                                Command="{Binding $parent[DataGrid].DataContext.ReceiveCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding $parent[DataGrid].DataContext.L[receive]}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="SwapHorizontal" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
            </Panel>
        </DockPanel>

        <Border IsVisible="{Binding IsEditOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CancelEditCommand}">
            <Border Classes="form" Background="{DynamicResource CardBg}" CornerRadius="14" Width="460"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    c:FormBehaviors.AutoFocus="True"
                    c:FormBehaviors.EnterSubmits="{Binding SaveCommand}"
                    c:FormBehaviors.EscCancels="{Binding CancelEditCommand}">
                <StackPanel Margin="24" Spacing="14">
                    <TextBlock Text="{Binding L[transfers]}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[from_account]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding WarehouseOptions}" SelectedItem="{Binding FromWarehouse}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[to_account]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding WarehouseOptions}" SelectedItem="{Binding ToWarehouse}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[product_name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <AutoCompleteBox ItemsSource="{Binding ProductOptions}" SelectedItem="{Binding Product, Mode=TwoWay}"
                                         Text="{Binding ProductText, Mode=TwoWay}" FilterMode="ContainsOrdinal" MinimumPrefixLength="1"
                                         PlaceholderText="{Binding L[product_name]}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch">
                            <AutoCompleteBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></AutoCompleteBox.ItemTemplate>
                            <AutoCompleteBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding CommitProductCommand}" />
                            </AutoCompleteBox.KeyBindings>
                        </AutoCompleteBox>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[quantity]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <NumericUpDown Value="{Binding Quantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="1" FormatString="0.###" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                        <Button Classes="outline" Command="{Binding CancelEditCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding IsDetailOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CloseDetailCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="420"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="24" Spacing="14">
                    <TextBlock Text="{Binding L[transfer_details]}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="{Binding L[date]}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransferDisplay.CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="{Binding L[from_account]}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransferDisplay.FromWarehouse}"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="{Binding L[to_account]}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransferDisplay.ToWarehouse}"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="{Binding L[product_name]}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransferDisplay.ProductName}"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="{Binding L[quantity]}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransferDisplay.Quantity, StringFormat='{}{0:N0}'}"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="{Binding L[status]}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransferDisplay.Status}"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="{Binding L[user]}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransferDisplay.UserName}"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                    <Button Classes="brand" HorizontalAlignment="Right" Command="{Binding CloseDetailCommand}" Content="{Binding L[close]}" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
