<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:il="using:AsyncImageLoader"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:views="using:Cartex.UI.Views"
             x:Class="Cartex.UI.Views.SalesView"
             c:Shortcuts.Source="{Binding Shortcuts}"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Border.cartrow">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.cartrow.over">
            <Setter Property="Background" Value="{DynamicResource DangerBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Button.pcard">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Width" Value="162" />
            <Setter Property="Height" Value="208" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.pcard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
        </Style>

        <Style Selector="Button.prow">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="5,2" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.prow:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
        </Style>

        <Style Selector="Button.chip">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.chip.active">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.chipnav">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chipnav:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
        </Style>

        <Style Selector="Button.step">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.paybtn">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="TextBlock.ratedate">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.ratedate.stalewarn">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="(c:FormBehaviors.SelectAllOnFocus)" Value="True" />
        </Style>

        <Style Selector="DatePicker.missing">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding CartWidth, Mode=TwoWay}" MinWidth="320" MaxWidth="760" />
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns"
                      Classes.blurred="{Binding IsModalOpen}"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast" HorizontalAlignment="Center">
            <GridSplitter.Template>
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Border Width="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                        <Border Width="6" Height="42" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Background="{DynamicResource BorderBrush}" />
                    </Panel>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <DockPanel Grid.Column="0" Margin="16,16,8,16" Classes.blurred="{Binding IsModalOpen}">

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding PosListMode}" Padding="11,0" Margin="8,0,0,0"
                              VerticalAlignment="Stretch" ToolTip.Tip="{Binding L[pos_view_mode]}">
                    <Panel>
                        <mi:MaterialIcon Kind="FormatListBulletedSquare" Width="24" Height="24" IsVisible="{Binding !PosListMode}" />
                        <mi:MaterialIcon Kind="ViewGridOutline" Width="24" Height="24" IsVisible="{Binding PosListMode}" />
                    </Panel>
                </ToggleButton>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0"
                            VerticalAlignment="Center" IsVisible="{Binding ShiftRequired}">
                    <Border Background="{DynamicResource SuccessBg}" CornerRadius="8" Padding="10,6"
                            IsVisible="{Binding ShiftOpen}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="ClockCheckOutline" Width="16" Height="16"
                                             Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{Binding L[pos_shift_open]}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource WarningBg}" CornerRadius="8" Padding="10,6"
                            IsVisible="{Binding !ShiftOpen}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="AlertOutline" Width="16" Height="16"
                                             Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="{Binding L[pos_shift_closed]}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Classes="brand" Padding="10,6" FontSize="12" VerticalAlignment="Stretch"
                            IsVisible="{Binding !ShiftOpen}" Content="{Binding L[open_shift]}">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" Width="220">
                                    <TextBlock Text="{Binding L[opening_float]}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <NumericUpDown Value="{Binding ShiftOpeningFloat, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                                   Minimum="0" FormatString="N0" ShowButtonSpinner="False" MinHeight="36" />
                                    <Button Classes="brand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding OpenShiftCommand}" Content="{Binding L[open_shift]}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                    <TextBox x:Name="ScanBox" Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="{Binding L[scan_barcode]}" BorderThickness="0" FontSize="15" MinHeight="34"
                             Background="Transparent" VerticalContentAlignment="Center">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="BarcodeScan" Width="20" Height="20" Margin="10,0,4,0"
                                             Foreground="{DynamicResource BrandPrimaryBrush}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ScanCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </Border>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button x:Name="CatLeft" DockPanel.Dock="Left" Classes="chipnav" Margin="0,0,8,0"
                        IsVisible="False" Click="OnChipLeft">
                    <mi:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" />
                </Button>
                <Button x:Name="CatRight" DockPanel.Dock="Right" Classes="chipnav" Margin="8,0,0,0"
                        IsVisible="False" Click="OnChipRight">
                    <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
                </Button>
                <ScrollViewer x:Name="CatScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PointerWheelChanged="OnChipsWheel" ScrollChanged="OnChipsScroll">
                    <ItemsControl ItemsSource="{Binding NavCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="chip" Classes.active="{Binding IsSelected}" Margin="0,0,6,0"
                                        Command="{Binding $parent[UserControl].DataContext.SelectCategoryCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" IsVisible="{Binding HasSubCategories}">
                <Button x:Name="SubLeft" DockPanel.Dock="Left" Classes="chipnav" Margin="0,0,8,0"
                        IsVisible="False" Click="OnChipLeft">
                    <mi:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" />
                </Button>
                <Button x:Name="SubRight" DockPanel.Dock="Right" Classes="chipnav" Margin="8,0,0,0"
                        IsVisible="False" Click="OnChipRight">
                    <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
                </Button>
                <ScrollViewer x:Name="SubCatScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PointerWheelChanged="OnChipsWheel" ScrollChanged="OnChipsScroll">
                    <ItemsControl ItemsSource="{Binding SubCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="chip" Classes.active="{Binding IsSelected}" Margin="0,0,6,0"
                                        Command="{Binding $parent[UserControl].DataContext.SelectSubCategoryCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <ScrollViewer ScrollChanged="OnProductsScroll">
                <Panel>
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding Products}" IsVisible="{Binding !PosListMode}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="pcard"
                                        Command="{Binding $parent[UserControl].DataContext.AddStockToCartCommand}"
                                        CommandParameter="{Binding}"
                                        c:PressGestures.Command="{Binding $parent[UserControl].DataContext.ShowProductDetailCommand}">
                                    <Grid RowDefinitions="120,*">
                                        <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True"
                                                Background="{DynamicResource SidebarItemHover}">
                                            <Panel>
                                                <mi:MaterialIcon Kind="PackageVariantClosed" Width="30" Height="30"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource TextMuted}" />
                                                <Image il:ImageLoader.Source="{Binding ImageUrl, Converter={x:Static conv:ThumbImageUrlConverter.Instance}}" Stretch="UniformToFill" />
                                                <Border Background="{DynamicResource DangerBrush}" CornerRadius="8" Padding="6,2" Margin="6"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        IsVisible="{Binding DiscountPct, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <TextBlock Text="{Binding DiscountPct, StringFormat='{}-{0:0.#}%'}" FontSize="11"
                                                               FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </Panel>
                                        </Border>

                                        <Grid Grid.Row="1" Margin="10,8,10,9" RowDefinitions="*,Auto" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Text="{Binding ProductName}" TextWrapping="Wrap"
                                                       FontSize="13" FontWeight="SemiBold" MaxLines="2"
                                                       LineHeight="16" VerticalAlignment="Top"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding SellingPrice, StringFormat='{}{0:N0}'}"
                                                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Code}" FontSize="10.5" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               IsVisible="{Binding Code, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource AppBg}"
                                                        CornerRadius="6" Padding="6,2"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                               Text="{Binding Quantity, StringFormat='{}{0:N0}'}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Products}" IsVisible="{Binding PosListMode}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="prow"
                                        Command="{Binding $parent[UserControl].DataContext.AddStockToCartCommand}"
                                        CommandParameter="{Binding}"
                                        c:PressGestures.Command="{Binding $parent[UserControl].DataContext.ShowProductDetailCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Code}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   IsVisible="{Binding Code, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <Border Grid.Column="2" Background="{DynamicResource DangerBrush}" CornerRadius="8" Padding="5,1"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding DiscountPct, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="{Binding DiscountPct, StringFormat='{}-{0:0.#}%'}" FontSize="10"
                                                       FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding SellingPrice, StringFormat='{}{0:N0}'}"
                                                   FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}" />
                                        <Border Grid.Column="4" Background="{DynamicResource AppBg}" MinWidth="46"
                                                CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       Text="{Binding Quantity, StringFormat='{}{0:N0}'}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="outline" HorizontalAlignment="Center" Margin="0,10,0,16" Padding="18,8"
                            Command="{Binding LoadMoreProductsCommand}" IsVisible="{Binding HasMoreProducts}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ChevronDown" Width="16" Height="16" />
                            <TextBlock Text="{Binding L[load_more]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>

                    <c:EmptyState Icon="PackageVariant" Title="{Binding L[no_data]}"
                                  IsVisible="{Binding !Products.Count}" />
                </Panel>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Column="2" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Classes.blurred="{Binding IsModalOpen}">
            <DockPanel Margin="16">

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
                    <TextBlock Text="{Binding L[cart]}" Classes="h2" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="paybtn" Padding="10,6" Margin="0,0,8,0"
                            Command="{Binding ToggleQueuePanelCommand}" ToolTip.Tip="{Binding L[queue]}"
                            IsVisible="{Binding CanSeeQueue}">
                        <Panel>
                            <mi:MaterialIcon Kind="Menu" Width="18" Height="18" />
                            <Border Background="{DynamicResource DangerBrush}" CornerRadius="8" Height="16" MinWidth="16"
                                    Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-8,-10,0" IsVisible="{Binding QueueCount}">
                                <TextBlock Text="{Binding QueueCount}" FontSize="10" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                    </Button>
                    <Button Grid.Column="2" Classes="paybtn" Padding="10,6" Margin="0,0,8,0"
                            Command="{Binding OpenPrepackCommand}" ToolTip.Tip="{Binding L[prepack_title]}"
                            IsVisible="{Binding CanPrepack}">
                        <mi:MaterialIcon Kind="ScaleBalance" Width="18" Height="18" />
                    </Button>
                    <Button Grid.Column="3" Classes="paybtn" Padding="10,6" Margin="0,0,8,0"
                            Command="{Binding ToggleHeldPanelCommand}" ToolTip.Tip="{Binding L[held_sales]}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="PauseCircleOutline" Width="18" Height="18" />
                            <TextBlock Text="{Binding HeldSales.Count}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Classes="paybtn" Padding="8,6"
                            Command="{Binding ClearCartCommand}" ToolTip.Tip="{Binding L[cancel]}"
                            IsEnabled="{Binding !IsCartEmpty}">
                        <mi:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18"
                                         Foreground="{DynamicResource DangerBrush}" />
                    </Button>
                </Grid>

                <Border DockPanel.Dock="Top" Margin="0,0,0,10" CornerRadius="8"
                        Background="{DynamicResource AppBg}" Padding="10,8">
                    <Panel>
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding ToggleCustomerPanelCommand}"
                                IsVisible="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="AccountPlusOutline" Width="20" Height="20"
                                                 Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding L[customer]}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding L[optional]}" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                        </Button>
                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding SelectedCustomer.FullName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding SelectedCustomer.LastName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               Text="{Binding SelectedCustomer.CashbackBalance, StringFormat='{}{0:N0} 🎁'}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource DangerBrush}"
                                               IsVisible="{Binding CustomerIsDebtor}">
                                        <Run Text="{Binding L[opening_kind_debt]}" />
                                        <Run Text="{Binding CustomerBalanceAbs, StringFormat='{}{0:N0}'}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}"
                                               IsVisible="{Binding CustomerIsCreditor}">
                                        <Run Text="{Binding L[opening_kind_credit]}" />
                                        <Run Text="{Binding CustomerBalanceAbs, StringFormat='{}{0:N0}'}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               IsVisible="{Binding HasCreditLimit}">
                                        <Run Text="{Binding L[credit_remaining]}" />
                                        <Run Text="{Binding RemainingCredit, StringFormat='{}{0:N0}'}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4"
                                    Cursor="Hand" Command="{Binding ClearCustomerCommand}">
                                <mi:MaterialIcon Kind="Close" Width="16" Height="16"
                                                 Foreground="{DynamicResource TextMuted}" />
                            </Button>
                        </Grid>
                    </Panel>
                </Border>

                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat='{}{0:N0}'}"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,110,150">
                            <TextBlock Text="{Binding L[discount]}" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding DiscountPercent, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Maximum="100"
                                           FormatString="0.00" ShowButtonSpinner="False" MinHeight="34" ToolTip.Tip="%">
                                <NumericUpDown.InnerRightContent>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextMuted}" />
                                </NumericUpDown.InnerRightContent>
                            </NumericUpDown>
                            <NumericUpDown Grid.Column="2" Value="{Binding DiscountAmount, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0"
                                           FormatString="N0" ShowButtonSpinner="False" MinHeight="34" Margin="6,0,0,0">
                                <NumericUpDown.InnerRightContent>
                                    <TextBlock Text="{Binding L[currency_sum]}" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextMuted}" />
                                </NumericUpDown.InnerRightContent>
                            </NumericUpDown>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAutoDiscount}">
                            <TextBlock Text="{Binding L[loyalty_discount]}" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding AutoDiscountAmount, StringFormat='{}-{0:N0}'}"
                                       Foreground="{DynamicResource BrandPrimaryBrush}" FontWeight="SemiBold" />
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Height="1" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding L[pos_payable]}" Classes="h3" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource BrandPrimaryBrush}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,*,*" Margin="0,2,0,0" IsVisible="{Binding !IsMulticurrency}">
                            <Button Classes="icon" Margin="0,15,4,0" VerticalAlignment="Bottom"
                                    Command="{Binding PayExactCommand}"
                                    ToolTip.Tip="{Binding L[shortcut_pay_exact]}">
                                <mi:MaterialIcon Kind="Sigma" Width="20" Height="20" />
                            </Button>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="{Binding L[cash]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <NumericUpDown Value="{Binding PaidCash, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" FormatString="N0"
                                               ShowButtonSpinner="False" MinHeight="38" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="2,0">
                                <TextBlock Text="{Binding L[card]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <NumericUpDown Value="{Binding PaidCard, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" FormatString="N0"
                                               ShowButtonSpinner="False" MinHeight="38" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                <TextBlock Text="{Binding L[bonus]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <NumericUpDown Value="{Binding PaidBonus, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" FormatString="N0"
                                               ShowButtonSpinner="False" MinHeight="38" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6" Margin="0,2,0,0" IsVisible="{Binding IsMulticurrency}">
                            <ItemsControl ItemsSource="{Binding PaymentRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="106,6,84,6,*,6,Auto" Margin="0,0,0,6">
                                            <ComboBox ItemsSource="{Binding Methods}"
                                                      SelectedItem="{Binding Method}" MinHeight="36" VerticalAlignment="Top"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Currencies}"
                                                      SelectedItem="{Binding Currency}" MinHeight="36" VerticalAlignment="Top"
                                                      HorizontalAlignment="Stretch" />
                                            <StackPanel Grid.Column="4" Spacing="2">
                                                <NumericUpDown Value="{Binding Amount, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" FormatString="N2"
                                                               ShowButtonSpinner="False" MinHeight="36" />
                                                <TextBlock Text="{Binding AmountBase, StringFormat='≈ {0:N0}'}"
                                                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                           HorizontalAlignment="Right" Margin="0,0,4,0"
                                                           IsVisible="{Binding ShowBase}" />
                                            </StackPanel>
                                            <Button Grid.Column="6" Classes="icon" VerticalAlignment="Top" Margin="0,6,0,0"
                                                    Command="{Binding $parent[UserControl].DataContext.RemovePaymentCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="Auto,6,Auto,*,Auto">
                                <Button Classes="icon" Command="{Binding PayExactCommand}"
                                        ToolTip.Tip="{Binding L[shortcut_pay_exact]}">
                                    <mi:MaterialIcon Kind="Sigma" Width="20" Height="20" />
                                </Button>
                                <Panel Grid.Column="2">
                                    <Button Background="{DynamicResource WarningBg}" BorderThickness="0" CornerRadius="8"
                                            Padding="8,5" Cursor="Hand" VerticalAlignment="Center"
                                            Command="{Binding OpenQuickRatesCommand}"
                                            ToolTip.Tip="{Binding L[stale_rate_warning]}"
                                            IsVisible="{Binding ShowStaleFix}">
                                        <mi:MaterialIcon Kind="AlertOutline" Width="16" Height="16"
                                                         Foreground="{DynamicResource WarningBrush}" />
                                    </Button>
                                    <Border Background="{DynamicResource WarningBg}" CornerRadius="8" Padding="8,5"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding L[stale_rate_warning]}"
                                            IsVisible="{Binding ShowStaleHint}">
                                        <mi:MaterialIcon Kind="AlertOutline" Width="16" Height="16"
                                                         Foreground="{DynamicResource WarningBrush}" />
                                    </Border>
                                </Panel>
                                <Button Grid.Column="4" Classes="outline" Padding="10,5" Command="{Binding AddPaymentCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <mi:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                        <TextBlock Text="{Binding L[add_payment]}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                IsVisible="{Binding ShowChange}" IsHitTestVisible="{Binding CanCreditExcess}"
                                Command="{Binding ToggleExcessTargetCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding L[change]}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <mi:MaterialIcon Grid.Column="1" Kind="SwapVertical" Width="14" Height="14" Margin="6,0,0,0"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextMuted}"
                                                 IsVisible="{Binding CanCreditExcess}" />
                                <TextBlock Grid.Column="2" Text="{Binding ChangeAmount, StringFormat='{}{0:N0}'}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Grid>
                        </Button>

                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                IsVisible="{Binding ExcessToCredit}" IsHitTestVisible="{Binding CanCreditExcess}"
                                Command="{Binding ToggleExcessTargetCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding L[pos_to_account]}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrandPrimaryBrush}" />
                                <mi:MaterialIcon Grid.Column="1" Kind="SwapVertical" Width="14" Height="14" Margin="6,0,0,0"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource BrandPrimaryBrush}"
                                                 IsVisible="{Binding CanCreditExcess}" />
                                <TextBlock Grid.Column="2" Text="{Binding ChangeAmount, StringFormat='{}+{0:N0}'}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrandPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <Grid ColumnDefinitions="Auto,8,Auto,*,Auto" IsVisible="{Binding ShowDebt}">
                            <TextBlock Text="{Binding L[debt]}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedDebtCurrency}"
                                      MinHeight="32" MinWidth="84" IsVisible="{Binding IsMulticurrency}"
                                      ToolTip.Tip="{Binding L[debt_currency]}" />
                            <TextBlock Grid.Column="4" Text="{Binding DebtDisplay}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding ShowDebtDueDate}">
                            <TextBlock Text="{Binding L[debt_due_date]}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <DatePicker Grid.Column="2" SelectedDate="{Binding DebtDueDate}" MinWidth="160" MinHeight="36"
                                        HorizontalAlignment="Right" Classes.missing="{Binding DueDateMissing}" />
                        </Grid>

                        <Border Background="{DynamicResource DangerBg}" CornerRadius="8" Padding="10,7"
                                IsVisible="{Binding IsOverCreditLimit}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <mi:MaterialIcon Kind="AlertOutline" Width="16" Height="16"
                                                 Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="{Binding L[credit_limit_exceeded]}" FontSize="12"
                                           Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="Auto,8,*">
                            <Button Grid.Column="0" Classes="outline" MinHeight="50" Padding="14,0"
                                    HorizontalContentAlignment="Center" Command="{Binding HoldSaleCommand}"
                                    IsEnabled="{Binding !IsCartEmpty}" ToolTip.Tip="{Binding L[hold_sale]}">
                                <mi:MaterialIcon Kind="PauseCircleOutline" Width="22" Height="22" />
                            </Button>
                            <Button Grid.Column="2" Classes="brand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    MinHeight="50" FontSize="17" Command="{Binding CompleteSaleCommand}"
                                    IsEnabled="{Binding !IsCartEmpty}"
                                    Content="{Binding L[complete_sale]}" />
                        </Grid>

                    </StackPanel>
                </Border>

                <ScrollViewer>
                    <Panel>
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,8" CornerRadius="8" Classes="cartrow" Classes.over="{Binding IsOverStock}"
                                            ToolTip.Tip="{Binding Available, StringFormat='{}{0:N0}'}"
                                            c:PressGestures.Command="{Binding $parent[UserControl].DataContext.ShowCartDetailCommand}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="170"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                           IsVisible="{Binding !$parent[UserControl].DataContext.CanOverridePrice}"
                                                           Text="{Binding UnitPrice, StringFormat='{}{0:N0}'}" />
                                                <NumericUpDown Value="{Binding UnitPrice, Mode=TwoWay, Converter={x:Static conv:EmptyKeepsValueConverter.Instance}}" Minimum="0"
                                                               FormatString="0.##" ShowButtonSpinner="False"
                                                               MinHeight="28" MinWidth="96" HorizontalAlignment="Left"
                                                               IsVisible="{Binding $parent[UserControl].DataContext.CanOverridePrice}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center" Margin="6,0">
                                                <Button Classes="step" Command="{Binding $parent[UserControl].DataContext.DecrementCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Minus" Width="14" Height="14" />
                                                </Button>
                                                <NumericUpDown Value="{Binding Quantity, Mode=TwoWay, Converter={x:Static conv:EmptyKeepsValueConverter.Instance}}" Minimum="0"
                                                               Increment="1" FormatString="0.###" ShowButtonSpinner="False"
                                                               MinWidth="64" MinHeight="32" VerticalAlignment="Center"
                                                               HorizontalContentAlignment="Center" IsEnabled="{Binding !IsPrepack}" />
                                                <Button Classes="step" Command="{Binding $parent[UserControl].DataContext.IncrementCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="64">
                                                <TextBlock Text="{Binding LineTotal, StringFormat='{}{0:N0}'}"
                                                           FontWeight="SemiBold" TextAlignment="Right"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <Button Background="Transparent" BorderThickness="0" Padding="2"
                                                        HorizontalAlignment="Right" Cursor="Hand"
                                                        Command="{Binding $parent[UserControl].DataContext.RemoveItemCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Close" Width="14" Height="14"
                                                                     Foreground="{DynamicResource TextMuted}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <c:EmptyState Icon="CartOutline" Title="{Binding L[no_items]}"
                                      IsVisible="{Binding IsCartEmpty}" Margin="0,40,0,0" />
                    </Panel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <Border Grid.ColumnSpan="3" Background="#30000000" IsVisible="{Binding IsCustomerPanelOpen}"
                c:OverlayBehaviors.DismissCommand="{Binding ToggleCustomerPanelCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="440" MaxHeight="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="22"
                    BoxShadow="0 16 48 0 #44000000">
                <Panel>

                <DockPanel IsVisible="{Binding !IsAddingCustomer}">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock Text="{Binding L[customers]}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                                Command="{Binding ToggleCustomerPanelCommand}">
                            <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" />
                        </Button>
                    </Grid>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                        <TextBox Text="{Binding CustomerSearch, Mode=TwoWay}" PlaceholderText="{Binding L[search]}" MinHeight="42">
                            <TextBox.InnerLeftContent>
                                <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0"
                                                 Foreground="{DynamicResource TextMuted}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0" Command="{Binding ToggleBonusCommand}"
                                ToolTip.Tip="{Binding L[cashback_balance]}">
                            <mi:MaterialIcon Kind="EyeOutline" Width="18" Height="18" />
                        </Button>
                        <Button Grid.Column="2" Classes="brand" Margin="8,0,0,0" Command="{Binding ShowAddCustomerCommand}"
                                ToolTip.Tip="{Binding L[add]}">
                            <mi:MaterialIcon Kind="AccountPlus" Width="18" Height="18" Foreground="White" />
                        </Button>
                    </Grid>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding CustomerResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Padding="12,10" Cursor="Hand"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Command="{Binding $parent[ItemsControl].DataContext.SelectCustomerCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding LastName}" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Phone}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="🎁" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"
                                                           IsVisible="{Binding $parent[ItemsControl].DataContext.BonusVisible}"
                                                           Text="{Binding CashbackBalance, StringFormat='{}{0:N0}'}" />
                                                <TextBlock Text="•••" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                                                           IsVisible="{Binding !$parent[ItemsControl].DataContext.BonusVisible}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <StackPanel Spacing="12" IsVisible="{Binding IsAddingCustomer}">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                                Command="{Binding CancelAddCustomerCommand}">
                            <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding L[add]}" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextPrimary}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,10,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <c:FieldLabel Text="{Binding L[first_name]}" Required="True" />
                            <TextBox Text="{Binding NewCustomerName}" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <c:FieldLabel Text="{Binding L[last_name]}" />
                            <TextBox Text="{Binding NewCustomerLastName}" MinHeight="40" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,10,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <c:FieldLabel Text="{Binding L[phone]}" Required="True" />
                            <TextBox Text="{Binding NewCustomerPhone}" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <c:FieldLabel Text="{Binding L[email]}" />
                            <TextBox Text="{Binding NewCustomerEmail}" MinHeight="40" PlaceholderText="mijoz@example.com" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,10,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <c:FieldLabel Text="{Binding L[address]}" />
                            <TextBox Text="{Binding NewCustomerAddress}" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <c:FieldLabel Text="{Binding L[card_barcode]}" />
                            <TextBox Text="{Binding NewCustomerCard}" MinHeight="40" PlaceholderText="{Binding L[scan_barcode]}">
                                <TextBox.InnerLeftContent>
                                    <mi:MaterialIcon Kind="BarcodeScan" Width="18" Height="18" Margin="8,0,2,0"
                                                     Foreground="{DynamicResource BrandPrimaryBrush}" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,10,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <c:FieldLabel Text="{Binding L[discount_pct]}" />
                            <NumericUpDown Value="{Binding NewCustomerDiscount, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Maximum="100"
                                           FormatString="0.##" ShowButtonSpinner="False" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <c:FieldLabel Text="{Binding L[credit_limit]}" />
                            <NumericUpDown Value="{Binding NewCustomerCreditLimit, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="100000"
                                           FormatString="0.##" ShowButtonSpinner="False" MinHeight="40" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                        <c:FieldLabel Text="{Binding L[opening_balance]}" />
                        <Grid ColumnDefinitions="*,8,Auto,Auto">
                            <NumericUpDown Value="{Binding NewCustomerOpening, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="10000"
                                           FormatString="0.##" ShowButtonSpinner="False" MinHeight="40" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding OpeningKinds}" SelectedIndex="{Binding NewCustomerOpeningKindIndex}"
                                      MinHeight="40" MinWidth="120" />
                            <ComboBox Grid.Column="3" ItemsSource="{Binding Currencies}" SelectedItem="{Binding NewCustomerOpeningCurrency}"
                                      MinHeight="40" MinWidth="78" Margin="8,0,0,0" IsVisible="{Binding IsMulticurrency}" />
                        </Grid>
                        <TextBlock Text="{Binding L[opening_balance_hint]}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                        <Button Grid.Column="1" Classes="outline" Margin="0,0,10,0" MinWidth="100" HorizontalContentAlignment="Center"
                                Command="{Binding CancelAddCustomerCommand}" Content="{Binding L[cancel]}" />
                        <Button Grid.Column="2" Classes="brand" MinWidth="120" HorizontalContentAlignment="Center"
                                Command="{Binding SaveNewCustomerCommand}" Content="{Binding L[save]}" />
                    </Grid>
                </StackPanel>
                </Panel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="3" Background="#30000000" IsVisible="{Binding IsQueuePanelOpen}"
                c:OverlayBehaviors.DismissCommand="{Binding ToggleQueuePanelCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Width="460" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16"
                    BoxShadow="0 12 40 0 #33000000">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Text="{Binding L[queue]}" Classes="h3" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                                Command="{Binding ToggleQueuePanelCommand}">
                            <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" />
                        </Button>
                    </Grid>
                    <ScrollViewer>
                        <Panel>
                            <ItemsControl ItemsSource="{Binding QueueCarts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" Padding="12,10" CornerRadius="8"
                                                Background="{DynamicResource AppBg}">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                    <TextBlock Text="{Binding CustomerName}" FontSize="12" IsVisible="{Binding HasCustomer}"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Text="{Binding Note}" FontSize="12" FontStyle="Italic" IsVisible="{Binding HasNote}"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="brand" Padding="12,6" Margin="8,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].DataContext.OpenQueueCartCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Play" Width="16" Height="16" />
                                                </Button>
                                                <Button Grid.Column="2" Classes="paybtn" Padding="8,6" VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].DataContext.CancelQueueCartCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Close" Width="14" Height="14"
                                                                     Foreground="{DynamicResource DangerBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding L[no_data]}" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,20"
                                       IsVisible="{Binding !QueueCarts.Count}" />
                        </Panel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="3" Background="#30000000" IsVisible="{Binding IsHeldPanelOpen}"
                c:OverlayBehaviors.DismissCommand="{Binding ToggleHeldPanelCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Width="380" MaxHeight="460"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16"
                    BoxShadow="0 12 40 0 #33000000">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Text="{Binding L[held_sales]}" Classes="h3" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                                Command="{Binding ToggleHeldPanelCommand}">
                            <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" />
                        </Button>
                    </Grid>
                    <ScrollViewer>
                        <Panel>
                            <ItemsControl ItemsSource="{Binding HeldSales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding HeldAt, StringFormat='{}{0:dd.MM HH:mm}'}"
                                                           FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="brand" Padding="10,6" Margin="0,0,6,0"
                                                    Command="{Binding $parent[ItemsControl].DataContext.ResumeSaleCommand}"
                                                    CommandParameter="{Binding}" Content="{Binding $parent[ItemsControl].DataContext.L[resume]}" />
                                            <Button Grid.Column="2" Classes="paybtn" Padding="8,6"
                                                    Command="{Binding $parent[ItemsControl].DataContext.DiscardHeldCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Close" Width="14" Height="14"
                                                                 Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding L[no_data]}" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,20"
                                       IsVisible="{Binding !HeldSales.Count}" />
                        </Panel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="3" Background="#30000000" IsVisible="{Binding IsProductDetailOpen}"
                c:OverlayBehaviors.DismissCommand="{Binding CloseProductDetailCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="440" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0" ClipToBounds="True">
                <ScrollViewer>
                    <StackPanel Margin="22" Spacing="12">
                        <Grid ColumnDefinitions="Auto,16,*">
                            <Border Width="128" Height="128" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Top"
                                    Background="{DynamicResource SidebarItemHover}">
                                <Panel>
                                    <mi:MaterialIcon Kind="PackageVariantClosed" Width="40" Height="40"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextMuted}" />
                                    <ContentControl Content="{Binding DetailProduct}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <Image il:ImageLoader.Source="{Binding ImageUrl, Converter={x:Static conv:ImageUrlConverter.Instance}}" Stretch="UniformToFill" />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="10">
                                <TextBlock Text="{Binding DetailProduct.ProductName}" FontSize="17" FontWeight="Bold"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[category]}" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailProduct.CategoryName}" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[unit]}" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailProduct.UnitName}" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L[on_hand]}" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailProduct.Quantity, StringFormat='{}{0:N0}'}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding L[selling_price]}" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailProduct.SellingPrice, StringFormat='{}{0:N0}'}"
                                               FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding L[sku_code]}" Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding DetailProduct.Code, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailProduct.Code}" Foreground="{DynamicResource TextPrimary}"
                                               FontWeight="SemiBold"
                                               IsVisible="{Binding DetailProduct.Code, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding L[barcode]}" Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding DetailBarcodes, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DetailBarcodes}" Foreground="{DynamicResource TextPrimary}"
                                               IsVisible="{Binding DetailBarcodes, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel IsVisible="{Binding CanReceiveStock}">
                            <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    MinHeight="40" IsVisible="{Binding !IsReceiveOpen}" Command="{Binding OpenReceiveCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="PackageDown" Width="18" Height="18" />
                                    <TextBlock Text="{Binding L[receive_stock]}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Classes="form" Spacing="10" IsVisible="{Binding IsReceiveOpen}"
                                        c:FormBehaviors.AutoFocus="True"
                                        c:FormBehaviors.EnterSubmits="{Binding ReceiveSupplyCommand}"
                                        c:FormBehaviors.EscCancels="{Binding CloseReceiveCommand}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding L[supplier]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                    <ComboBox ItemsSource="{Binding SupplierOptions}" SelectedItem="{Binding ReceiveSupplier}"
                                              HorizontalAlignment="Stretch" MinHeight="40">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding L[no_suppliers_hint]}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasNoSuppliers}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding L[quantity]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        <NumericUpDown Value="{Binding ReceiveQuantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0"
                                                       FormatString="0.###"
                                                       ShowButtonSpinner="False" MinHeight="40" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{Binding L[purchase_price]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        <NumericUpDown Value="{Binding ReceivePurchasePrice, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0"
                                                       FormatString="N0"
                                                       ShowButtonSpinner="False" MinHeight="40" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding L[selling_price]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        <NumericUpDown Value="{Binding ReceiveSellingPrice, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0"
                                                       FormatString="N0"
                                                       ShowButtonSpinner="False" MinHeight="40" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{Binding L[expired_at]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        <CalendarDatePicker SelectedDate="{Binding ReceiveExpiry}" MinHeight="40"
                                                            HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4" IsVisible="{Binding IsMulticurrency}">
                                    <TextBlock Text="{Binding L[currency]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                    <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding ReceiveCurrency}"
                                              HorizontalAlignment="Stretch" MinHeight="40" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <Button Grid.Column="0" Classes="brand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            MinHeight="40" Command="{Binding ReceiveSupplyCommand}" Content="{Binding L[receive_stock]}" />
                                    <Button Grid.Column="2" Classes="outline" MinHeight="40" Padding="10,0"
                                            Command="{Binding CloseReceiveCommand}">
                                        <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,8,*" Margin="0,6,0,0">
                            <Button Grid.Column="0" Classes="outline" MinHeight="46" Padding="16,0"
                                    Command="{Binding CloseProductDetailCommand}" Content="{Binding L[close]}" />
                            <Button Grid.Column="2" Classes="brand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    MinHeight="46" Command="{Binding AddDetailToCartCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="CartPlus" Width="18" Height="18" />
                                    <TextBlock Text="{Binding L[add]}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="3" Background="#30000000" IsVisible="{Binding IsReceiptOpen}"
                c:OverlayBehaviors.DismissCommand="{Binding CloseReceiptCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="360" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="22"
                    BoxShadow="0 16 48 0 #44000000">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,8,*" Margin="0,16,0,0">
                        <Button Grid.Column="0" Classes="outline" MinHeight="46" Padding="16,0"
                                Command="{Binding CloseReceiptCommand}" Content="{Binding L[close]}" />
                        <Button Grid.Column="2" Classes="brand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                MinHeight="46" Command="{Binding PrintReceiptCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Printer" Width="18" Height="18" />
                                <TextBlock Text="{Binding L[print]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <c:ReceiptCard DataContext="{Binding CurrentReceipt}" />
                </DockPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="3" Background="#30000000" IsVisible="{Binding IsQuickRatesOpen}"
                c:OverlayBehaviors.DismissCommand="{Binding CloseQuickRatesCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="400" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="22"
                    BoxShadow="0 16 48 0 #44000000">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock Text="{Binding L[quick_rates_title]}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                                Command="{Binding CloseQuickRatesCommand}">
                            <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" />
                        </Button>
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,8,*" Margin="0,16,0,0">
                        <Button Grid.Column="0" Classes="outline" MinHeight="42" Padding="16,0"
                                Command="{Binding CloseQuickRatesCommand}" Content="{Binding L[cancel]}" />
                        <Button Grid.Column="2" Classes="brand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                MinHeight="42" Command="{Binding SaveQuickRatesCommand}" Content="{Binding L[save]}" />
                    </Grid>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding QuickRates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,10,130" Margin="0,0,0,10">
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Code}" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding CurrentRate, StringFormat='{}{0:N2}'}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RateAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="11"
                                                       Classes="ratedate" Classes.stalewarn="{Binding IsStale}"
                                                       IsVisible="{Binding RateAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Text="{Binding $parent[UserControl].DataContext.L[currency_no_rate]}" FontSize="11"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       IsVisible="{Binding RateAt, Converter={x:Static ObjectConverters.IsNull}}" />
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="2" Value="{Binding NewRate, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" FormatString="N2"
                                                       ShowButtonSpinner="False" MinHeight="36" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <views:QuickProductView Grid.ColumnSpan="3" DataContext="{Binding QuickProduct}" />

        <views:PrepackView Grid.ColumnSpan="3" DataContext="{Binding Prepack}" />

    </Grid>
</UserControl>
