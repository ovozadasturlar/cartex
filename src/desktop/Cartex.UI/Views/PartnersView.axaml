<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:p="using:Cartex.Shared.Models.Partners"
             xmlns:svc="using:Cartex.UI.Services"
             x:Class="Cartex.UI.Views.PartnersView"
             x:DataType="vm:PartnersViewModel">

    <Panel>
        <DockPanel Margin="20">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,14">
                <TextBlock Text="{Binding L[partners]}" Classes="h2" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="outline" MinHeight="38" Padding="14,0"
                        Command="{Binding OpenSpecialtiesCommand}" IsVisible="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="TagMultipleOutline" Width="15" Height="15" />
                        <TextBlock Text="{Binding L[specialties]}" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="brand" MinHeight="38" Padding="14,0"
                        Command="{Binding OpenNewCommand}" IsVisible="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Plus" Width="15" Height="15" />
                        <TextBlock Text="{Binding L[add]}" FontSize="12.5" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" Watermark="{Binding L[search]}"
                     MinHeight="38" Margin="0,0,0,12" />

            <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}" Margin="0,10,0,0" />

            <Grid ColumnDefinitions="*,14,340">
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Partners}" SelectedItem="{Binding SelectedPartner}"
                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [code], Source={x:Static svc:LocalizationManager.Instance}}"
                                                Binding="{Binding PartnerCode, Mode=OneWay}" Width="110" />
                            <DataGridTextColumn Header="{Binding [full_name], Source={x:Static svc:LocalizationManager.Instance}}"
                                                Binding="{Binding FullName, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="{Binding [phone], Source={x:Static svc:LocalizationManager.Instance}}"
                                                Binding="{Binding Phone, Mode=OneWay}" Width="130" />
                            <DataGridTextColumn Header="{Binding [score], Source={x:Static svc:LocalizationManager.Instance}}"
                                                Binding="{Binding Score, StringFormat='{}{0:N0}', Mode=OneWay}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="16"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding HasSelection}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="8">
                            <TextBlock Text="{Binding SelectedPartner.FullName}" Classes="h3" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedPartner.PartnerCode}"
                                       Foreground="{DynamicResource TextMuted}" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding SelectedPartner.Specialties}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:PartnerSpecialtyDto">
                                        <Border Background="{DynamicResource AppBg}" CornerRadius="10" Padding="8,3" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding L[earned]}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" />
                                    <TextBlock Text="{Binding SelectedPartner.Earned, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding L[pending]}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" />
                                    <TextBlock Text="{Binding SelectedPartner.Pending, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <Button Classes="outline" HorizontalAlignment="Stretch" MinHeight="36" Margin="0,6,0,10"
                                    Command="{Binding OpenEditCommand}" IsVisible="{Binding CanEdit}"
                                    Content="{Binding L[edit]}" />
                            <TextBlock Text="{Binding L[reward_history]}" FontWeight="SemiBold" FontSize="12.5" />
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Rewards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:PartnerRewardEntryDto">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding State}" FontSize="12" />
                                                <TextBlock Text="{Binding OccurredAt, StringFormat='{}{0:dd.MM.yyyy}', Mode=OneWay}"
                                                           Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N0}', Mode=OneWay}"
                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>

        <ProgressBar IsIndeterminate="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Height="3" VerticalAlignment="Top" />

        <Border IsVisible="{Binding IsEditOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CloseEditCommand}">
          <Border Classes="form" Background="{DynamicResource CardBg}" CornerRadius="14" Width="440"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  c:FormBehaviors.AutoFocus="True"
                  c:FormBehaviors.EscCancels="{Binding CloseEditCommand}">
            <StackPanel Margin="24" Spacing="10">
                <TextBlock Text="{Binding L[partner]}" FontSize="18" FontWeight="Bold" />
                <TextBox Text="{Binding EditName}" Watermark="{Binding L[full_name]}" MinHeight="38" />
                <TextBox Text="{Binding EditPhone}" Watermark="{Binding L[phone]}" MinHeight="38" />
                <TextBox Text="{Binding EditAddress}" Watermark="{Binding L[address]}" MinHeight="38" />
                <TextBox Text="{Binding EditNote}" Watermark="{Binding L[note]}" MinHeight="38" />
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsNew}">
                    <TextBlock Text="{Binding L[active]}" VerticalAlignment="Center" FontSize="12.5" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EditEnabled}" />
                </Grid>
                <TextBlock Text="{Binding L[specialties]}" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondary}" />
                <ItemsControl ItemsSource="{Binding Specialties}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpecialtyChoice">
                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="0,0,12,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                    <Button Grid.Column="1" Classes="outline" MinHeight="38" Padding="16,0"
                            Command="{Binding CloseEditCommand}" Content="{Binding L[cancel]}" />
                    <Button Grid.Column="2" Classes="brand" MinHeight="38" Padding="16,0"
                            Command="{Binding SaveCommand}" Content="{Binding L[save]}" />
                </Grid>
            </StackPanel>
          </Border>
        </Border>

        <Border IsVisible="{Binding IsSpecialtyOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CloseSpecialtiesCommand}">
          <Border Classes="form" Background="{DynamicResource CardBg}" CornerRadius="14" Width="400"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  c:FormBehaviors.EscCancels="{Binding CloseSpecialtiesCommand}">
            <StackPanel Margin="24" Spacing="10">
                <TextBlock Text="{Binding L[specialties]}" FontSize="18" FontWeight="Bold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding SpecialtyName}" Watermark="{Binding L[name]}" MinHeight="38" />
                    <Button Grid.Column="1" Classes="brand" MinHeight="38" Padding="14,0"
                            Command="{Binding AddSpecialtyCommand}" Content="{Binding L[add]}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding AllSpecialties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="p:PartnerSpecialtyDto">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding $parent[ItemsControl].((vm:PartnersViewModel)DataContext).ToggleSpecialtyCommand}"
                                              CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="outline" HorizontalAlignment="Right" MinHeight="38" Padding="16,0"
                        Command="{Binding CloseSpecialtiesCommand}" Content="{Binding L[close]}" />
            </StackPanel>
          </Border>
        </Border>
    </Panel>
</UserControl>
