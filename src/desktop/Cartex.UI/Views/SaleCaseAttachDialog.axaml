<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:views="using:Cartex.UI.Views"
             xmlns:tc="using:Cartex.Shared.Models.TradeCases"
             x:Class="Cartex.UI.Views.SaleCaseAttachDialog"
             x:Name="RootAttach"
             x:DataType="vm:SaleCaseAttachViewModel"
             x:CompileBindings="True">
    <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="480" MaxHeight="480"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            BoxShadow="0 18 50 0 #33000000" Padding="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
                <TextBlock Text="{Binding L[tc_attach_title]}" Classes="h2" />
                <TextBlock Text="{Binding CustomerDisplay}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Classes="outline" Command="{Binding CancelCommand}" Content="{Binding L[cancel]}" />
                <Button Classes="brand" IsVisible="{Binding IsCreating}"
                        Command="{Binding CreateAndPickCommand}" Content="{Binding L[tc_create_and_link]}" />
            </StackPanel>

            <Grid>
                <!-- CASE LIST -->
                <DockPanel IsVisible="{Binding !IsCreating}">
                    <Button DockPanel.Dock="Bottom" Classes="outline" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                            Command="{Binding StartCreateCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                <TextBlock Text="{Binding L[tc_create_new]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <TextBlock Text="{Binding L[tc_none_open]}" Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"
                               IsVisible="{Binding !HasOpenCases}" />

                    <ScrollViewer IsVisible="{Binding HasOpenCases}">
                        <ItemsControl ItemsSource="{Binding OpenCases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tc:TradeCaseListDto">
                                    <Button Background="Transparent" BorderThickness="0" Padding="12,9" Cursor="Hand"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6"
                                            Command="{Binding #RootAttach.((vm:SaleCaseAttachViewModel)DataContext).SelectCaseCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding CaseNumber}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                                    <TextBlock Text="·" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                                    <TextBlock Text="{Binding BusinessDate, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding EstimatedOutstandingAmount, StringFormat='{}{0:N0}'}"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="{Binding Currency}"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- CASE CREATION FORM -->
                <ScrollViewer IsVisible="{Binding IsCreating}">
                    <StackPanel Spacing="12">
                        <Button Classes="icon" HorizontalAlignment="Left" Command="{Binding BackToListCommand}"
                                IsVisible="{Binding HasOpenCases}">
                            <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" />
                        </Button>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding L[tc_title_label]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding Title, Mode=TwoWay}" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding L[tc_site_address]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding SiteAddress, Mode=TwoWay}" MinHeight="40" PlaceholderText="{Binding L[optional]}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
