<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:tc="using:Cartex.Shared.Models.TradeCases"
             x:Class="Cartex.UI.Views.SaleCaseAttachDialog"
             x:DataType="vm:SaleCaseAttachViewModel"
             x:CompileBindings="True">
    <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="520" MaxHeight="620"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            BoxShadow="0 18 50 0 #33000000" Padding="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,14">
                <TextBlock Text="{Binding L[tc_attach_title]}" Classes="h2" />
                <TextBlock Text="{Binding CustomerDisplay}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="outline" Command="{Binding CancelCommand}" Content="{Binding L[cancel]}" />
                <Button Classes="brand" IsVisible="{Binding IsCreating}"
                        Command="{Binding CreateAndPickCommand}" Content="{Binding L[tc_create_and_link]}" />
            </StackPanel>

            <StackPanel Spacing="12">
                <StackPanel IsVisible="{Binding !IsCreating}" Spacing="10">
                    <ScrollViewer MaxHeight="340">
                        <ItemsControl ItemsSource="{Binding OpenCases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tc:TradeCaseListDto">
                                    <Button Background="Transparent" BorderThickness="0" Padding="12,9" Cursor="Hand"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6"
                                            Command="{Binding $parent[ItemsControl].((vm:SaleCaseAttachViewModel)DataContext).SelectCaseCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12">
                                                    <Run Text="{Binding CaseNumber}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding BusinessDate, StringFormat='dd.MM.yyyy'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}">
                                                <Run Text="{Binding EstimatedOutstandingAmount, StringFormat=\{0:N0\}}" />
                                                <Run Text="{Binding Currency}" />
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding L[tc_none_open]}" Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !HasOpenCases}" />
                    <Button Classes="outline" HorizontalAlignment="Stretch" Content="{Binding L[tc_create_new]}"
                            Command="{Binding StartCreateCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                <TextBlock Text="{Binding L[tc_create_new]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsCreating}" Spacing="12">
                    <Button Classes="icon" HorizontalAlignment="Left" Command="{Binding BackToListCommand}"
                            IsVisible="{Binding HasOpenCases}">
                        <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" />
                    </Button>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[tc_title_label]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding Title, Mode=TwoWay}" MinHeight="40" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[tc_site_address]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding SiteAddress, Mode=TwoWay}" MinHeight="40" PlaceholderText="{Binding L[optional]}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
