<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.CustomersView"
             c:Shortcuts.Source="{Binding Shortcuts}"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Border.segwrap">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.seg.active">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.debtcard">
            <Setter Property="Background" Value="{DynamicResource DangerBg}" />
        </Style>
        <Style Selector="Border.debtcard.credit">
            <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
        </Style>
        <Style Selector="TextBlock.debtamount">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.debtamount.credit">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <DockPanel Margin="24" Classes.blurred="{Binding IsModalOpen}" IsVisible="{Binding !IsProfileOpen}">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[customers]}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
                    <Button Classes="brand" Command="{Binding OpenCreateCommand}" IsVisible="{Binding CanCreate}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[add]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,0,0,16">
                <c:StatCard Grid.Column="0" Title="{Binding L[customers]}" Icon="AccountGroup"
                            Value="{Binding Totals.Count, StringFormat='{}{0:N0}'}" />
                <c:StatCard Grid.Column="1" Title="{Binding L[total_debt]}" Icon="CashMinus"
                            Accent="{DynamicResource DangerBrush}"
                            Value="{Binding Totals.TotalDebt, StringFormat='{}{0:N0}'}" />
                <c:StatCard Grid.Column="2" Title="{Binding L[bonus]}" Icon="GiftOutline"
                            Accent="{DynamicResource SuccessBrush}"
                            Value="{Binding Totals.TotalBonus, StringFormat='{}{0:N0}'}" />
            </Grid>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,12" ColumnDefinitions="*,Auto,Auto">
                <TextBox Classes="search" MaxWidth="420" HorizontalAlignment="Left"
                         PlaceholderText="{Binding L[search]}" Text="{Binding SearchText, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="130" VerticalAlignment="Stretch"
                          ItemsSource="{Binding Paging.SortOptions}" SelectedItem="{Binding Paging.SelectedSort}" />
                <Button Grid.Column="2" Classes="icon" Margin="6,0,0,0" Command="{Binding Paging.ToggleDirectionCommand}"
                        ToolTip.Tip="{Binding L[sort]}">
                    <Panel>
                        <mi:MaterialIcon Kind="SortAscending" Width="18" Height="18" IsVisible="{Binding !Paging.Descending}" />
                        <mi:MaterialIcon Kind="SortDescending" Width="18" Height="18" IsVisible="{Binding Paging.Descending}" />
                    </Panel>
                </Button>
            </Grid>
            <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}" Margin="0,12,0,0" />
            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              c:GridDoubleClick.Command="{Binding OpenProfileCommand}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="1.5*"
                                                    Header="{Binding [full_name], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding FullName}" />
                                            <TextBlock Text="{Binding LastName}" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Phone}"
                                                Header="{Binding [phone], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="1.2*"
                                                    Header="{Binding [debt], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding DebtBalance, Converter={x:Static conv:DebtBalanceConverter.Instance}, ConverterParameter=kind}"
                                                       IsVisible="{Binding DebtBalance, Converter={x:Static conv:DebtBalanceConverter.Instance}, ConverterParameter=haskind}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DebtBalance, Converter={x:Static conv:DebtBalanceConverter.Instance}}"
                                                       Foreground="{Binding DebtBalance, Converter={x:Static conv:DebtBalanceConverter.Instance}, ConverterParameter=brush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding CashbackBalance, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [bonus], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="0.8*"
                                                    Header="{Binding [discount_pct], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Panel Margin="12,0" VerticalAlignment="Center">
                                            <Border CornerRadius="8" Padding="8,2" HorizontalAlignment="Left"
                                                    Background="{DynamicResource SuccessBg}"
                                                    IsVisible="{Binding DiscountPct, Converter={x:Static conv:IsZeroConverter.Instance}, ConverterParameter=not}">
                                                <TextBlock Text="{Binding DiscountPct, StringFormat='{}{0}%'}" FontSize="12"
                                                           Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="—" Foreground="{DynamicResource TextMuted}"
                                                       IsVisible="{Binding DiscountPct, Converter={x:Static conv:IsZeroConverter.Instance}}" />
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding CreditLimit, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [credit_limit], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="icon" Margin="6,0"
                                                IsVisible="{Binding $parent[DataGrid].DataContext.CanEdit}"
                                                Command="{Binding $parent[DataGrid].DataContext.OpenEditCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[edit]}">
                                            <mi:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                                             Foreground="{DynamicResource TextSecondary}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="AccountGroup" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
            </Panel>
        </DockPanel>

        <DockPanel Margin="24" Classes.blurred="{Binding IsModalOpen}" IsVisible="{Binding IsProfileOpen}">
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,14,Auto,16,*,Auto">
                    <Button Classes="icon" Command="{Binding CloseProfileCommand}" ToolTip.Tip="{Binding L[back]}"
                            VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                    </Button>
                    <Border Grid.Column="2" Width="56" Height="56" CornerRadius="28" VerticalAlignment="Center"
                            Background="{DynamicResource BrandPrimaryBrush}">
                        <TextBlock Text="{Binding SelectedInitials}" Foreground="White" FontWeight="Bold"
                                   FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="4" Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="{Binding SelectedCustomerDisplay.FullName}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding SelectedCustomerDisplay.LastName}" FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="PhoneOutline" Width="15" Height="15" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedCustomerDisplay.Phone}" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding SelectedCustomerDisplay.Address, Converter={x:Static conv:StringNotEmptyConverter.Instance}}">
                                <mi:MaterialIcon Kind="MapMarkerOutline" Width="15" Height="15" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedCustomerDisplay.Address}" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding SelectedCustomerDisplay.CardBarcode, Converter={x:Static conv:StringNotEmptyConverter.Instance}}">
                                <mi:MaterialIcon Kind="CardAccountDetailsOutline" Width="15" Height="15" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedCustomerDisplay.CardBarcode}" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="SaleOutline" Width="15" Height="15" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedCustomerDisplay.DiscountPct, StringFormat='{}{0}%'}" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="brand" Command="{Binding OpenRepayCommand}" IsVisible="{Binding CanRepay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="CashCheck" Width="17" Height="17" />
                                <TextBlock Text="{Binding L[repay_debt]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="outline" Command="{Binding OpenPayOutCommand}" IsVisible="{Binding CanPayOut}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="CashMinus" Width="17" Height="17" />
                                <TextBlock Text="{Binding L[pay_out]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="outline" Command="{Binding OpenEditCommand}" CommandParameter="{Binding SelectedCustomer}"
                                IsVisible="{Binding CanEdit}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Pencil" Width="16" Height="16" />
                                <TextBlock Text="{Binding L[edit]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="outline" Command="{Binding OpenMessageCommand}" IsVisible="{Binding CanMessage}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="SendOutline" Width="17" Height="17" />
                                <TextBlock Text="{Binding L[customer_message]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,0,0,16">
                <Border Grid.Column="0" Classes="debtcard" Classes.credit="{Binding SelectedIsCredit}"
                        CornerRadius="12" Padding="18">
                    <StackPanel Spacing="4">
                        <Panel>
                            <TextBlock Text="{Binding L[debt]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                                       IsVisible="{Binding !SelectedIsCredit}" />
                            <TextBlock Text="{Binding L[opening_kind_credit]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                                       IsVisible="{Binding SelectedIsCredit}" />
                        </Panel>
                        <TextBlock Classes="debtamount" Classes.credit="{Binding SelectedIsCredit}"
                                   Text="{Binding SelectedDebtAmount, StringFormat='{}{0:N0}'}"
                                   FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource SuccessBg}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding L[bonus]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding SelectedCustomerDisplay.CashbackBalance, StringFormat='{}{0:N0}'}"
                                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="18"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding L[credit_limit]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding SelectedCustomerDisplay.CreditLimit, StringFormat='{}{0:N0}'}"
                                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="18,14"
                    Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    IsVisible="{Binding ShowPartner}">
                <Grid ColumnDefinitions="Auto,10,Auto,*,Auto">
                    <mi:MaterialIcon Kind="HandshakeOutline" Width="18" Height="18" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Grid.Column="2" Text="{Binding L[partner]}" VerticalAlignment="Center"
                               FontSize="13.5" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Classes="outline" Command="{Binding OpenPublicityCommand}"
                                IsVisible="{Binding CanOpenPublicity}" Content="{Binding L[public_page]}" />
                        <ToggleSwitch IsChecked="{Binding IsPartner, Mode=OneWay}" IsEnabled="{Binding CanEditPartner}"
                                      Command="{Binding TogglePartnershipCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Panel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="{Binding L[recent_transactions]}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextPrimary}" IsVisible="{Binding !CanViewSales}" />
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding CanViewSales}">
                    <Border Classes="segwrap">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="seg" Classes.active="{Binding IsLedgerTab}" Content="{Binding L[recent_transactions]}"
                                    Command="{Binding SetTabCommand}" CommandParameter="ledger" />
                            <Button Classes="seg" Classes.active="{Binding IsSalesTab}" Content="{Binding L[sales]}"
                                    Command="{Binding SetTabCommand}" CommandParameter="sales" />
                            <Button Classes="seg" Classes.active="{Binding IsStatementTab}" Content="{Binding L[statement]}"
                                    Command="{Binding SetTabCommand}" CommandParameter="statement"
                                    IsVisible="{Binding CanViewStatement}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                IsVisible="{Binding IsStatementTab}">
                        <TextBlock Text="{Binding L[date_from]}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                        <DatePicker SelectedDate="{Binding StatementFrom, Mode=TwoWay}" MinWidth="140" MinHeight="34" />
                        <TextBlock Text="{Binding L[date_to]}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                        <DatePicker SelectedDate="{Binding StatementTo, Mode=TwoWay}" MinWidth="140" MinHeight="34" />
                        <Button Classes="outline" MinHeight="34" Padding="12,0"
                                Command="{Binding OpenConsolidatedActCommand}"
                                IsVisible="{Binding CanBuildAct}"
                                ToolTip.Tip="{Binding L[consolidated_act_hint]}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="FileDocumentMultipleOutline" Width="15" Height="15" />
                                <TextBlock Text="{Binding L[consolidated_act]}" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <c:ExportButton Command="{Binding ExportStatementCommand}" Text="{Binding L[export]}"
                                        IsVisible="{Binding CanExportStatement}" />
                    </StackPanel>
                </Grid>
            </Panel>
            <c:Pager DockPanel.Dock="Bottom" State="{Binding LedgerPaging}" Margin="0,10,0,0" IsVisible="{Binding IsLedgerTab}" />
            <c:Pager DockPanel.Dock="Bottom" State="{Binding SalesPaging}" Margin="0,10,0,0" IsVisible="{Binding IsSalesTab}" />
            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding IsLedgerTab}">
                    <Panel>
                        <DataGrid ItemsSource="{Binding Ledger}" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  c:GridDoubleClick.Command="{Binding OpenLedgerEntryCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                    Header="{Binding [time], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="1.3*" Binding="{Binding OperationType, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=op}"
                                                    Header="{Binding [operation_type], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="*" Binding="{Binding AccountType, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=acct}"
                                                    Header="{Binding [type], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTemplateColumn Width="*"
                                                        Header="{Binding [balance_change], Source={x:Static svc:LocalizationManager.Instance}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="{Binding Change, StringFormat='{}{0:N0}'}" />
                                                <TextBlock Text="{Binding Currency}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"
                                                           IsVisible="{Binding Currency, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="*"
                                                        Header="{Binding [balance], Source={x:Static svc:LocalizationManager.Instance}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="{Binding BalanceAfter, StringFormat='{}{0:N0}'}" />
                                                <TextBlock Text="{Binding Currency}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"
                                                           IsVisible="{Binding Currency, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ProgressBar IsIndeterminate="{Binding IsLedgerLoading}" IsVisible="{Binding IsLedgerLoading}" Height="3" VerticalAlignment="Top" />
                    </Panel>
                </Border>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding IsSalesTab}">
                    <Panel>
                        <DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  c:GridDoubleClick.Command="{Binding OpenReceiptCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding SaleDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                    Header="{Binding [time], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="1.2*" Binding="{Binding UserName}"
                                                    Header="{Binding [cashier], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="*" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}'}"
                                                    Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="*" Binding="{Binding DebtAmount, StringFormat='{}{0:N0}'}"
                                                    Header="{Binding [debt], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="*" Binding="{Binding Status}"
                                                    Header="{Binding [status], Source={x:Static svc:LocalizationManager.Instance}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ProgressBar IsIndeterminate="{Binding IsSalesLoading}" IsVisible="{Binding IsSalesLoading}" Height="3" VerticalAlignment="Top" />
                    </Panel>
                </Border>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding IsStatementTab}">
                    <Panel>
                        <DockPanel Margin="14">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" Margin="0,0,0,12">
                                <c:StatCard Icon="CashRegister" Title="{Binding L[statement_sales]}"
                                            Value="{Binding Statement.Summary.SaleAmount, StringFormat='{}{0:N0}'}" />
                                <c:StatCard Grid.Column="1" Icon="CashCheck" Title="{Binding L[statement_payments]}"
                                            Value="{Binding Statement.Summary.PaymentAmount, StringFormat='{}{0:N0}'}" />
                                <c:StatCard Grid.Column="2" Icon="KeyboardReturn" Title="{Binding L[statement_returns]}"
                                            Value="{Binding Statement.Summary.ReturnAmount, StringFormat='{}{0:N0}'}" />
                                <c:StatCard Grid.Column="3" Icon="CashRefund" Title="{Binding L[statement_refunds]}"
                                            Value="{Binding Statement.Summary.RefundAmount, StringFormat='{}{0:N0}'}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding Statement.Timeline}" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  c:GridDoubleClick.Command="{Binding OpenStatementEntryCommand}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*" Binding="{Binding OccurredAt, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                        Header="{Binding [time], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    <DataGridTextColumn Width="*" Binding="{Binding DocumentNumber}"
                                                        Header="{Binding [ret_document], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    <DataGridTextColumn Width="1.4*" Binding="{Binding Summary}"
                                                        Header="{Binding [operation_type], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Debit, StringFormat='{}{0:N0}'}"
                                                        Header="{Binding [debit], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Credit, StringFormat='{}{0:N0}'}"
                                                        Header="{Binding [credit], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    <DataGridTextColumn Width="*" Binding="{Binding RunningBalance, StringFormat='{}{0:N0}'}"
                                                        Header="{Binding [balance], Source={x:Static svc:LocalizationManager.Instance}}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <ProgressBar IsIndeterminate="{Binding IsStatementLoading}" IsVisible="{Binding IsStatementLoading}" Height="3" VerticalAlignment="Top" />
                    </Panel>
                </Border>
            </Panel>
        </DockPanel>

        <ProgressBar IsIndeterminate="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Height="3" VerticalAlignment="Top" />

        <c:ModalCard IsOpen="{Binding IsEditOpen}" Title="{Binding EditTitle}" CardWidth="560"
                     CancelCommand="{Binding CancelEditCommand}" SaveCommand="{Binding SaveCommand}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <c:FieldLabel Text="{Binding L[first_name]}" Required="True" />
                            <TextBox Text="{Binding EditFullName}" MinHeight="38" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{Binding L[last_name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding EditLastName}" MinHeight="38" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <c:FieldLabel Text="{Binding L[phone]}" Required="True" />
                            <TextBox Text="{Binding EditPhone}" MinHeight="38" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{Binding L[email]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding EditEmail}" MinHeight="38" PlaceholderText="mijoz@example.com" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="{Binding L[address]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding EditAddress}" MinHeight="38" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{Binding L[card_barcode]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding EditCardBarcode}" MinHeight="38" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="{Binding L[discount_pct]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <NumericUpDown Value="{Binding EditDiscountPct, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Maximum="100" Increment="1" FormatString="0.##" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{Binding L[credit_limit]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <NumericUpDown Value="{Binding EditCreditLimit}" Minimum="0" Increment="100000" FormatString="N0" Watermark="{Binding L[unlimited]}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[customer_language]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding CustomerLanguages}" SelectedItem="{Binding EditLanguage}"
                                  MinWidth="160" MinHeight="36" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[description]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding EditNote}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="70" MaxHeight="140" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding EditNotificationsOptOut}" Content="{Binding L[notifications_opt_out]}" />
                    <StackPanel Spacing="5" IsVisible="{Binding IsNew}">
                        <TextBlock Text="{Binding L[opening_balance]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <Grid ColumnDefinitions="*,8,Auto,Auto">
                            <NumericUpDown Value="{Binding EditOpeningBalance, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="10000" FormatString="N0" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding OpeningKinds}" SelectedIndex="{Binding EditOpeningKindIndex}"
                                      MinHeight="36" MinWidth="130" />
                            <ComboBox Grid.Column="3" ItemsSource="{Binding PayCurrencies}" SelectedItem="{Binding EditOpeningCurrency}"
                                      MinHeight="36" MinWidth="80" Margin="8,0,0,0" IsVisible="{Binding IsMulticurrency}" />
                        </Grid>
                        <TextBlock Text="{Binding L[opening_balance_hint]}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
        </c:ModalCard>

        <c:ModalCard IsOpen="{Binding IsMessageOpen}" Title="{Binding L[customer_message]}" CardWidth="560"
                     CancelCommand="{Binding CancelMessageCommand}" SaveCommand="{Binding SendMessageCommand}"
                     SaveText="{Binding L[send]}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[channel]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding MessageChannels}" SelectedValue="{Binding MessageChannel}"
                                  SelectedValueBinding="{Binding Code}" DisplayMemberBinding="{Binding Label}"
                                  HorizontalAlignment="Stretch" MinHeight="38" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[message_text]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding MessageText}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000" />
                    </StackPanel>
                </StackPanel>
        </c:ModalCard>

        <c:ModalCard IsOpen="{Binding IsPublicityOpen}" Title="{Binding L[public_page]}" CardWidth="520"
                     Subtitle="{Binding SelectedCustomerDisplay.FullName}"
                     CancelCommand="{Binding CancelPublicityCommand}" SaveCommand="{Binding SavePublicityCommand}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding L[public_consent_hint]}" Foreground="{DynamicResource TextMuted}"
                               FontSize="11.5" TextWrapping="Wrap" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[consent]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding ConsentOptions}" SelectedIndex="{Binding ConsentIndex}"
                                  HorizontalAlignment="Stretch" MinHeight="38" />
                    </StackPanel>
                    <StackPanel Spacing="14" IsVisible="{Binding ConsentGranted}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding L[show_on_public_page]}" VerticalAlignment="Center" FontSize="12.5" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PublicVisible}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding L[show_phone_publicly]}" VerticalAlignment="Center" FontSize="12.5" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PublicPhoneVisible}" />
                        </Grid>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding L[public_display_name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding PublicDisplayName}" MinHeight="38" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding L[public_about]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding PublicAbout}" MinHeight="80" AcceptsReturn="True"
                                     TextWrapping="Wrap" MaxLength="600" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
        </c:ModalCard>

        <c:ModalCard IsOpen="{Binding IsPayOutOpen}" Title="{Binding L[pay_out]}" CardWidth="520"
                     Subtitle="{Binding SelectedCustomerDisplay.FullName}"
                     CancelCommand="{Binding CancelPayOutCommand}" SaveCommand="{Binding PayOutCommand}">
                <StackPanel Spacing="14">
                    <Border Classes="debtcard" CornerRadius="12" Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding L[advance]}" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding PayOutAdvance, StringFormat='{}{0:N0}'}"
                                       FontSize="20" FontWeight="Bold" />
                        </Grid>
                    </Border>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[amount]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <NumericUpDown Value="{Binding PayOutAmount, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                       Minimum="0" Increment="1000" FormatString="N0" ShowButtonSpinner="False"
                                       FontSize="18" MinHeight="44" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[payment_method]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ToggleSwitch IsChecked="{Binding PayOutViaCard}"
                                      OffContent="{Binding L[cash]}" OnContent="{Binding L[card]}" />
                    </StackPanel>
                    <TextBox Text="{Binding PayOutNote}" PlaceholderText="{Binding L[note]}" MinHeight="38" />
                    <Border IsVisible="{Binding PayOutCreatesLoan}" Background="{DynamicResource WarningBg}"
                            CornerRadius="10" Padding="12,9">
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}">
                            <Run Text="{Binding L[pay_out_becomes_loan]}" />
                            <Run Text="{Binding PayOutAsLoan, StringFormat='{}{0:N0}'}" FontWeight="Bold" />
                        </TextBlock>
                    </Border>
                </StackPanel>
        </c:ModalCard>

        <c:ModalCard IsOpen="{Binding IsRepayOpen}" Title="{Binding L[repay_debt]}" CardWidth="560"
                     Subtitle="{Binding SelectedCustomerDisplay.FullName}"
                     CancelCommand="{Binding CancelRepayCommand}" SaveCommand="{Binding RepayCommand}">
                <StackPanel Spacing="14">
                    <Border Classes="debtcard" CornerRadius="12" Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding L[debt]}" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Classes="debtamount" FontSize="20" FontWeight="Bold"
                                           Text="{Binding RepayDebtTotal, StringFormat='{}{0:N0}'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding L[remaining]}" FontSize="12.5" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding RepayRemaining, StringFormat='{}{0:N0}'}"
                                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding IsMulticurrency}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding L[debt_currency]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ComboBox ItemsSource="{Binding RepayDebtCurrencies}" SelectedItem="{Binding RepayDebtCurrency}"
                                      HorizontalAlignment="Stretch" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{Binding L[pay_currency]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ComboBox ItemsSource="{Binding PayCurrencies}" SelectedItem="{Binding RepayPayCurrency}"
                                      HorizontalAlignment="Stretch" MinHeight="36" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[amount]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <Grid ColumnDefinitions="Auto,6,*">
                            <Button Classes="icon" Command="{Binding FillRepayAmountCommand}"
                                    ToolTip.Tip="{Binding L[repay_full_debt]}" VerticalAlignment="Stretch">
                                <mi:MaterialIcon Kind="Sigma" Width="18" Height="18" />
                            </Button>
                            <NumericUpDown Grid.Column="2" Value="{Binding RepayAmount, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="1000" FormatString="N0" ShowButtonSpinner="False" FontSize="18" MinHeight="44" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[payment_method]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ToggleSwitch IsChecked="{Binding RepayViaCard}"
                                      OffContent="{Binding L[cash]}" OnContent="{Binding L[card]}" />
                    </StackPanel>
                    <Border IsVisible="{Binding RepayIsOverpay}" Background="{DynamicResource SuccessBg}"
                            CornerRadius="10" Padding="12,9">
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}">
                            <Run Text="{Binding L[advance], Mode=OneWay}" />
                            <Run Text="{Binding RepayOverpayAmount, StringFormat='{}{0:N0}', Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
        </c:ModalCard>
    </Panel>
</UserControl>
