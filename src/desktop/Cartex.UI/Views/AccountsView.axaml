<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             x:Class="Cartex.UI.Views.AccountsView"
             x:CompileBindings="False">

    <DockPanel Margin="24">
        <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[accounts]}" Margin="0,0,0,16">
            <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
        </c:PageHeader>
        <TextBox DockPanel.Dock="Top" Classes="search" Margin="0,0,0,14"
                 PlaceholderText="{Binding L[search]}" Text="{Binding SearchText, Mode=TwoWay}" />
        <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="{Binding Totals.TotalBalance, StringFormat='{}{0:N0}'}" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrandPrimaryBrush}" />
            </StackPanel>
        </c:Pager>
        <Panel>
            <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding Name}"
                                            Header="{Binding [name], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding Type}"
                                            Header="{Binding [type], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="*" Binding="{Binding OwnerName}"
                                            Header="{Binding [owner], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding Currency}"
                                            Header="{Binding [currency], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding Balance, StringFormat='{}{0:N0}'}"
                                            Header="{Binding [balance], Source={x:Static svc:LocalizationManager.Instance}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <c:EmptyState Icon="WalletOutline" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
        </Panel>
    </DockPanel>
</UserControl>
