<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:vm="using:Cartex.UI.ViewModels"
             x:Class="Cartex.UI.Views.GoodsReturnDialog"
             x:DataType="vm:GoodsReturnViewModel"
             x:CompileBindings="True">
    <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="720" MaxHeight="700"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            BoxShadow="0 18 50 0 #33000000" Padding="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding L[tc_return]}" Classes="h2" Margin="0,0,0,16" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="outline" Command="{Binding CancelCommand}" Content="{Binding L[cancel]}" />
                <Button Classes="brand" Command="{Binding SubmitCommand}" Content="{Binding L[tc_return]}"
                        IsEnabled="{Binding HasReturnable}" />
            </StackPanel>

            <Border Background="{DynamicResource AppBg}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,90,110,150,*" Background="{DynamicResource SidebarItemHover}">
                        <TextBlock Text="{Binding L[product]}" FontWeight="SemiBold" Padding="12,8" />
                        <TextBlock Grid.Column="1" Text="{Binding L[tc_custody]}" FontWeight="SemiBold" Padding="8" />
                        <TextBlock Grid.Column="2" Text="{Binding L[quantity]}" FontWeight="SemiBold" Padding="8" />
                        <TextBlock Grid.Column="3" Text="{Binding L[tc_condition]}" FontWeight="SemiBold" Padding="8" />
                        <TextBlock Grid.Column="4" Text="{Binding L[reason]}" FontWeight="SemiBold" Padding="8" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="420">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GoodsReturnLineRow">
                                    <Grid ColumnDefinitions="*,90,110,150,*" MinHeight="46">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,6,8,6" Spacing="2">
                                            <TextBlock Text="{Binding Line.ProductName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Line.UnitName}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Padding="8"
                                                   Text="{Binding CustodyQuantity, StringFormat='{}{0:0.###}'}" />
                                        <NumericUpDown Grid.Column="2" VerticalAlignment="Center" Margin="4"
                                                       Value="{Binding Quantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                                       Minimum="0" Maximum="{Binding CustodyQuantity}"
                                                       Increment="{Binding Line.QuantityStep}" FormatString="0.###"
                                                       ShowButtonSpinner="False" />
                                        <ComboBox Grid.Column="3" VerticalAlignment="Center" Margin="4"
                                                  ItemsSource="{Binding $parent[ItemsControl].((vm:GoodsReturnViewModel)DataContext).ConditionOptions}"
                                                  SelectedIndex="{Binding ConditionIndex}" />
                                        <TextBox Grid.Column="4" VerticalAlignment="Center" Margin="4,4,12,4"
                                                 Text="{Binding Reason, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
