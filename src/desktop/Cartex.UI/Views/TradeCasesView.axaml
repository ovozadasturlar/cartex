<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:tc="using:Cartex.Shared.Models.TradeCases"
             x:Class="Cartex.UI.Views.TradeCasesView"
             x:DataType="vm:TradeCasesViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.chip.active">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="24">
        <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[trade_cases]}" Margin="0,0,0,16">
            <Button Classes="brand" Command="{Binding OpenCreateCommand}" IsVisible="{Binding CanCreate}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                    <TextBlock Text="{Binding L[tc_new_case]}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </c:PageHeader>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16" VerticalAlignment="Center">
            <TextBox Width="260" MinHeight="36" PlaceholderText="{Binding L[search]}"
                     Text="{Binding SearchText, Mode=TwoWay}">
                <TextBox.InnerLeftContent>
                    <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0"
                                     Foreground="{DynamicResource TextMuted}" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <Button Classes="chip" Classes.active="{Binding IsAllActive}"
                    Command="{Binding SetStatusCommand}" CommandParameter=""
                    Content="{Binding L[all]}" />
            <Button Classes="chip" Classes.active="{Binding IsOpenActive}"
                    Command="{Binding SetStatusCommand}" CommandParameter="Open"
                    Content="{Binding L[tc_status_open]}" />
            <Button Classes="chip" Classes.active="{Binding IsPendingActive}"
                    Command="{Binding SetStatusCommand}" CommandParameter="SettlementPending"
                    Content="{Binding L[tc_status_settlementpending]}" />
            <Button Classes="chip" Classes.active="{Binding IsSettledActive}"
                    Command="{Binding SetStatusCommand}" CommandParameter="Settled"
                    Content="{Binding L[tc_status_settled]}" />
            <Button Classes="chip" Classes.active="{Binding IsCancelledActive}"
                    Command="{Binding SetStatusCommand}" CommandParameter="Cancelled"
                    Content="{Binding L[tc_status_cancelled]}" />
            <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="{Binding L[refresh]}">
                <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" />
            </Button>
        </StackPanel>

        <Panel>
            <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Cases}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          c:GridDoubleClick.Command="{Binding OpenDetailCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="Auto" Binding="{Binding CaseNumber}"
                                            Header="{Binding [tc_case_number], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding BusinessDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}"
                                            Header="{Binding [date], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="*" Binding="{Binding Title}"
                                            Header="{Binding [tc_title_label], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="*" Binding="{Binding CustomerName}"
                                            Header="{Binding [customer], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding CustodyQuantity, StringFormat='{}{0:0.###}'}"
                                            Header="{Binding [tc_custody], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTemplateColumn Width="Auto"
                                                Header="{Binding [tc_custody_amount], Source={x:Static svc:LocalizationManager.Instance}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="tc:TradeCaseListDto">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding EstimatedOutstandingAmount, StringFormat='{}{0:N0}'}" />
                                        <TextBlock Text="{Binding Currency}" Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto"
                                                Header="{Binding [status], Source={x:Static svc:LocalizationManager.Instance}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="tc:TradeCaseListDto">
                                    <Border BorderBrush="{Binding Status, Converter={x:Static conv:TradeCaseStatusBrushConverter.Instance}}"
                                            BorderThickness="1" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=tc_status}"
                                                   Foreground="{Binding Status, Converter={x:Static conv:TradeCaseStatusBrushConverter.Instance}}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="Auto" Binding="{Binding UpdatedAt, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                            Header="{Binding [tc_updated], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="tc:TradeCaseListDto">
                                    <Button Classes="icon" Margin="4,0"
                                            Command="{Binding $parent[DataGrid].((vm:TradeCasesViewModel)DataContext).OpenDetailCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding $parent[DataGrid].((vm:TradeCasesViewModel)DataContext).L[trade_case]}">
                                        <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18"
                                                         Foreground="{DynamicResource TextSecondary}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <c:EmptyState Icon="BriefcaseClockOutline" Title="{Binding L[tc_empty]}" IsVisible="{Binding IsEmpty}" />
        </Panel>
    </DockPanel>
</UserControl>
