<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             x:Class="Cartex.UI.Views.UnitsView"
             c:Shortcuts.Source="{Binding Shortcuts}"
             x:CompileBindings="False">

    <Panel>
        <DockPanel Margin="24" Classes.blurred="{Binding IsEditOpen}">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[units]}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Classes="search" Width="240" VerticalAlignment="Center"
                             PlaceholderText="{Binding L[search]}" Text="{Binding SearchText}" />
                    <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
                    <Button Classes="brand" Command="{Binding OpenCreateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[add]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader>

            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Units}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              c:GridDoubleClick.Command="{Binding OpenEditCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding Name}"
                                                Header="{Binding [name], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding ShortName}"
                                                Header="{Binding [short_name], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding Dimension}"
                                                Header="{Binding [dimension], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto"
                                                    Header="{Binding [default_unit], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="icon" Margin="6,0" HorizontalAlignment="Center"
                                                Command="{Binding $parent[DataGrid].DataContext.MakeDefaultCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[make_default]}">
                                            <Panel>
                                                <mi:MaterialIcon Kind="Star" Width="16" Height="16" IsVisible="{Binding IsDefault}"
                                                                 Foreground="{DynamicResource BrandPrimaryBrush}" />
                                                <mi:MaterialIcon Kind="StarOutline" Width="16" Height="16" IsVisible="{Binding !IsDefault}"
                                                                 Foreground="{DynamicResource TextMuted}" />
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto"
                                                    Header="{Binding [active], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}" Margin="6,0"
                                                      Command="{Binding $parent[DataGrid].DataContext.ToggleEnabledCommand}"
                                                      CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Panel Margin="6,0">
                                            <Button Classes="icon" IsVisible="{Binding !IsSystem}"
                                                    Command="{Binding $parent[DataGrid].DataContext.OpenEditCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[edit]}">
                                                <mi:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                                                 Foreground="{DynamicResource TextSecondary}" />
                                            </Button>
                                            <Border IsVisible="{Binding IsSystem}" Background="{DynamicResource SidebarItemHover}"
                                                    CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <mi:MaterialIcon Kind="LockOutline" Width="13" Height="13"
                                                                     Foreground="{DynamicResource TextMuted}" />
                                                    <TextBlock Text="{Binding $parent[DataGrid].DataContext.L[system]}" FontSize="11.5"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </StackPanel>
                                            </Border>
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="RulerSquare" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
            </Panel>
        </DockPanel>

        <Border IsVisible="{Binding IsEditOpen}" Background="#30000000">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="440"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Classes="form"
                    c:FormBehaviors.AutoFocus="True"
                    c:FormBehaviors.EnterSubmits="{Binding SaveCommand}"
                    c:FormBehaviors.EscCancels="{Binding CancelEditCommand}">
                <StackPanel Margin="24" Spacing="14">
                    <TextBlock Text="{Binding L[units]}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding EditName}" MinHeight="38" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[short_name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding EditShortName}" MinHeight="38" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[dimension]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding DimensionOptions}" SelectedItem="{Binding EditDimension}"
                                  HorizontalAlignment="Stretch" MinHeight="38" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[factor]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <NumericUpDown Value="{Binding EditFactor, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="1" FormatString="0.####" MinHeight="38" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                        <Button Classes="outline" Command="{Binding CancelEditCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
