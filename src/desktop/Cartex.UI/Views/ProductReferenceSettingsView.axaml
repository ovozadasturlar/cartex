<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:vm="using:Cartex.UI.ViewModels"
             x:Class="Cartex.UI.Views.ProductReferenceSettingsView"
             x:DataType="vm:ProductReferenceSettingsViewModel">
    <DockPanel Margin="24">
        <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[product_reference]}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="outline" Command="{Binding SyncNowCommand}" Content="{Binding L[sync_now]}" />
                <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}" />
            </StackPanel>
        </c:PageHeader>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
                <Border Classes="card" Padding="18">
                    <StackPanel Spacing="12">
                        <ToggleSwitch IsChecked="{Binding IsEnabled}" Content="{Binding L[product_reference_enabled]}" />
                        <TextBlock Text="{Binding L[product_reference_description]}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}" />
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[source_type]}" Classes="caption" />
                                <TextBox Text="Google Sheets" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="{Binding L[sync_schedule]}" Classes="caption" />
                                <ComboBox ItemsSource="{Binding SyncSchedules}" SelectedIndex="{Binding SyncScheduleIndex}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding L[spreadsheet_id]}" Classes="caption" />
                                <TextBox Text="{Binding SpreadsheetId}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="{Binding L[sheet_name]}" Classes="caption" />
                                <TextBox Text="{Binding SheetName}" />
                            </StackPanel>
                        </Grid>
                        <ToggleSwitch IsChecked="{Binding AutoFillPrice}" Content="{Binding L[product_reference_auto_fill_price]}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding L[column_mapping]}" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,10,Auto,10,Auto,10,Auto">
                            <StackPanel Grid.Row="0" Spacing="5"><TextBlock Text="{Binding L[barcode]}" Classes="caption" /><TextBox Text="{Binding BarcodeColumn}" /></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="5"><TextBlock Text="{Binding L[name]}" Classes="caption" /><TextBox Text="{Binding NameColumn}" /></StackPanel>
                            <StackPanel Grid.Row="2" Spacing="5"><TextBlock Text="{Binding L[unit]}" Classes="caption" /><TextBox Text="{Binding UnitColumn}" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="5"><TextBlock Text="{Binding L[category]}" Classes="caption" /><TextBox Text="{Binding CategoryColumn}" /></StackPanel>
                            <StackPanel Grid.Row="4" Spacing="5"><TextBlock Text="{Binding L[manufacturer]}" Classes="caption" /><TextBox Text="{Binding ManufacturerColumn}" /></StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="5"><TextBlock Text="{Binding L[pack_qty]}" Classes="caption" /><TextBox Text="{Binding PackQtyColumn}" /></StackPanel>
                            <StackPanel Grid.Row="6" Spacing="5"><TextBlock Text="{Binding L[price]}" Classes="caption" /><TextBox Text="{Binding PriceColumn}" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding L[sync_status]}" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,6,Auto">
                            <TextBlock Text="{Binding L[last_sync]}" Foreground="{DynamicResource TextMuted}" /><TextBlock Grid.Column="2" Text="{Binding LastSyncedText}" />
                            <TextBlock Grid.Row="2" Text="{Binding L[rows_read]}" Foreground="{DynamicResource TextMuted}" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LastReadCount}" />
                            <TextBlock Grid.Row="4" Text="{Binding L[rows_updated]}" Foreground="{DynamicResource TextMuted}" /><TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding LastUpdatedCount}" />
                            <TextBlock Grid.Row="6" Text="{Binding L[errors]}" Foreground="{DynamicResource TextMuted}" /><TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding LastErrorCount}" />
                            <TextBlock Grid.Row="8" Text="{Binding L[total_rows]}" Foreground="{DynamicResource TextMuted}" /><TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding RowCount}" />
                        </Grid>
                        <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                   IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
