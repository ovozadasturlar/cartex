<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:c="using:Cartex.Shared.Models.Customers"
             x:Class="Cartex.UI.Views.CustomerPickerDialog"
             x:DataType="vm:CustomerPickerViewModel"
             x:CompileBindings="True">
    <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="480" MaxHeight="580"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            BoxShadow="0 18 50 0 #33000000" Padding="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,14">
                <TextBlock Text="{Binding L[pick_customer_title]}" Classes="h2" />
                <TextBlock Text="{Binding L[pick_customer_subtitle]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="outline" Command="{Binding CancelCommand}" Content="{Binding L[cancel]}" />
                <Button Classes="brand" IsVisible="{Binding IsCreating}"
                        Command="{Binding SaveAndSelectCustomerCommand}" Content="{Binding L[save]}" />
            </StackPanel>

            <StackPanel Spacing="12">
                <StackPanel IsVisible="{Binding !IsCreating}" Spacing="10">
                    <TextBox Text="{Binding CustomerSearch, Mode=TwoWay}"
                             PlaceholderText="{Binding L[search_customer_placeholder]}"
                             MinHeight="40">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,6,0"
                                             Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <ScrollViewer MaxHeight="320">
                        <ItemsControl ItemsSource="{Binding CustomerResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="c:CustomerDto">
                                    <Button Background="Transparent" BorderThickness="0" Padding="12,10" Cursor="Hand"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                            Command="{Binding $parent[ItemsControl].((vm:CustomerPickerViewModel)DataContext).SelectCustomerCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="34" Height="34" CornerRadius="17"
                                                    Background="{DynamicResource SidebarItemHover}" Margin="0,0,12,0">
                                                <mi:MaterialIcon Kind="Account" Width="18" Height="18"
                                                                 Foreground="{DynamicResource BrandPrimaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding FullName}" />
                                                    <Run Text="{Binding LastName}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Phone}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       IsVisible="{Binding DebtBalance, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Run Text="{Binding DebtBalance, StringFormat=\{0:N0\}}" />
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Classes="outline" HorizontalAlignment="Stretch" Command="{Binding StartCreateCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="AccountPlus" Width="16" Height="16" />
                                <TextBlock Text="{Binding L[customer_new]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsCreating}" Spacing="12">
                    <Button Classes="icon" HorizontalAlignment="Left" Command="{Binding BackToListCommand}">
                        <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" />
                    </Button>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[first_name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding NewFirstName, Mode=TwoWay}" MinHeight="40" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[last_name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding NewLastName, Mode=TwoWay}" MinHeight="40" PlaceholderText="{Binding L[optional]}" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[phone]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding NewPhone, Mode=TwoWay}" MinHeight="40" PlaceholderText="+998" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
