<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:cc="using:Cartex.UI.Controls"
             xmlns:c="using:Cartex.Shared.Models.Customers"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.CustomerPickerDialog"
             x:Name="RootPicker"
             x:DataType="vm:CustomerPickerViewModel"
             x:CompileBindings="True">
    <Border Background="{DynamicResource CardBg}" CornerRadius="16" Width="620" MinHeight="520" MaxHeight="640"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BoxShadow="0 24 80 0 #44000000">
        <Grid>
            <!-- ================= PICK ================= -->
            <DockPanel IsVisible="{Binding !IsCreating}">
                <!-- Search bar on top -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,18,20,14" ColumnSpacing="10">
                    <TextBox Text="{Binding CustomerSearch, Mode=TwoWay}"
                             PlaceholderText="{Binding L[search_customer_placeholder]}"
                             MinHeight="44" FontSize="14"
                             cc:FormBehaviors.AutoFocus="True">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="12,0,6,0"
                                             Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCommand}"
                            ToolTip.Tip="{Binding L[close]}">
                        <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" />
                    </Button>
                </Grid>

                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" />

                <!-- Add customer sits at the bottom, out of the way -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppBg}" Padding="20,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding L[pick_customer_subtitle]}" VerticalAlignment="Center"
                                   FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}" />
                        <Button Grid.Column="1" Classes="brand" MinHeight="42" Padding="18,0"
                                Command="{Binding StartCreateCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="AccountPlus" Width="17" Height="17" />
                                <TextBlock Text="{Binding L[add_customer]}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Panel>
                    <ScrollViewer Padding="12,8">
                        <ItemsControl ItemsSource="{Binding CustomerResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="c:CustomerDto">
                                    <Button Background="Transparent" BorderThickness="0" Padding="12,11" Cursor="Hand"
                                            CornerRadius="10" Margin="0,0,0,4"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Command="{Binding #RootPicker.((vm:CustomerPickerViewModel)DataContext).SelectCustomerCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    Background="{DynamicResource SidebarItemHover}" Margin="0,0,14,0">
                                                <mi:MaterialIcon Kind="Account" Width="20" Height="20"
                                                                 Foreground="{DynamicResource BrandPrimaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Phone}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2"
                                                        HorizontalAlignment="Right">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           Text="{Binding DebtBalance, StringFormat='{}{0:N0}'}"
                                                           IsVisible="{Binding DebtBalance, Converter={x:Static conv:NonZeroConverter.Instance}}" />
                                                <TextBlock Text="{Binding CashbackBalance, StringFormat='{}{0:N0}'}" FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           IsVisible="{Binding CashbackBalance, Converter={x:Static conv:NonZeroConverter.Instance}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                IsVisible="{Binding !HasSearchResults}">
                        <mi:MaterialIcon Kind="AccountSearchOutline" Width="40" Height="40"
                                         HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding L[no_data]}" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </DockPanel>

            <!-- ================= CREATE ================= -->
            <DockPanel IsVisible="{Binding IsCreating}" cc:FormBehaviors.AutoFocus="True">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="20,18,20,14" ColumnSpacing="10">
                    <Button Classes="icon" Command="{Binding BackToListCommand}">
                        <mi:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding L[add_customer]}" Classes="h2" VerticalAlignment="Center" />
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" />

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppBg}" Padding="20,14">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Classes="outline" MinHeight="42" Padding="18,0"
                                Command="{Binding BackToListCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" MinHeight="42" Padding="20,0"
                                Command="{Binding SaveAndSelectCustomerCommand}" Content="{Binding L[save]}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Padding="20,16">
                    <StackPanel Spacing="14" cc:FormBehaviors.EnterSubmits="{Binding SaveAndSelectCustomerCommand}">
                        <StackPanel Spacing="6">
                            <cc:FieldLabel Text="{Binding L[first_name]}" Required="True" />
                            <TextBox Text="{Binding NewFirstName, Mode=TwoWay}" MinHeight="42" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <cc:FieldLabel Text="{Binding L[last_name]}" />
                            <TextBox Text="{Binding NewLastName, Mode=TwoWay}" MinHeight="42"
                                     PlaceholderText="{Binding L[optional]}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <cc:FieldLabel Text="{Binding L[phone]}" />
                            <TextBox Text="{Binding NewPhone, Mode=TwoWay}" MinHeight="42" PlaceholderText="+998" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
