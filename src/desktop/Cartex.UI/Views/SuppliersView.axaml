<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             x:Class="Cartex.UI.Views.SuppliersView"
             c:Shortcuts.Source="{Binding Shortcuts}"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Border.segwrap">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.seg.active">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.debtcard">
            <Setter Property="Background" Value="{DynamicResource DangerBg}" />
        </Style>
        <Style Selector="Border.debtcard.credit">
            <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
        </Style>
        <Style Selector="TextBlock.debtamount">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.debtamount.credit">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <DockPanel Margin="24" Classes.blurred="{Binding IsModalOpen}">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[suppliers]}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
                    <Button Classes="brand" Command="{Binding OpenCreateCommand}" IsVisible="{Binding CanManage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[add]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader>

            <Grid ColumnDefinitions="380,16,*">
                <DockPanel Grid.Column="0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12" ColumnDefinitions="*,Auto,Auto">
                        <TextBox Classes="search" PlaceholderText="{Binding L[search]}" Text="{Binding SearchText, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="130" VerticalAlignment="Stretch"
                                  ItemsSource="{Binding Paging.SortOptions}" SelectedItem="{Binding Paging.SelectedSort}" />
                        <Button Grid.Column="2" Classes="icon" Margin="6,0,0,0" Command="{Binding Paging.ToggleDirectionCommand}"
                                ToolTip.Tip="{Binding L[sort]}">
                            <Panel>
                                <mi:MaterialIcon Kind="SortAscending" Width="18" Height="18" IsVisible="{Binding !Paging.Descending}" />
                                <mi:MaterialIcon Kind="SortDescending" Width="18" Height="18" IsVisible="{Binding Paging.Descending}" />
                            </Panel>
                        </Button>
                    </Grid>
                    <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding L[supplier_payable]}" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Totals.TotalPayable, StringFormat='{}{0:N0}'}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding L[advance]}" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Totals.TotalAdvance, StringFormat='{}{0:N0}'}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </c:Pager>
                    <Panel>
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      c:GridDoubleClick.Command="{Binding OpenEditCommand}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*" Binding="{Binding Name}"
                                                        Header="{Binding [name], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    <DataGridTemplateColumn Width="Auto"
                                                            Header="{Binding [supplier_payable], Source={x:Static svc:LocalizationManager.Instance}}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Payable, Converter={x:Static conv:DebtBalanceConverter.Instance}, ConverterParameter=supkind}"
                                                               IsVisible="{Binding Payable, Converter={x:Static conv:DebtBalanceConverter.Instance}, ConverterParameter=haskind}"
                                                               Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Payable, Converter={x:Static conv:DebtBalanceConverter.Instance}}"
                                                               Foreground="{Binding Payable, Converter={x:Static conv:DebtBalanceConverter.Instance}, ConverterParameter=brush}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Classes="icon" Margin="6,0"
                                                        IsVisible="{Binding $parent[DataGrid].DataContext.CanManage}"
                                                        Command="{Binding $parent[DataGrid].DataContext.OpenEditCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[edit]}">
                                                    <mi:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                                                     Foreground="{DynamicResource TextSecondary}" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <c:EmptyState Icon="TruckOutline" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
                    </Panel>
                </DockPanel>

                <Panel Grid.Column="2">
                    <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                                    Margin="0,0,0,16"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,16,*">
                                <Border Width="56" Height="56" CornerRadius="28" VerticalAlignment="Top"
                                        Background="{DynamicResource BrandPrimaryBrush}">
                                    <TextBlock Text="{Binding SelectedInitials}" Foreground="White" FontWeight="Bold"
                                               FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedSupplierDisplay.Name}" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding SelectedSupplierDisplay.Phone, Converter={x:Static conv:StringNotEmptyConverter.Instance}}">
                                        <mi:MaterialIcon Kind="PhoneOutline" Width="15" Height="15" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding SelectedSupplierDisplay.Phone}" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Classes="debtcard" Classes.credit="{Binding SelectedIsAdvance}"
                                    CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel Spacing="4">
                                    <Panel>
                                        <TextBlock Text="{Binding L[supplier_payable]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                                                   IsVisible="{Binding !SelectedIsAdvance}" />
                                        <TextBlock Text="{Binding L[advance]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                                                   IsVisible="{Binding SelectedIsAdvance}" />
                                    </Panel>
                                    <TextBlock Classes="debtamount" Classes.credit="{Binding SelectedIsAdvance}"
                                               Text="{Binding SelectedPayableAmount, StringFormat='{}{0:N0}'}"
                                               FontSize="22" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                                <Button Classes="brand" Command="{Binding OpenRepayCommand}"
                                        IsVisible="{Binding CanManage}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <mi:MaterialIcon Kind="CashCheck" Width="17" Height="17" />
                                        <TextBlock Text="{Binding L[payment]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Panel Grid.Row="3" Margin="0,0,0,10">
                                <TextBlock Text="{Binding L[recent_transactions]}" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{DynamicResource TextPrimary}" IsVisible="{Binding !CanViewSupplies}" />
                                <Border Classes="segwrap" IsVisible="{Binding CanViewSupplies}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="seg" Classes.active="{Binding !IsSuppliesTab}" Content="{Binding L[recent_transactions]}"
                                                Command="{Binding SetTabCommand}" CommandParameter="ledger" />
                                        <Button Classes="seg" Classes.active="{Binding IsSuppliesTab}" Content="{Binding L[supplies]}"
                                                Command="{Binding SetTabCommand}" CommandParameter="supplies" />
                                    </StackPanel>
                                </Border>
                            </Panel>
                            <Border Grid.Row="4" Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    IsVisible="{Binding !IsSuppliesTab}">
                              <Panel>
                                <DataGrid ItemsSource="{Binding Ledger}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="Auto" Binding="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                            Header="{Binding [time], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="*" Binding="{Binding OperationType, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=op}"
                                                            Header="{Binding [operation_type], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="Auto" Binding="{Binding AccountType, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=acct}"
                                                            Header="{Binding [type], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTemplateColumn Width="Auto"
                                                                Header="{Binding [balance_change], Source={x:Static svc:LocalizationManager.Instance}}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="12,0">
                                                        <TextBlock Text="{Binding Change, StringFormat='{}{0:N0}'}" />
                                                        <TextBlock Text="{Binding Currency}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"
                                                                   IsVisible="{Binding Currency, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="Auto"
                                                                Header="{Binding [balance], Source={x:Static svc:LocalizationManager.Instance}}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="12,0">
                                                        <TextBlock Text="{Binding BalanceAfter, StringFormat='{}{0:N0}'}" />
                                                        <TextBlock Text="{Binding Currency}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"
                                                                   IsVisible="{Binding Currency, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLedgerLoading}" Height="3" VerticalAlignment="Top" />
                              </Panel>
                            </Border>
                            <Border Grid.Row="4" Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    IsVisible="{Binding IsSuppliesTab}">
                              <Panel>
                                <DataGrid ItemsSource="{Binding Supplies}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="Auto" Binding="{Binding SupplyDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                            Header="{Binding [supply_date], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="*" Binding="{Binding WarehouseName}"
                                                            Header="{Binding [warehouse], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="Auto" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}'}"
                                                            Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                                        <DataGridTextColumn Width="Auto" Binding="{Binding UserName}"
                                                            Header="{Binding [user], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSuppliesLoading}" Height="3" VerticalAlignment="Top" />
                              </Panel>
                            </Border>
                            <c:Pager Grid.Row="5" State="{Binding LedgerPaging}" Margin="0,10,0,0" IsVisible="{Binding !IsSuppliesTab}" />
                            <c:Pager Grid.Row="5" State="{Binding SuppliesPaging}" Margin="0,10,0,0" IsVisible="{Binding IsSuppliesTab}" />
                    </Grid>
                    <c:EmptyState Icon="TruckOutline" Title="{Binding L[select_supplier]}" IsVisible="{Binding !HasSelection}" />
                </Panel>
            </Grid>
        </DockPanel>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" VerticalAlignment="Top" />

        <Border IsVisible="{Binding IsEditOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CancelEditCommand}">
            <Border Classes="form" Background="{DynamicResource CardBg}" CornerRadius="14" Width="440"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    c:FormBehaviors.AutoFocus="True"
                    c:FormBehaviors.EnterSubmits="{Binding SaveCommand}"
                    c:FormBehaviors.EscCancels="{Binding CancelEditCommand}">
                <StackPanel Margin="24" Spacing="14">
                    <TextBlock Text="{Binding L[suppliers]}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <StackPanel Spacing="5">
                        <c:FieldLabel Text="{Binding L[name]}" Required="True" />
                        <TextBox Text="{Binding EditName}" MinHeight="38" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[phone]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding EditPhone}" MinHeight="38" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                        <Button Classes="outline" Command="{Binding CancelEditCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding IsRepayOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CancelRepayCommand}">
            <Border Classes="form" Background="{DynamicResource CardBg}" CornerRadius="14" Width="420"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    c:FormBehaviors.AutoFocus="True"
                    c:FormBehaviors.EnterSubmits="{Binding RepayCommand}"
                    c:FormBehaviors.EscCancels="{Binding CancelRepayCommand}">
                <StackPanel Margin="24" Spacing="14">
                    <TextBlock Text="{Binding L[payment]}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding SelectedSupplierDisplay.Name}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSupplierDisplay.Payable, Converter={x:Static conv:DebtBalanceConverter.Instance}, ConverterParameter=supkind}"
                                       IsVisible="{Binding SelectedSupplierDisplay.Payable, Converter={x:Static conv:DebtBalanceConverter.Instance}, ConverterParameter=haskind}"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedSupplierDisplay.Payable, Converter={x:Static conv:DebtBalanceConverter.Instance}}"
                                       Foreground="{Binding SelectedSupplierDisplay.Payable, Converter={x:Static conv:DebtBalanceConverter.Instance}, ConverterParameter=brush}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding IsMulticurrency}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding L[debt_currency]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ComboBox ItemsSource="{Binding RepayDebtCurrencies}" SelectedItem="{Binding RepayDebtCurrency}"
                                      HorizontalAlignment="Stretch" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{Binding L[pay_currency]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ComboBox ItemsSource="{Binding PayCurrencies}" SelectedItem="{Binding RepayPayCurrency}"
                                      HorizontalAlignment="Stretch" MinHeight="36" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[amount]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <NumericUpDown Value="{Binding RepayAmount, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="1000" FormatString="N0"
                                       ShowButtonSpinner="False" MinHeight="38" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[payment_method]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <ComboBox ItemsSource="{Binding RepayModes}" SelectedItem="{Binding RepayMode}"
                                  MinHeight="38" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                        <Button Classes="outline" Command="{Binding CancelRepayCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" Command="{Binding RepayCommand}" Content="{Binding L[confirm]}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
