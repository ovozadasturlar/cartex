<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:controls="using:Cartex.UI.Controls"
             x:Class="Cartex.UI.Views.LoginView"
             x:CompileBindings="False">

    <Grid Background="{DynamicResource AppBg}">

        <Border Background="{DynamicResource CardBg}" CornerRadius="16"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                BoxShadow="0 18 50 0 #22000000"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="430" Padding="40,38">
            <StackPanel Spacing="18">

                <controls:CxLogo Width="76" Height="76" HorizontalAlignment="Center" />

                <StackPanel Spacing="18" IsVisible="{Binding !IsQrOpen}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Cartex POS" Classes="h1" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding L[login]}" Classes="caption"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[username]}" Classes="caption" />
                        <TextBox Text="{Binding Username, Mode=TwoWay}" MinHeight="44" FontSize="15">
                            <TextBox.InnerLeftContent>
                                <mi:MaterialIcon Kind="AccountOutline" Width="18" Height="18" Margin="10,0,0,0"
                                                 Foreground="{DynamicResource TextMuted}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[password]}" Classes="caption" />
                        <TextBox x:Name="PasswordBox" Text="{Binding Password, Mode=TwoWay}"
                                 PasswordChar="●" RevealPassword="False" MinHeight="44" FontSize="15">
                            <TextBox.InnerLeftContent>
                                <mi:MaterialIcon Kind="LockOutline" Width="18" Height="18" Margin="10,0,0,0"
                                                 Foreground="{DynamicResource TextMuted}" />
                            </TextBox.InnerLeftContent>
                            <TextBox.InnerRightContent>
                                <ToggleButton IsChecked="{Binding #PasswordBox.RevealPassword, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0" Padding="8,0"
                                              Cursor="Hand" VerticalAlignment="Center">
                                    <mi:MaterialIcon Kind="EyeOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource TextMuted}" />
                                </ToggleButton>
                            </TextBox.InnerRightContent>
                        </TextBox>
                    </StackPanel>

                    <CheckBox Content="{Binding L[remember_me]}" IsChecked="{Binding RememberMe, Mode=TwoWay}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding ServerStatus}"
                               Foreground="{DynamicResource SuccessBrush}" FontSize="12.5"
                               IsVisible="{Binding ServerStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" />

                    <StackPanel Spacing="6" IsVisible="{Binding IsServerEditOpen}">
                        <TextBlock Text="{Binding L[api_url]}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox Text="{Binding ServerUrl}" MinHeight="40"
                                     PlaceholderText="http://192.168.1.10:5015">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SaveServerUrlCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="2" Classes="brand" MinHeight="40" MinWidth="90"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding SaveServerUrlCommand}" IsEnabled="{Binding !IsLoading}"
                                    Content="{Binding L[save]}" />
                        </Grid>
                    </StackPanel>

                    <Button Content="{Binding L[login_button]}"
                            Command="{Binding LoginCommand}"
                            Classes="brand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            MinHeight="46" FontSize="16"
                            IsDefault="True"
                            IsEnabled="{Binding !IsLoading}" />

                    <StackPanel Spacing="8" IsVisible="{Binding KeyDetected}">
                        <TextBlock Text="{Binding L[login_choose_profile]}" IsVisible="{Binding HasMultipleKeys}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12.5" HorizontalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding KeyProfiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding $parent[ItemsControl].DataContext.LoginWithKeyCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            MinHeight="44" IsEnabled="{Binding !$parent[ItemsControl].DataContext.IsLoading}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <mi:MaterialIcon Kind="Usb" Width="18" Height="18" />
                                            <TextBlock Text="{Binding $parent[ItemsControl].DataContext.L[login_with_key]}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Username}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Command="{Binding ToggleQrCommand}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" MinHeight="44" IsEnabled="{Binding !IsLoading}"
                            IsVisible="{Binding QrAvailable}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="QrcodeScan" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[login_with_qr]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Background="Transparent" BorderThickness="0" Padding="6,3"
                            HorizontalAlignment="Center" Command="{Binding ToggleServerEditCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="ServerNetwork" Width="14" Height="14"
                                             Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding L[api_url]}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="14" IsVisible="{Binding IsQrOpen}">
                    <TextBlock Text="{Binding L[login_with_qr]}" Classes="h1" HorizontalAlignment="Center" />
                    <Border Background="White" CornerRadius="10" Padding="10" HorizontalAlignment="Center">
                        <Image Source="{Binding QrImage}" Width="220" Height="220" />
                    </Border>
                    <ProgressBar Value="{Binding QrProgress}" Maximum="100" Height="4" Width="240" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding L[qr_scan_hint]}" Foreground="{DynamicResource TextSecondary}"
                               FontSize="12.5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Command="{Binding ToggleQrCommand}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" MinHeight="44">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[back]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ProgressBar IsIndeterminate="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Height="4" />

            </StackPanel>
        </Border>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Orientation="Horizontal" Margin="20,16" Spacing="4">
            <Panel>
                <Button Background="Transparent" BorderThickness="0" Padding="8,6" Cursor="Hand" Opacity="0.8"
                        Command="{Binding ToggleThemePopupCommand}" ToolTip.Tip="{Binding L[theme]}">
                    <mi:MaterialIcon Kind="{Binding ThemeIcon}" Width="18" Height="18"
                                     Foreground="{DynamicResource TextSecondary}" />
                </Button>
                <Popup IsOpen="{Binding IsThemePopupOpen, Mode=TwoWay}"
                       Placement="Top" IsLightDismissEnabled="True">
                    <Border Background="{DynamicResource CardBg}" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="4" MinWidth="160" BoxShadow="0 8 24 0 #22000000">
                        <StackPanel Spacing="2">
                            <Button Background="Transparent" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8"
                                    Command="{Binding SelectThemeCommand}" CommandParameter="Light">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="WeatherSunny" Width="18" Height="18" />
                                    <TextBlock Text="{Binding L[light]}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="Transparent" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8"
                                    Command="{Binding SelectThemeCommand}" CommandParameter="Dark">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="WeatherNight" Width="18" Height="18" />
                                    <TextBlock Text="{Binding L[dark]}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Panel>

            <Panel>
                <Button Background="Transparent" BorderThickness="0" Padding="8,6" Cursor="Hand" Opacity="0.8"
                        Command="{Binding ToggleLanguagePopupCommand}" ToolTip.Tip="{Binding L[language]}">
                    <Border Background="{DynamicResource SidebarItemHover}" CornerRadius="4" Padding="6,3">
                        <TextBlock Text="{Binding CurrentLanguageFlag}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </Border>
                </Button>
                <Popup IsOpen="{Binding IsLanguagePopupOpen, Mode=TwoWay}"
                       Placement="Top" IsLightDismissEnabled="True">
                    <Border Background="{DynamicResource CardBg}" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="4" MinWidth="200" BoxShadow="0 8 24 0 #22000000">
                        <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Padding="12,8"
                                            Command="{Binding $parent[UserControl].DataContext.SelectLanguageCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{DynamicResource SidebarItemHover}" CornerRadius="4" Padding="6,3">
                                                <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageFlagConverter.Instance}}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                            </Border>
                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageDisplayConverter.Instance}}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Panel>
        </StackPanel>

    </Grid>
</UserControl>
