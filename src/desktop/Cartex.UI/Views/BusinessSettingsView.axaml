<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             x:Class="Cartex.UI.Views.BusinessSettingsView"
             x:CompileBindings="False">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">

            <c:PageHeader Title="{Binding L[business]}" />

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding L[logo]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <Grid ColumnDefinitions="*,14,*">
                            <Border Background="{DynamicResource AppBg}" CornerRadius="12" Padding="14"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Rangli logotip" FontWeight="SemiBold" FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Ilova va rangli hujjatlar uchun" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                    <Border Height="112" CornerRadius="9" ClipToBounds="True" Background="White"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Panel>
                                            <mi:MaterialIcon Kind="Domain" Width="30" Height="30"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource TextMuted}" />
                                            <Image Source="{Binding LogoPreview}" Stretch="Uniform" Margin="10" />
                                        </Panel>
                                    </Border>
                                    <Button Classes="outline" HorizontalAlignment="Stretch"
                                            Command="{Binding PickLogoCommand}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                            <mi:MaterialIcon Kind="Upload" Width="17" Height="17" />
                                            <TextBlock Text="Rangli rasmni yuklash" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource AppBg}" CornerRadius="12" Padding="14"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Oq-qora logotip" FontWeight="SemiBold" FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Termal chek va oq-qora qog‘oz uchun" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                    <Border Height="112" CornerRadius="9" ClipToBounds="True" Background="White"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Panel>
                                            <mi:MaterialIcon Kind="Domain" Width="30" Height="30"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="#525252" />
                                            <Image Source="{Binding MonochromeLogoPreview}" Stretch="Uniform" Margin="10" />
                                        </Panel>
                                    </Border>
                                    <Button Classes="outline" HorizontalAlignment="Stretch"
                                            Command="{Binding PickMonochromeLogoCommand}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                            <mi:MaterialIcon Kind="ImageEditOutline" Width="17" Height="17" />
                                            <TextBlock Text="Custom oq-qora yuklash" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Rangli rasm yuklanganda tizim bu variantni avtomatik yaratadi."
                                               FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding Name}" MinHeight="40" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,14,Auto">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="{Binding L[legal_name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding LegalName}" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="{Binding L[currency]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" MinHeight="40" MinWidth="110" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[phone]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding Phone}" MinHeight="40" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[address]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding Address}" MinHeight="40" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L[telegram_address]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding Telegram}" MinHeight="40" PlaceholderText="@cartex_uz" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="{Binding L[website]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding Website}" MinHeight="40" PlaceholderText="cartex.uz" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource AppBg}" CornerRadius="10" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding L[sales_policy]}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding L[shift_policy]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <ComboBox ItemsSource="{Binding ShiftPolicies}" SelectedIndex="{Binding ShiftPolicyIndex}" HorizontalAlignment="Stretch" MinHeight="38" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="5">
                                    <TextBlock Text="{Binding L[max_discount]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <NumericUpDown Value="{Binding MaxDiscountPercent, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Maximum="100" Increment="1" FormatString="0.##" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Spacing="5">
                                    <TextBlock Text="{Binding L[default_min_stock]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <NumericUpDown Value="{Binding DefaultMinStock, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="1" FormatString="0.##" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="5">
                                    <TextBlock Text="{Binding L[stale_rate_days]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <NumericUpDown Value="{Binding StaleRateDays, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="1" Maximum="30" Increment="1" FormatString="0" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding L[sale_correction_window]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <ComboBox ItemsSource="{Binding CorrectionWindows}" SelectedIndex="{Binding CorrectionWindowIndex}" HorizontalAlignment="Stretch" MinHeight="38" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="5" IsVisible="{Binding ShowCorrectionDays}">
                                    <TextBlock Text="{Binding L[sale_correction_days]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <NumericUpDown Value="{Binding SaleCorrectionDays, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="1" Maximum="365" Increment="1" FormatString="0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding L[sale_correction_hint]}" Foreground="{DynamicResource TextMuted}"
                                       FontSize="11.5" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L[allow_debt_sales]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowDebtSales}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AllowDebtSales}">
                                <TextBlock Text="{Binding L[require_debt_due_date]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RequireDebtDueDate}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L[allow_customer_credit]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowCustomerCredit}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L[require_supplier]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RequireSupplier}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L[show_out_of_stock]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowOutOfStock}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L[show_unlisted_products]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowUnlistedProducts}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L[allow_insufficient_stock_sales]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowInsufficientStockSales}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L[allow_retroactive_cashback]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowRetroactiveCashback}" />
                            </Grid>
                            <TextBlock Text="{Binding L[sales_policy_hint]}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppBg}" CornerRadius="10" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            IsVisible="{Binding CanManageSecurity}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding L[login_methods]}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L[login_with_key]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeyLoginEnabled}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L[login_with_qr]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding QrLoginEnabled}" />
                            </Grid>
                            <StackPanel Spacing="5" MaxWidth="260" HorizontalAlignment="Left" IsVisible="{Binding QrLoginEnabled}">
                                <TextBlock Text="{Binding L[qr_refresh_seconds]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <NumericUpDown Value="{Binding QrRefreshSeconds, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="30" Maximum="600" Increment="10" FormatString="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding L[login_methods_hint]}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button Classes="brand" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ContentSave" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[save]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
