<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             x:Class="Cartex.UI.Views.BusinessSettingsView"
             x:CompileBindings="False">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">

            <c:PageHeader Title="{Binding L[business]}" />

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[logo]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <Grid ColumnDefinitions="Auto,14,*" VerticalAlignment="Center">
                            <Border Grid.Column="0" Width="84" Height="84" CornerRadius="10" ClipToBounds="True"
                                    Background="{DynamicResource AppBg}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Panel>
                                    <mi:MaterialIcon Kind="Domain" Width="28" Height="28"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextMuted}" />
                                    <Image Source="{Binding LogoPreview}" Stretch="UniformToFill" />
                                </Panel>
                            </Border>
                            <Button Grid.Column="2" Classes="outline" HorizontalAlignment="Left"
                                    Command="{Binding PickLogoCommand}" Content="{Binding L[choose_image]}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding Name}" MinHeight="40" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,14,Auto">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="{Binding L[legal_name]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <TextBox Text="{Binding LegalName}" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="{Binding L[currency]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                            <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" MinHeight="40" MinWidth="110" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[phone]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding Phone}" MinHeight="40" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[address]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                        <TextBox Text="{Binding Address}" MinHeight="40" />
                    </StackPanel>

                    <Border Background="{DynamicResource AppBg}" CornerRadius="10" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding L[sales_policy]}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding L[shift_policy]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <ComboBox ItemsSource="{Binding ShiftPolicies}" SelectedIndex="{Binding ShiftPolicyIndex}" HorizontalAlignment="Stretch" MinHeight="38" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="5">
                                    <TextBlock Text="{Binding L[max_discount]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <NumericUpDown Value="{Binding MaxDiscountPercent}" Minimum="0" Maximum="100" Increment="1" FormatString="0.##" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Spacing="5">
                                    <TextBlock Text="{Binding L[default_min_stock]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <NumericUpDown Value="{Binding DefaultMinStock}" Minimum="0" Increment="1" FormatString="0.##" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="5">
                                    <TextBlock Text="{Binding L[stale_rate_days]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                    <NumericUpDown Value="{Binding StaleRateDays}" Minimum="1" Maximum="30" Increment="1" FormatString="0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding L[sales_policy_hint]}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppBg}" CornerRadius="10" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding L[login_with_qr]}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <StackPanel Spacing="5" MaxWidth="260" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding L[qr_refresh_seconds]}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" />
                                <NumericUpDown Value="{Binding QrRefreshSeconds}" Minimum="30" Maximum="600" Increment="10" FormatString="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding L[qr_refresh_hint]}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button Classes="brand" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ContentSave" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[save]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
