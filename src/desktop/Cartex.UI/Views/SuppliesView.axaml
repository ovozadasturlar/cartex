<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:il="using:AsyncImageLoader"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:views="using:Cartex.UI.Views"
             x:Class="Cartex.UI.Views.SuppliesView"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="DockPanel.editor TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="White" />
        </Style>
        <Style Selector="DockPanel.editor ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="DockPanel.editor NumericUpDown">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="DockPanel.editor AutoCompleteBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="DockPanel.editor CalendarDatePicker">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="DockPanel.editor TextBlock.field">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="2,0,0,3" />
        </Style>
        <Style Selector="DockPanel.editor Border.total">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="DockPanel.editor Border.total TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="DockPanel.editor Border.total TextBlock.value">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <DockPanel Margin="24" Classes.blurred="{Binding IsModalOpen}" IsVisible="{Binding !IsEditOpen}">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[supplies]}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
                    <Button Classes="outline" Command="{Binding ImportTemplateCommand}" IsVisible="{Binding CanImport}"
                            ToolTip.Tip="{Binding L[import_template]}">
                        <mi:MaterialIcon Kind="Download" Width="18" Height="18" />
                    </Button>
                    <Button Classes="outline" Command="{Binding ImportExcelCommand}" IsVisible="{Binding CanImport}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="FileExcel" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[import_excel]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="brand" Command="{Binding OpenCreateCommand}" IsVisible="{Binding CanCreate}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                            <TextBlock Text="{Binding L[add]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,16">
                <TextBlock Text="{Binding L[date_from]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,16,0" />
                <TextBlock Grid.Column="2" Text="{Binding L[date_to]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="3" SelectedDate="{Binding DateTo, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,16,0" />
                <ComboBox Grid.Column="4" MinWidth="180" MinHeight="36" VerticalAlignment="Center"
                          ItemsSource="{Binding SupplierOptions}" SelectedItem="{Binding FilterSupplier}"
                          PlaceholderText="{Binding L[all_suppliers]}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="5" Classes="brand" HorizontalAlignment="Right" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" />
                        <TextBlock Text="{Binding L[refresh]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding SuppliesTotalAmount, StringFormat='{}{0:N0}'}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                </StackPanel>
            </c:Pager>

            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Supplies}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              c:GridDoubleClick.Command="{Binding OpenDetailCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="Auto" Binding="{Binding SupplyDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                Header="{Binding [supply_date], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding SupplierName, TargetNullValue=—}"
                                                Header="{Binding [supplier], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding WarehouseName}"
                                                Header="{Binding [warehouse], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding UserName}"
                                                Header="{Binding [user], Source={x:Static svc:LocalizationManager.Instance}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="TruckCheckOutline" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
            </Panel>
        </DockPanel>

        <DockPanel Margin="24" Classes="editor" IsVisible="{Binding IsEditOpen}" Classes.blurred="{Binding IsModalOpen}" c:FormBehaviors.AutoFocus="True">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                <Button Classes="icon" Command="{Binding CancelEditCommand}" ToolTip.Tip="{Binding L[back]}"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding EditorTitle}" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            </Grid>

            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="150,180,240,Auto,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="field" Text="{Binding L[supply_date]}" />
                        <CalendarDatePicker SelectedDate="{Binding SupplyDate}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="field" Text="{Binding L[warehouse]}" />
                        <ComboBox ItemsSource="{Binding WarehouseOptions}" SelectedItem="{Binding SelectedWarehouse}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="field" Text="{Binding L[supplier]}" />
                        <ComboBox ItemsSource="{Binding SupplierChoices}" SelectedItem="{Binding SelectedSupplier}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="4,0,0,8">
                        <TextBlock Text="{Binding SupplierDebtText}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                   IsVisible="{Binding HasSupplierDebt}" />
                        <TextBlock Text="{Binding SupplierAdvanceText}" Foreground="{DynamicResource SuccessBrush}" FontSize="12"
                                   IsVisible="{Binding HasSupplierAdvance}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Right" IsVisible="{Binding IsMulticurrency}">
                        <TextBlock Classes="field" Text="{Binding L[currency]}" />
                        <ComboBox MinWidth="90" ItemsSource="{Binding Currencies}" SelectedItem="{Binding SupplyCurrency}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Classes="form" Background="{DynamicResource AppBg}" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    c:FormBehaviors.EnterSubmits="{Binding AddLineCommand}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="1.2*,1.6*,0.6*,0.7*,1*,1*,1.1*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="LineBarcodeBox" Grid.Column="0" MinWidth="150" Text="{Binding LineBarcode}" PlaceholderText="{Binding L[scan_barcode]}">
                            <TextBox.InnerLeftContent>
                                <mi:MaterialIcon Kind="BarcodeScan" Width="16" Height="16" Margin="8,0,2,0"
                                                 Foreground="{DynamicResource BrandPrimaryBrush}" />
                            </TextBox.InnerLeftContent>
                            <TextBox.InnerRightContent>
                                <views:ScanIndicatorView DataContext="{Binding ScanIndicator}" />
                            </TextBox.InnerRightContent>
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ScanLineCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <AutoCompleteBox Grid.Column="1" x:Name="ProductBox" MinWidth="180" ItemsSource="{Binding ProductOptions}"
                                         SelectedItem="{Binding LineProduct, Mode=TwoWay}" Text="{Binding LineProductText, Mode=TwoWay}"
                                         FilterMode="ContainsOrdinal" MinimumPrefixLength="1" PlaceholderText="{Binding L[product_name]}"
                                         ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch">
                            <AutoCompleteBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></AutoCompleteBox.ItemTemplate>
                            <AutoCompleteBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding CommitProductCommand}" />
                            </AutoCompleteBox.KeyBindings>
                        </AutoCompleteBox>
                        <NumericUpDown x:Name="LineQtyBox" Grid.Column="2" MinWidth="70" Value="{Binding LineQuantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="1" FormatString="0.###"
                                       ShowButtonSpinner="False" ToolTip.Tip="{Binding L[quantity]}" />
                        <ComboBox x:Name="LineEntryBox" Grid.Column="3" MinWidth="80" ItemsSource="{Binding EntryOptions}" SelectedItem="{Binding LineEntry}"
                                  HorizontalAlignment="Stretch" PlaceholderText="{Binding L[unit]}" ToolTip.Tip="{Binding L[unit_or_pack]}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <NumericUpDown x:Name="LinePriceBox" Grid.Column="4" MinWidth="100" Value="{Binding LinePrice, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="1000" FormatString="#,##0.##"
                                       ShowButtonSpinner="False" ToolTip.Tip="{Binding LinePriceLabel}"
                                       PlaceholderText="{Binding LinePriceLabel}" />
                        <NumericUpDown x:Name="LineSellingBox" Grid.Column="5" MinWidth="100" Value="{Binding LineSellingPrice, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" Increment="1000" FormatString="#,##0.##"
                                       ShowButtonSpinner="False" ToolTip.Tip="{Binding L[selling_price]}" />
                        <CalendarDatePicker x:Name="LineExpiryBox" Grid.Column="6" MinWidth="145" SelectedDate="{Binding LineExpiry}" ToolTip.Tip="{Binding L[expired_at]}" />
                        <Button x:Name="LineAddButton" Grid.Column="7" Classes="outline" Command="{Binding AddLineCommand}" MinHeight="34" Padding="14,0"
                                Content="{Binding L[add]}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding CanChoosePriceBasis}" Margin="4,0,0,0">
                        <CheckBox IsChecked="{Binding PricePerStockingUnit}" MinHeight="0"
                                  Content="{Binding L[price_per_stocking_unit]}" FontSize="12" />
                        <TextBlock Text="{Binding LinePreview}" IsVisible="{Binding HasLinePreview}" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="8" Margin="0,10,0,0">
                <Border Grid.Column="0" Classes="total">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock Classes="label" Text="{Binding L[lines]}" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding Items.Count}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Classes="total">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock Classes="label" Text="{Binding L[total]}" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding EditTotal, StringFormat='{}{0:N0}'}" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Classes="total">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock Classes="label" Text="{Binding L[revenue]}" />
                        <TextBlock Grid.Column="1" Classes="value"
                                   Text="{Binding EditSellingTotal, StringFormat='{}{0:N0}'}" />
                    </Grid>
                </Border>
                <Border Grid.Column="3" Classes="total">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock Classes="label" Text="{Binding L[profit]}" />
                        <TextBlock Grid.Column="1" Classes="value" Foreground="{DynamicResource SuccessBrush}"
                                   Text="{Binding EditProfit, StringFormat='{}{0:N0}'}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button Classes="outline" Command="{Binding ClearAllCommand}" Content="{Binding L[clear]}"
                            Height="38" MinWidth="110" />
                    <Button Classes="brand" Command="{Binding SaveCommand}" Content="{Binding L[save]}"
                            Height="38" MinWidth="130" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardBg}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Panel>
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding ProductName}"
                                                Header="{Binding [product_name], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="110" Binding="{Binding Quantity, StringFormat='{}{0:0.###}'}"
                                                Header="{Binding [quantity], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" IsReadOnly="True" Binding="{Binding UnitName}"
                                                Header="{Binding [unit], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="130" IsReadOnly="True"
                                                    Header="{Binding [to_stock], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding StockingQuantity, StringFormat='{}{0:0.###}'}" />
                                            <TextBlock Text="{Binding StockingUnitName}" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="140"
                                                    Header="{Binding [purchase_price], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PurchasePrice, StringFormat='{}{0:#,##0.##}'}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <NumericUpDown Value="{Binding PurchasePrice, Mode=TwoWay, Converter={x:Static conv:EmptyKeepsValueConverter.Instance}}"
                                                       Minimum="0" FormatString="#,##0.##" ShowButtonSpinner="False" Padding="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="140"
                                                    Header="{Binding [selling_price], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SellingPrice, StringFormat='{}{0:#,##0.##}'}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <NumericUpDown Value="{Binding SellingPrice, Mode=TwoWay, Converter={x:Static conv:EmptyKeepsValueConverter.Instance}}"
                                                       Minimum="0" FormatString="#,##0.##" ShowButtonSpinner="False" Padding="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="110" IsReadOnly="True" Binding="{Binding Margin, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [margin], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="140" IsReadOnly="True" Binding="{Binding LineTotal, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="icon" Margin="2,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.OpenPrintBarcodeCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[barcode_print]}">
                                                <mi:MaterialIcon Kind="BarcodeScan" Width="15" Height="15"
                                                                 Foreground="{DynamicResource TextSecondary}" />
                                            </Button>
                                            <Button Classes="icon" Margin="2,0"
                                                    Command="{Binding $parent[DataGrid].DataContext.RemoveLineCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Close" Width="15" Height="15"
                                                                 Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:EmptyState Icon="BarcodeScan" Title="{Binding L[supply_empty]}" IsVisible="{Binding !HasItems}" />
                </Panel>
            </Border>
        </DockPanel>

        <Border Background="#30000000" IsVisible="{Binding IsDetailOpen}"
                c:OverlayBehaviors.DismissCommand="{Binding CloseDetailCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" Width="760" MaxHeight="680"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[supply_detail]}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14" />
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{Binding L[supply_date]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding DetailSupplyDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding L[supplier]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding DetailSupplierName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="{Binding L[warehouse]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding DetailWarehouseName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="3">
                            <TextBlock Text="{Binding L[user]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding DetailUserName}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <Grid ColumnDefinitions="*,*,*">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{Binding L[paid_cash]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                               Text="{Binding DetailPaidCash, StringFormat='{}{0:N0}'}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding L[paid_card]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                               Text="{Binding DetailPaidCard, StringFormat='{}{0:N0}'}" />
                                    <StackPanel Spacing="3" IsVisible="{Binding HasDetailPaidTransfer}">
                                        <TextBlock Text="{Binding L[pay_transfer]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   Text="{Binding DetailPaidTransfer, StringFormat='{}{0:N0}'}" />
                                    </StackPanel>
                                    <StackPanel Spacing="3" IsVisible="{Binding HasDetailPaidBank}">
                                        <TextBlock Text="{Binding L[pay_bank]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   Text="{Binding DetailPaidBank, StringFormat='{}{0:N0}'}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" HorizontalAlignment="Right" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrandPrimaryBrush}"
                                                   Text="{Binding DetailTotalAmount, StringFormat='{}{0:N0}'}" />
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Bottom" Text="{Binding DetailCurrency}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                            <Button Classes="danger" Command="{Binding VoidSupplyCommand}" Content="{Binding L[supply_void]}"
                                    IsVisible="{Binding CanVoid}" />
                            <Button Grid.Column="2" Classes="outline" MinWidth="120" Margin="0,0,10,0" HorizontalContentAlignment="Center"
                                    Command="{Binding OpenEditCommand}" Content="{Binding L[edit]}"
                                    IsVisible="{Binding CanEdit}" />
                            <Button Grid.Column="3" Classes="brand" MinWidth="120" Margin="0,0,10,0" HorizontalContentAlignment="Center"
                                    Command="{Binding OpenPaymentCommand}" Content="{Binding L[payment]}"
                                    IsVisible="{Binding DetailCanPay}" />
                            <Button Grid.Column="4" MinWidth="120" HorizontalContentAlignment="Center"
                                    Command="{Binding CloseDetailCommand}" Content="{Binding L[back]}" />
                        </Grid>
                    </StackPanel>
                    <Border Background="{DynamicResource AppBg}" CornerRadius="10" MinHeight="120"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding DetailItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding ProductName}"
                                                    Header="{Binding [product_name], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding Quantity, StringFormat='{}{0:0.###}'}"
                                                    Header="{Binding [quantity], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding UnitName}"
                                                    Header="{Binding [unit], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding PackSize, Mode=OneWay, Converter={x:Static conv:PackQtyConverter.Instance}}"
                                                    Header="{Binding [pack_size], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding PurchasePrice, StringFormat='{}{0:N0}'}"
                                                    Header="{Binding [purchase_price], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding ExpiredAt, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}', TargetNullValue=—}"
                                                    Header="{Binding [expired_at], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="140" Binding="{Binding Total, Mode=OneWay, StringFormat='{}{0:N0}'}"
                                                    Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Border>
        </Border>

        <views:BarcodeLabelDialog DataContext="{Binding BarcodePrint}" />

        <Border IsVisible="{Binding IsPaymentOpen}" Background="#30000000"
                c:OverlayBehaviors.DismissCommand="{Binding CancelPaymentCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="14" MaxWidth="720" MaxHeight="720" Margin="32" Padding="22"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[payment]}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14" />

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" Margin="0,0,0,14">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding PaymentSupplyTotal, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding L[paid]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding PaymentPaidTotal, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrandPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding L[remains_debt]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding PaymentRemains, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding L[total_supplier_debt]}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding PaymentSupplierTotalDebt, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock Text="{Binding PaymentBaseCurrency}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppBg}" CornerRadius="10" Padding="12" Margin="0,0,0,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            IsVisible="{Binding HasExistingPayments}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding L[existing_payments]}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                                <TextBlock Text="{Binding L[attach_payments_hint]}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ExistingPayments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppBg}" CornerRadius="10" Padding="12" Margin="0,0,0,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                            <Button Classes="outline" Command="{Binding PayFullCommand}" MinHeight="36" Padding="10,0"
                                    VerticalAlignment="Bottom" ToolTip.Tip="{Binding L[pay_full]}">
                                <mi:MaterialIcon Kind="Sigma" Width="18" Height="18" />
                            </Button>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding L[amount]}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" />
                                <NumericUpDown Value="{Binding PaymentAmount, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" Minimum="0" FormatString="N0" ShowButtonSpinner="False" MinHeight="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{Binding L[payment_type]}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" />
                                <ComboBox MinWidth="120" MinHeight="36" ItemsSource="{Binding PaymentModes}"
                                          SelectedItem="{Binding SelectedPaymentMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="4" IsVisible="{Binding IsMulticurrency}">
                                <TextBlock Text="{Binding L[currency]}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" />
                                <ComboBox MinWidth="90" MinHeight="36" ItemsSource="{Binding Currencies}" SelectedItem="{Binding PaymentCurrency}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Bottom">
                                <Button Classes="brand" Command="{Binding AddPaymentLineCommand}" MinHeight="36" Padding="16,0"
                                        Content="{Binding L[add]}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
                        <Button Classes="outline" Command="{Binding CancelPaymentCommand}" Content="{Binding L[cancel]}" />
                        <Button Classes="brand" Command="{Binding ConfirmPaymentCommand}" Content="{Binding L[save]}" MinWidth="110" />
                    </StackPanel>

                    <Border Background="{DynamicResource AppBg}" CornerRadius="10" MinHeight="120"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <Panel>
                            <DataGrid ItemsSource="{Binding PaymentLines}" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*" Binding="{Binding Amount, StringFormat='{}{0:N0}'}"
                                                        Header="{Binding [amount], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    <DataGridTextColumn Width="Auto" Binding="{Binding Currency}"
                                                        Header="{Binding [currency], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    <DataGridTextColumn Width="Auto" Binding="{Binding ModeText}"
                                                        Header="{Binding [payment_type], Source={x:Static svc:LocalizationManager.Instance}}" />
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Classes="icon" Margin="2,0"
                                                            Command="{Binding $parent[DataGrid].DataContext.EditPaymentLineCommand}"
                                                            CommandParameter="{Binding}">
                                                        <mi:MaterialIcon Kind="Pencil" Width="15" Height="15"
                                                                         Foreground="{DynamicResource TextSecondary}" />
                                                    </Button>
                                                    <Button Classes="icon" Margin="2,0"
                                                            Command="{Binding $parent[DataGrid].DataContext.RemovePaymentLineCommand}"
                                                            CommandParameter="{Binding}">
                                                        <mi:MaterialIcon Kind="Close" Width="15" Height="15"
                                                                         Foreground="{DynamicResource DangerBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding L[payment_empty]}" IsVisible="{Binding !HasPaymentLines}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}" FontSize="12.5" />
                        </Panel>
                    </Border>
                </DockPanel>
            </Border>
        </Border>

        <views:QuickProductView DataContext="{Binding QuickProduct}" />
    </Panel>
</UserControl>
