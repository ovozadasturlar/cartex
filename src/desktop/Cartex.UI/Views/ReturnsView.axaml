<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:vm="using:Cartex.UI.ViewModels"
             x:Class="Cartex.UI.Views.ReturnsView"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="DockPanel.editor TextBox">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="DockPanel.editor ComboBox">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="DockPanel.editor NumericUpDown">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="DockPanel.editor TextBlock.field">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Border.total">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- ================= LIST ================= -->
        <DockPanel Margin="24" IsVisible="{Binding !IsEditorOpen}">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[returns]}" Margin="0,0,0,16">
                <Button Classes="brand" Command="{Binding NewReturnCommand}" IsVisible="{Binding CanCreate}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                        <TextBlock Text="{Binding L[ret_new]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </c:PageHeader>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,Auto,Auto,Auto,Auto,3*" Margin="0,0,0,16">
                <TextBox MinWidth="180" MaxWidth="320" HorizontalAlignment="Left" MinHeight="36"
                         PlaceholderText="{Binding L[search]}"
                         Text="{Binding SearchText, Mode=TwoWay}">
                    <TextBox.InnerLeftContent>
                        <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0"
                                         Foreground="{DynamicResource TextMuted}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock Grid.Column="1" Text="{Binding L[date_from]}" VerticalAlignment="Center"
                           Margin="16,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="2" SelectedDate="{Binding DateFrom, Mode=TwoWay}" MinWidth="150" MinHeight="36" />
                <TextBlock Grid.Column="3" Text="{Binding L[date_to]}" VerticalAlignment="Center"
                           Margin="16,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                <DatePicker Grid.Column="4" SelectedDate="{Binding DateTo, Mode=TwoWay}" MinWidth="150" MinHeight="36" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <ComboBox MinWidth="130" VerticalAlignment="Center"
                              ItemsSource="{Binding Paging.SortOptions}" SelectedItem="{Binding Paging.SelectedSort}" />
                    <Button Classes="icon" Command="{Binding Paging.ToggleDirectionCommand}" ToolTip.Tip="{Binding L[sort]}">
                        <Panel>
                            <mi:MaterialIcon Kind="SortAscending" Width="18" Height="18" IsVisible="{Binding !Paging.Descending}" />
                            <mi:MaterialIcon Kind="SortDescending" Width="18" Height="18" IsVisible="{Binding Paging.Descending}" />
                        </Panel>
                    </Button>
                    <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="{Binding L[refresh]}">
                        <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>

            <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}" />

            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Documents}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              c:GridDoubleClick.Command="{Binding OpenDetailCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="Auto" Binding="{Binding DocumentNumber}"
                                                Header="{Binding [ret_document], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding BusinessDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                Header="{Binding [date], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding CustomerName}"
                                                Header="{Binding [customer], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding LineCount}"
                                                Header="{Binding [qty], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding RefundAmount, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="*" Binding="{Binding Note}"
                                                Header="{Binding [note], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="icon" Margin="4,0"
                                                Command="{Binding $parent[DataGrid].DataContext.OpenDetailCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding $parent[DataGrid].DataContext.L[details]}">
                                            <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18"
                                                             Foreground="{DynamicResource TextSecondary}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="KeyboardReturn" Title="{Binding L[ret_empty]}" IsVisible="{Binding IsEmpty}" />
            </Panel>
        </DockPanel>

        <!-- ================= EDITOR ================= -->
        <DockPanel Margin="24" Classes="editor" IsVisible="{Binding IsEditorOpen}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                <Button Classes="icon" Command="{Binding CloseEditorCommand}" ToolTip.Tip="{Binding L[back]}">
                    <mi:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding L[ret_new]}" Classes="h1" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>

            <!-- Document header -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="14" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                    <StackPanel MinWidth="0">
                        <TextBlock Classes="field" Text="{Binding L[warehouse]}" />
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" MinWidth="0">
                        <TextBlock Classes="field" Text="{Binding L[customer]}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    MinHeight="34" Padding="12,0" Command="{Binding PickCustomerCommand}">
                                <Panel>
                                    <TextBlock Text="{Binding SelectedCustomer.FullName}" IsVisible="{Binding HasCustomer}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding L[ret_pick_customer]}" IsVisible="{Binding !HasCustomer}"
                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </Panel>
                            </Button>
                            <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0"
                                    Command="{Binding ClearCustomerCommand}"
                                    IsVisible="{Binding HasCustomer}" ToolTip.Tip="{Binding L[clear]}">
                                <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="field" Text="{Binding L[date]}" />
                        <DatePicker SelectedDate="{Binding BusinessDate, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" MinWidth="0">
                        <TextBlock Classes="field" Text="{Binding L[note]}" />
                        <TextBox Text="{Binding Note, Mode=TwoWay}" PlaceholderText="{Binding L[note]}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Customer sales picker -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource AppBg}" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    IsVisible="{Binding HasCustomer}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                        <TextBlock Text="{Binding L[ret_customer_sales]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="outline" Margin="0,0,8,0"
                                Command="{Binding ToggleSalesPanelCommand}" Content="{Binding L[ret_toggle_sales]}" />
                        <Button Grid.Column="2" Classes="brand" Command="{Binding LoadSelectedSalesCommand}"
                                IsVisible="{Binding IsSalesPanelOpen}" Content="{Binding L[ret_load_sales]}" />
                    </Grid>
                    <ScrollViewer MaxHeight="180" IsVisible="{Binding IsSalesPanelOpen}">
                        <ItemsControl ItemsSource="{Binding CustomerSales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="8"
                                            Background="{DynamicResource CardBg}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Sale.SaleDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Sale.Status}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Sale.TotalAmount, StringFormat='{}{0:N0}'}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Sale.DebtAmount, StringFormat='{}{0:N0}'}"
                                                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Free line entry -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource AppBg}" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    IsVisible="{Binding CanAddFreeLine}">
                <Grid ColumnDefinitions="Auto,*,110,150,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding L[ret_free_line]}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <AutoCompleteBox Grid.Column="1" MinWidth="0" MinHeight="34"
                                     AsyncPopulator="{Binding ProductPopulator}"
                                     FilterMode="None" MinimumPrefixLength="1"
                                     Text="{Binding ProductSearch, Mode=TwoWay}"
                                     SelectedItem="{Binding LineProduct, Mode=TwoWay}"
                                     ValueMemberBinding="{Binding Name}"
                                     PlaceholderText="{Binding L[product]}">
                        <AutoCompleteBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                    <NumericUpDown Grid.Column="2" Minimum="0" Increment="1" FormatString="0.###"
                                   ShowButtonSpinner="False" ToolTip.Tip="{Binding L[qty]}"
                                   Value="{Binding LineQuantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}" />
                    <ComboBox Grid.Column="3" IsEditable="True" HorizontalAlignment="Stretch"
                              ToolTip.Tip="{Binding L[price]}"
                              ItemsSource="{Binding PriceOptions}"
                              SelectedItem="{Binding LinePrice, Mode=TwoWay}"
                              Text="{Binding LinePrice, Mode=TwoWay}" />
                    <Button Grid.Column="4" Classes="brand" Padding="14,0" Command="{Binding AddFreeLineCommand}">
                        <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                    </Button>
                </Grid>
            </Border>

            <!-- Footer: totals + save -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Margin="0,10,0,0">
                <Border Classes="total">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}" FontWeight="Bold"
                                   Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="total" IsVisible="{Binding NeedsManualSettlement}">
                    <CheckBox IsChecked="{Binding RefundInCash, Mode=TwoWay}" Content="{Binding L[ret_refund_cash]}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding L[ret_settlement_hint]}" VerticalAlignment="Center"
                           Margin="8,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12"
                           IsVisible="{Binding !NeedsManualSettlement}" TextWrapping="Wrap" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                    <Button Classes="outline" MinWidth="120" Command="{Binding ClearEditorCommand}"
                            IsEnabled="{Binding CanClearEditor}" Content="{Binding L[clear]}" />
                    <Button Classes="brand" MinWidth="140" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding HasLines}" Content="{Binding L[save]}" />
                </StackPanel>
            </Grid>

            <!-- Lines -->
            <Panel>
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding ProductName}"
                                                Header="{Binding [product], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <!-- Savdo raqami emas: qabul qiluvchiga mijoz shu mahsulotdan jami
                                 nechta olib ketgani kerak, u shu raqamga qarab miqdor kiritadi. -->
                            <DataGridTextColumn Width="Auto" IsReadOnly="True" Binding="{Binding TakenLabel}"
                                                Header="{Binding [ret_taken], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="160"
                                                    Header="{Binding [return_qty], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Yuqori chegara qo'yilmaydi: chegaradan oshgan qiymat jimgina
                                             0 ga qaytib, kassirni sababsiz qoldirardi. Ortiqchasi erkin
                                             qator bo'lib ketadi. -->
                                        <NumericUpDown Minimum="0" Increment="1"
                                                       FormatString="0.###" ShowButtonSpinner="False" MinHeight="30"
                                                       Value="{Binding Quantity, Mode=TwoWay, Converter={x:Static conv:EmptyKeepsValueConverter.Instance}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150"
                                                    Header="{Binding [price], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Ro'yxatda shu mahsulot sotilgan narxlar turadi, birinchisi oxirgi
                                             savdoniki. Boshqa narx yozilsa qator savdodan uziladi (Savdo ustuni "—"). -->
                                        <ComboBox IsEditable="True" MinHeight="30" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding PriceOptions}"
                                                  SelectedItem="{Binding UnitPrice, Mode=TwoWay}"
                                                  Text="{Binding UnitPrice, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="160"
                                                    Header="{Binding [ret_condition], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Condition, Mode=TwoWay}" MinHeight="30" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=condition}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                            <ComboBox.Items>
                                                <x:String>Sellable</x:String>
                                                <x:String>Opened</x:String>
                                                <x:String>Damaged</x:String>
                                                <x:String>Defective</x:String>
                                            </ComboBox.Items>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="180"
                                                    Header="{Binding [ret_disposition], Source={x:Static svc:LocalizationManager.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Disposition, Mode=TwoWay}" MinHeight="30" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=disposition}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                            <ComboBox.Items>
                                                <x:String>SellableRestock</x:String>
                                                <x:String>Quarantine</x:String>
                                                <x:String>Scrap</x:String>
                                                <x:String>SupplierClaim</x:String>
                                            </ComboBox.Items>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Reason, Mode=TwoWay}"
                                                Header="{Binding [reason], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" IsReadOnly="True" Binding="{Binding LineTotal, StringFormat='{}{0:N0}'}"
                                                Header="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="icon"
                                                Command="{Binding $parent[DataGrid].DataContext.RemoveLineCommand}"
                                                CommandParameter="{Binding}">
                                            <mi:MaterialIcon Kind="Delete" Width="17" Height="17"
                                                             Foreground="{DynamicResource DangerBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <c:EmptyState Icon="PackageVariantClosed" Title="{Binding L[ret_no_lines]}" IsVisible="{Binding !HasLines}" />
            </Panel>
        </DockPanel>
    </Panel>
</UserControl>
