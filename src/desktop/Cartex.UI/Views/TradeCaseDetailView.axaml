<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:tc="using:Cartex.Shared.Models.TradeCases"
             xmlns:sales="using:Cartex.Shared.Models.Sales"
             x:Class="Cartex.UI.Views.TradeCaseDetailView"
             x:DataType="vm:TradeCaseDetailViewModel"
             x:CompileBindings="True">

    <Grid Margin="24">
        <DockPanel Classes.blurred="{Binding IsModalOpen}">
            <c:PageHeader DockPanel.Dock="Top" Title="{Binding DetailDisplay.CaseNumber}"
                      Subtitle="{Binding DetailDisplay.Title}" Margin="0,0,0,16">
            <WrapPanel Orientation="Horizontal">
                <Button Classes="outline" Margin="0,0,8,8" Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="ArrowLeft" Width="17" Height="17" />
                        <TextBlock Text="{Binding L[back]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="brand" Margin="0,0,8,8" Command="{Binding OpenIssueCommand}" IsVisible="{Binding CanIssue}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="PackageVariantClosedPlus" Width="17" Height="17" />
                        <TextBlock Text="{Binding L[tc_issue]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="outline" Margin="0,0,8,8" Command="{Binding OpenReturnCommand}" IsVisible="{Binding CanReturn}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="UndoVariant" Width="17" Height="17" />
                        <TextBlock Text="{Binding L[tc_return]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="brand" Margin="0,0,8,8" Command="{Binding OpenSettleCommand}" IsVisible="{Binding CanSettle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="CashCheck" Width="17" Height="17" />
                        <TextBlock Text="{Binding L[tc_settle]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="outline" Margin="0,0,8,8" Command="{Binding ExportStatementCommand}" IsVisible="{Binding CanExportStatement}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="FilePdfBox" Width="17" Height="17" />
                        <TextBlock Text="{Binding L[tc_statement]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="outline" Margin="0,0,8,8" Command="{Binding CloseCaseCommand}" IsVisible="{Binding CanCloseCase}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="LockOutline" Width="17" Height="17" />
                        <TextBlock Text="{Binding L[tc_close_case]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="danger" Margin="0,0,8,8" Command="{Binding CancelCaseCommand}" IsVisible="{Binding CanCancelCase}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="CloseCircleOutline" Width="17" Height="17" />
                        <TextBlock Text="{Binding L[tc_cancel_case]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="icon" Margin="0,0,8,8" Command="{Binding RefreshCommand}" ToolTip.Tip="{Binding L[refresh]}">
                    <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" />
                </Button>
            </WrapPanel>
        </c:PageHeader>

        <ScrollViewer>
            <StackPanel Spacing="16" Margin="0,0,0,24">
                <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="10">
                            <Grid ColumnDefinitions="110,*">
                                <TextBlock Text="{Binding L[status]}" Classes="caption" VerticalAlignment="Center" />
                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        BorderBrush="{Binding DetailDisplay.Status, Converter={x:Static conv:TradeCaseStatusBrushConverter.Instance}}"
                                        BorderThickness="1" CornerRadius="10" Padding="10,3">
                                    <TextBlock Text="{Binding DetailDisplay.Status, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=tc_status}"
                                               Foreground="{Binding DetailDisplay.Status, Converter={x:Static conv:TradeCaseStatusBrushConverter.Instance}}"
                                               FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="110,*">
                                <TextBlock Text="{Binding L[date]}" Classes="caption" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DetailDisplay.BusinessDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="110,*">
                                <TextBlock Text="{Binding L[customer]}" Classes="caption" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DetailDisplay.CustomerName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DetailDisplay.CustomerPhone}" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="110,*">
                                <TextBlock Text="{Binding L[warehouse]}" Classes="caption" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DetailDisplay.WarehouseName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Grid.Row="2" ColumnDefinitions="110,*">
                                <TextBlock Text="{Binding L[tc_site_address]}" Classes="caption" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DetailDisplay.SiteAddress, FallbackValue=—}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="110,*">
                                <TextBlock Text="{Binding L[branch]}" Classes="caption" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DetailDisplay.BranchName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Grid.Row="3" ColumnDefinitions="110,*">
                                <TextBlock Text="{Binding L[tc_workflow]}" Classes="caption" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Text="{Binding DetailDisplay.Workflow, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=tc_workflow}" />
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="110,*">
                                <TextBlock Text="{Binding L[tc_price_policy]}" Classes="caption" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Text="{Binding DetailDisplay.PricePolicy, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=tc_policy}" />
                            </Grid>
                        </Grid>
                        <Grid ColumnDefinitions="110,*" IsVisible="{Binding HasNote}">
                            <TextBlock Text="{Binding L[note]}" Classes="caption" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DetailDisplay.Note}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="6" IsVisible="{Binding HasParticipants}">
                            <TextBlock Text="{Binding L[tc_participants]}" Classes="caption" />
                            <ItemsControl ItemsSource="{Binding DetailDisplay.Participants}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tc:TradeCaseParticipantDto">
                                        <Border Background="{DynamicResource AppBg}" CornerRadius="8" Padding="10,5"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding RoleLabel}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock Text="{Binding PartyName}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PartyPhone}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[tc_lines]}" FontWeight="SemiBold" Margin="20,14,20,10" />
                        <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="2*"
                                                        Header="{Binding [product_name], Source={x:Static svc:LocalizationManager.Instance}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:TradeCaseLineRow">
                                            <StackPanel VerticalAlignment="Center" Margin="0,6" Spacing="2">
                                                <TextBlock Text="{Binding Line.ProductName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Line.UnitName}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="Auto" Binding="{Binding Line.IssuedQuantity, StringFormat='{}{0:0.###}'}"
                                                    Header="{Binding [tc_issued], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding Line.ReturnedQuantity, StringFormat='{}{0:0.###}'}"
                                                    Header="{Binding [tc_returned], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding Line.SettledQuantity, StringFormat='{}{0:0.###}'}"
                                                    Header="{Binding [tc_settled], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTemplateColumn Width="Auto"
                                                        Header="{Binding [tc_custody], Source={x:Static svc:LocalizationManager.Instance}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:TradeCaseLineRow">
                                            <TextBlock Text="{Binding Line.CustodyQuantity, StringFormat='{}{0:0.###}'}"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="Auto" Binding="{Binding Line.UnitPrice, StringFormat='{}{0:N0}'}"
                                                    Header="{Binding [price], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding CustodyAmount, StringFormat='{}{0:N0}'}"
                                                    Header="{Binding [tc_custody_amount], Source={x:Static svc:LocalizationManager.Instance}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding L[no_data]}" Foreground="{DynamicResource TextMuted}" Margin="20,0,20,14"
                                   IsVisible="{Binding !HasLines}" />
                    </DockPanel>
                </Border>

                <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[tc_documents]}" FontWeight="SemiBold" Margin="20,14,20,10" />
                        <DataGrid ItemsSource="{Binding DetailDisplay.Documents}" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="320"
                                  c:GridDoubleClick.Command="{Binding OpenDocumentDetailCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="Auto" Binding="{Binding Type, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=tc_doc}"
                                                    Header="{Binding [tc_doc_type], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding DocumentNumber}"
                                                    Header="{Binding [tc_doc_number], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding BusinessDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                    Header="{Binding [date], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding Quantity, StringFormat='{}{0:0.###}'}"
                                                    Header="{Binding [quantity], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="Auto" Binding="{Binding Amount, StringFormat='{}{0:N0}'}"
                                                    Header="{Binding [amount], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTextColumn Width="*" Binding="{Binding Note}"
                                                    Header="{Binding [note], Source={x:Static svc:LocalizationManager.Instance}}" />
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="tc:TradeCaseDocumentDto">
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                                                <Button Classes="icon"
                                                        IsVisible="{Binding ReceiptToken, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                        Command="{Binding $parent[DataGrid].((vm:TradeCaseDetailViewModel)DataContext).OpenDocumentDetailCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{Binding $parent[DataGrid].((vm:TradeCaseDetailViewModel)DataContext).L[view_receipt]}">
                                                    <mi:MaterialIcon Kind="EyeOutline" Width="17" Height="17"
                                                                     Foreground="{DynamicResource BrandPrimaryBrush}" />
                                                </Button>
                                                <Button Classes="icon"
                                                        IsVisible="{Binding Type, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=GoodsIssue}"
                                                        Command="{Binding $parent[DataGrid].((vm:TradeCaseDetailViewModel)DataContext).PrintIssueCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{Binding $parent[DataGrid].((vm:TradeCaseDetailViewModel)DataContext).L[print]}">
                                                    <mi:MaterialIcon Kind="Printer" Width="17" Height="17"
                                                                     Foreground="{DynamicResource BrandPrimaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding L[no_data]}" Foreground="{DynamicResource TextMuted}" Margin="20,0,20,14"
                                   IsVisible="{Binding !HasDocuments}" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

        <!-- ===== RECEIPT DIALOG (horizontal 2-column) ===== -->
        <Border IsVisible="{Binding IsReceiptOpen}" Background="#44000000"
                c:OverlayBehaviors.DismissCommand="{Binding CloseReceiptCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="16" Width="740" MinHeight="530" MaxHeight="600"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 24 80 0 #44000000">
                <DockPanel>

                    <!-- Action buttons at bottom -->
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="24,14">
                        <Button Grid.Column="0" Classes="outline" MinHeight="44" Padding="18,0"
                                Command="{Binding CloseReceiptCommand}" Content="{Binding L[close]}" />

                        <Button Grid.Column="1" Classes="danger" MinHeight="44" Padding="18,0"
                                HorizontalAlignment="Center"
                                Command="{Binding ReturnSaleFromReceiptCommand}"
                                IsVisible="{Binding CanReturnSale}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <mi:MaterialIcon Kind="UndoVariant" Width="16" Height="16" />
                                <TextBlock Text="{Binding L[return]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Classes="brand" MinHeight="44" Padding="20,0"
                                Command="{Binding PrintReceiptCommand}"
                                IsVisible="{Binding CanPrintReceipt}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <mi:MaterialIcon Kind="Printer" Width="16" Height="16" />
                                <TextBlock Text="{Binding L[print]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Thin separator -->
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- 2-column body -->
                    <Grid ColumnDefinitions="290,1,*">

                        <!-- LEFT PANEL: company + totals + QR -->
                        <ScrollViewer Grid.Column="0" Padding="20">
                            <StackPanel Spacing="14" DataContext="{Binding Receipt}">

                                <!-- Business badge -->
                                <Border Background="{DynamicResource SidebarItemActive}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding BusinessName}" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BranchName}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        <TextBlock Text="{Binding BranchAddress}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   IsVisible="{Binding BranchAddress, Converter={x:Static conv:NullToBoolConverter.Instance}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Meta rows -->
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding [sale_date], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SaleDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding [cashier], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding CustomerName, Converter={x:Static conv:NullToBoolConverter.Instance}}">
                                        <TextBlock Text="{Binding [customer], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                                <!-- Totals -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}"
                                                   FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding DiscountAmount, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [discount], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding PaidCash, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [cash], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PaidCash, StringFormat='{}{0:N0}'}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding PaidCard, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [card], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PaidCard, StringFormat='{}{0:N0}'}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding PaidBonus, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [bonus], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PaidBonus, StringFormat='{}{0:N0}'}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding DebtAmount, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [debt], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource DangerBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DebtAmount, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding CashbackEarned, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [cashback_earned], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CashbackEarned, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{DynamicResource SuccessBrush}" />
                                    </Grid>
                                </StackPanel>

                                <!-- QR Code -->
                                <Border Background="{DynamicResource AppBg}" CornerRadius="10" Padding="12"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding $parent[UserControl].DataContext.ReceiptQrCode, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <Image Source="{Binding $parent[UserControl].DataContext.ReceiptQrCode}" Width="120" Height="120"
                                               HorizontalAlignment="Center" Stretch="Uniform" />
                                        <TextBlock Text="{Binding ReceiptToken}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                                   MaxWidth="180" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Vertical divider -->
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

                        <!-- RIGHT PANEL: products list -->
                        <DockPanel Grid.Column="2">
                            <!-- Header row -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarItemHover}" CornerRadius="0,16,0,0">
                                <Grid ColumnDefinitions="*,70,80,90">
                                    <TextBlock Grid.Column="0" Text="{Binding [product], Source={x:Static svc:LocalizationManager.Instance}}"
                                               Padding="20,10,8,10" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding [quantity], Source={x:Static svc:LocalizationManager.Instance}}"
                                               Padding="8,10" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding [price], Source={x:Static svc:LocalizationManager.Instance}}"
                                               Padding="8,10" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="3" Text="{Binding [amount], Source={x:Static svc:LocalizationManager.Instance}}"
                                               Padding="8,10,20,10" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                            </Border>

                            <!-- Items -->
                            <ScrollViewer DataContext="{Binding Receipt}">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sales:ReceiptItemDto">
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="*,70,80,90" MinHeight="46">
                                                    <StackPanel Grid.Column="0" Margin="20,10,8,10" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding UnitName}" FontSize="11"
                                                                   Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0:0.###}'}"
                                                               VerticalAlignment="Center" Padding="8" TextAlignment="Right"
                                                               FontSize="13" />
                                                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='{}{0:N0}'}"
                                                               VerticalAlignment="Center" Padding="8" TextAlignment="Right"
                                                               FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat='{}{0:N0}'}"
                                                               VerticalAlignment="Center" Padding="8,8,20,8" TextAlignment="Right"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- ===== RETURN DIALOG (modern 2-column) ===== -->
        <Border IsVisible="{Binding IsReturnOpen}" Background="#44000000"
                c:OverlayBehaviors.DismissCommand="{Binding CloseReturnCommand}">
            <Border Background="{DynamicResource CardBg}" CornerRadius="16" Width="780" MinHeight="540" MaxHeight="620"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 24 80 0 #44000000">
                <DockPanel>

                    <!-- Action buttons at bottom -->
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="24,14">
                        <Button Grid.Column="0" Classes="outline" MinHeight="44" Padding="18,0"
                                Command="{Binding CloseReturnCommand}" Content="{Binding L[cancel]}" />

                        <!-- Quick select tools -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Classes="outline" MinHeight="36" Padding="12,0"
                                    Command="{Binding SelectAllReturnCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="CheckAll" Width="15" Height="15" />
                                    <TextBlock Text="{Binding [select_all], Source={x:Static svc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Classes="outline" MinHeight="36" Padding="12,0"
                                    Command="{Binding ClearReturnQuantitiesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="Close" Width="15" Height="15" />
                                    <TextBlock Text="{Binding [clear], Source={x:Static svc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="2" Classes="danger" MinHeight="44" Padding="20,0"
                                Command="{Binding ConfirmReturnCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Undo" Width="16" Height="16" />
                                <TextBlock Text="{Binding L[confirm]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalReturnAmount, StringFormat='({0:N0})'}"
                                           FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Thin separator -->
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- 2-column body -->
                    <Grid ColumnDefinitions="280,1,*">

                        <!-- LEFT PANEL: Original sale details + Return summary -->
                        <ScrollViewer Grid.Column="0" Padding="20">
                            <StackPanel Spacing="14">

                                <!-- Sale Badge Header -->
                                <Border Background="{DynamicResource SidebarItemActive}" CornerRadius="10" Padding="12,10"
                                        DataContext="{Binding ReturningSale}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [sale_details], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrandPrimaryBrush}" />
                                        <TextBlock Text="{Binding ReceiptToken}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Meta info -->
                                <StackPanel Spacing="7" DataContext="{Binding ReturningSale}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding [sale_date], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SaleDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding [cashier], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding CustomerName, Converter={x:Static conv:NullToBoolConverter.Instance}}">
                                        <TextBlock Text="{Binding [customer], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                                <!-- Original Sale Payment Summary -->
                                <StackPanel Spacing="6" DataContext="{Binding ReturningSale}">
                                    <TextBlock Text="{Binding [payment], Source={x:Static svc:LocalizationManager.Instance}}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding [total], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}"
                                                   FontWeight="Bold" FontSize="13" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding PaidCash, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [cash], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PaidCash, StringFormat='{}{0:N0}'}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding PaidCard, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [card], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PaidCard, StringFormat='{}{0:N0}'}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding PaidBonus, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [bonus], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PaidBonus, StringFormat='{}{0:N0}'}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding DebtAmount, Converter={x:Static conv:NonZeroConverter.Instance}}">
                                        <TextBlock Text="{Binding [debt], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   Foreground="{DynamicResource DangerBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DebtAmount, StringFormat='{}{0:N0}'}"
                                                   FontSize="12" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                                <!-- Return Summary Card -->
                                <Border Background="{DynamicResource DangerBg}" CornerRadius="10" Padding="12"
                                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding [return], Source={x:Static svc:LocalizationManager.Instance}}"
                                                   FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding [products], Source={x:Static svc:LocalizationManager.Instance}}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalReturnItemCount}"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding [amount], Source={x:Static svc:LocalizationManager.Instance}}"
                                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalReturnAmount, StringFormat='{}{0:N0}'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Vertical divider -->
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

                        <!-- RIGHT PANEL: Return items list -->
                        <DockPanel Grid.Column="2">
                            <!-- Header row -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarItemHover}" CornerRadius="0,16,0,0">
                                <Grid ColumnDefinitions="*,80,110,90">
                                    <TextBlock Grid.Column="0" Text="{Binding [product], Source={x:Static svc:LocalizationManager.Instance}}"
                                               Padding="20,10,8,10" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding [remaining], Source={x:Static svc:LocalizationManager.Instance}}"
                                               Padding="8,10" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding [return_qty], Source={x:Static svc:LocalizationManager.Instance}}"
                                               Padding="8,10" FontWeight="SemiBold" FontSize="12" TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="3" Text="{Binding [amount], Source={x:Static svc:LocalizationManager.Instance}}"
                                               Padding="8,10,20,10" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                            </Border>

                            <!-- Items -->
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding ReturnLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReturnLineItem">
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                                                <StackPanel Spacing="8">
                                                    <!-- Main row -->
                                                    <Grid ColumnDefinitions="*,80,110,90">
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N0} so\'m'}"
                                                                       FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Remaining, StringFormat='{}{0:0.###}'}"
                                                                   VerticalAlignment="Center" TextAlignment="Right" Padding="8,0"
                                                                   FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                                                        <NumericUpDown Grid.Column="2" Value="{Binding Quantity, Converter={x:Static conv:EmptyToZeroConverter.Instance}}"
                                                                       Minimum="0" Maximum="{Binding Remaining}" Increment="1"
                                                                       FormatString="0.###" Width="100" HorizontalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat='{}{0:N0}'}"
                                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                                   FontWeight="Bold" FontSize="13"
                                                                   Foreground="{DynamicResource DangerBrush}" />
                                                    </Grid>

                                                    <!-- Options row: restock + reason -->
                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding Restock}" VerticalAlignment="Center"
                                                                  Content="{Binding [restock], Source={x:Static svc:LocalizationManager.Instance}}" />
                                                        <TextBox Grid.Column="1" Margin="12,0,0,0" Text="{Binding Reason}"
                                                                 PlaceholderText="{Binding [reason], Source={x:Static svc:LocalizationManager.Instance}}"
                                                                 Height="32" FontSize="12" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
