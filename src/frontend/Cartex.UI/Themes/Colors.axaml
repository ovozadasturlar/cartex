<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BrandColor">#2563EB</Color>
    <Color x:Key="BrandHoverColor">#1D4ED8</Color>
    <Color x:Key="BrandLightColor">#DBEAFE</Color>

    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessHoverColor">#15803D</Color>
    <Color x:Key="SuccessLightColor">#DCFCE7</Color>

    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerHoverColor">#B91C1C</Color>
    <Color x:Key="DangerLightColor">#FEE2E2</Color>

    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningHoverColor">#D97706</Color>
    <Color x:Key="WarningLightColor">#FEF3C7</Color>

    <Color x:Key="LightBgColor">#F8FAFC</Color>
    <Color x:Key="LightFgColor">#0F172A</Color>
    <Color x:Key="LightCardColor">#FFFFFF</Color>
    <Color x:Key="LightBorderColor">#E2E8F0</Color>
    <Color x:Key="LightSidebarColor">#F1F5F9</Color>
    <Color x:Key="LightMutedColor">#64748B</Color>

    <Color x:Key="DarkBgColor">#0F172A</Color>
    <Color x:Key="DarkFgColor">#F8FAFC</Color>
    <Color x:Key="DarkCardColor">#1E293B</Color>
    <Color x:Key="DarkBorderColor">#334155</Color>
    <Color x:Key="DarkSidebarColor">#1E293B</Color>
    <Color x:Key="DarkMutedColor">#94A3B8</Color>

</ResourceDictionary>
