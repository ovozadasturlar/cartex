<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cartex.UI.Views.SalesHistoryView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*" Margin="24">

        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,16">
            <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                        MinWidth="160" MinHeight="36" Margin="0,0,8,0" />
            <DatePicker Grid.Column="1" SelectedDate="{Binding DateTo, Mode=TwoWay}"
                        MinWidth="160" MinHeight="36" Margin="0,0,8,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding L[refresh]}" Classes="brand"
                        Command="{Binding LoadCommand}" />
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Sales}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}"
                  CornerRadius="6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="60" />
                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="160" />
                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, Mode=OneWay, StringFormat='{}{0:N0}'}" Width="120" />
                <DataGridTextColumn Header="Cash" Binding="{Binding PaidCash, Mode=OneWay, StringFormat='{}{0:N0}'}" Width="100" />
                <DataGridTextColumn Header="Card" Binding="{Binding PaidCard, Mode=OneWay, StringFormat='{}{0:N0}'}" Width="100" />
                <DataGridTextColumn Header="Debt" Binding="{Binding DebtAmount, Mode=OneWay, StringFormat='{}{0:N0}'}" Width="100" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="100" />
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, Mode=OneWay}" Width="150" />
                <DataGridTextColumn Header="Sold By" Binding="{Binding UserName, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Top" Height="4" />
    </Grid>
</UserControl>
