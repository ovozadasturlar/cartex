<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.LoginView"
             x:CompileBindings="False">

    <Grid Background="{DynamicResource AppBg}"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Border Classes="card" VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="420" Padding="40,36">
            <StackPanel Spacing="20">

                <Image Source="avares://Cartex.UI/Assets/logo.png"
                       Width="72" Height="72"
                       HorizontalAlignment="Center" Margin="0,0,0,4" />

                <TextBlock Text="Cartex POS"
                           Classes="title"
                           HorizontalAlignment="Center"
                           FontSize="28" />

                <TextBlock Text="{Binding L[login]}"
                           Classes="muted"
                           HorizontalAlignment="Center"
                           FontSize="14" />

                <TextBox Watermark="{Binding L[username]}"
                         Text="{Binding Username, Mode=TwoWay}"
                         Classes="search"
                         FontSize="16" />

                <TextBox Watermark="{Binding L[password]}"
                         Text="{Binding Password, Mode=TwoWay}"
                         PasswordChar="●"
                         RevealPassword="False"
                         Classes="search"
                         FontSize="16" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />

                <Button Content="{Binding L[login_button]}"
                        Command="{Binding LoginCommand}"
                        Classes="brand"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        MinHeight="48"
                        FontSize="18"
                        IsEnabled="{Binding !IsLoading}" />

                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}"
                             Height="4" />

            </StackPanel>
        </Border>

        <!-- Bottom-right quick settings -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Orientation="Horizontal" Margin="20,16" Spacing="2">
            <Panel>
                <Button Background="Transparent" BorderThickness="0"
                        Padding="8,6" Cursor="Hand" Opacity="0.7"
                        Command="{Binding ToggleThemePopupCommand}" ToolTip.Tip="Theme">
                    <mi:MaterialIcon Kind="{Binding ThemeIcon}" Width="18" Height="18"
                                     Foreground="{DynamicResource TextSecondary}" />
                </Button>
                <Popup IsOpen="{Binding IsThemePopupOpen, Mode=TwoWay}"
                       Placement="Top" IsLightDismissEnabled="True">
                    <Border Background="{DynamicResource CardBg}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="4" MinWidth="160">
                        <StackPanel Spacing="2">
                            <Button Background="Transparent" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8"
                                    Command="{Binding SelectThemeCommand}" CommandParameter="Light">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="WeatherSunny" Width="18" Height="18" />
                                    <TextBlock Text="Light" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="Transparent" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8"
                                    Command="{Binding SelectThemeCommand}" CommandParameter="Dark">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="WeatherNight" Width="18" Height="18" />
                                    <TextBlock Text="Dark" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Panel>

            <Panel>
                <Button Background="Transparent" BorderThickness="0"
                        Padding="8,6" Cursor="Hand" Opacity="0.7"
                        Command="{Binding ToggleModePopupCommand}" ToolTip.Tip="Mode">
                    <mi:MaterialIcon Kind="{Binding ModeIcon}" Width="18" Height="18"
                                     Foreground="{DynamicResource TextSecondary}" />
                </Button>
                <Popup IsOpen="{Binding IsModePopupOpen, Mode=TwoWay}"
                       Placement="Top" IsLightDismissEnabled="True">
                    <Border Background="{DynamicResource CardBg}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="4" MinWidth="160">
                        <StackPanel Spacing="2">
                            <Button Background="Transparent" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8"
                                    Command="{Binding SelectModeCommand}" CommandParameter="Desktop">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="Monitor" Width="18" Height="18" />
                                    <TextBlock Text="Desktop" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="Transparent" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8"
                                    Command="{Binding SelectModeCommand}" CommandParameter="Touch">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="GestureTap" Width="18" Height="18" />
                                    <TextBlock Text="Touch" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Panel>

            <Panel>
                <Button Background="Transparent" BorderThickness="0"
                        Padding="8,6" Cursor="Hand" Opacity="0.7"
                        Command="{Binding ToggleLanguagePopupCommand}" ToolTip.Tip="Language">
                    <Border Background="{DynamicResource BorderBrush}" CornerRadius="3" Padding="5,2">
                        <TextBlock Text="{Binding CurrentLanguageFlag}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </Button>
                <Popup IsOpen="{Binding IsLanguagePopupOpen, Mode=TwoWay}"
                       Placement="Top" IsLightDismissEnabled="True">
                    <Border Background="{DynamicResource CardBg}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="4" MinWidth="200">
                        <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Padding="12,8"
                                            Command="{Binding $parent[UserControl].DataContext.SelectLanguageCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{DynamicResource BorderBrush}" CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageFlagConverter.Instance}}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                            </Border>
                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageDisplayConverter.Instance}}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Panel>
        </StackPanel>

    </Grid>
</UserControl>
