<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.TransactionsView"
             x:CompileBindings="False">

    <DockPanel Margin="24">
        <c:PageHeader DockPanel.Dock="Top" Title="{Binding L[transactions]}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox MinWidth="130" VerticalAlignment="Center"
                          ItemsSource="{Binding Paging.SortOptions}" SelectedItem="{Binding Paging.SelectedSort}" />
                <Button Classes="icon" Command="{Binding Paging.ToggleDirectionCommand}" ToolTip.Tip="{Binding L[sort]}">
                    <Panel>
                        <mi:MaterialIcon Kind="SortAscending" Width="18" Height="18" IsVisible="{Binding !Paging.Descending}" />
                        <mi:MaterialIcon Kind="SortDescending" Width="18" Height="18" IsVisible="{Binding Paging.Descending}" />
                    </Panel>
                </Button>
                <c:ExportButton Command="{Binding ExportCommand}" Text="{Binding L[export]}" IsVisible="{Binding CanExport}" />
            </StackPanel>
        </c:PageHeader>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,16">
            <TextBlock Text="{Binding L[date_from]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,16,0" />
            <TextBlock Grid.Column="2" Text="{Binding L[date_to]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <DatePicker Grid.Column="3" SelectedDate="{Binding DateTo, Mode=TwoWay}" MinWidth="150" MinHeight="36" Margin="8,0,16,0" />
            <ComboBox Grid.Column="4" MinWidth="160" VerticalAlignment="Center"
                      ItemsSource="{Binding OperationTypeOptions}" SelectedItem="{Binding SelectedOperationType}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=op}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="5" Classes="brand" Command="{Binding RefreshCommand}" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" />
                    <TextBlock Text="{Binding L[refresh]}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <c:Pager DockPanel.Dock="Bottom" State="{Binding Paging}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding L[total]}" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="{Binding Totals.TotalAmount, StringFormat='{}{0:N0}'}" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrandPrimaryBrush}" />
            </StackPanel>
        </c:Pager>
        <Panel>
            <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="Auto" Binding="{Binding CreatedAt, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                            Header="{Binding [time], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding OperationType, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=op}"
                                            Header="{Binding [operation_type], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="*" Binding="{Binding FromAccountName}"
                                            Header="{Binding [from_account], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="*" Binding="{Binding ToAccountName}"
                                            Header="{Binding [to_account], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding Amount, StringFormat='{}{0:N0}'}"
                                            Header="{Binding [amount], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding Currency}"
                                            Header="{Binding [currency], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding UserName}"
                                            Header="{Binding [user], Source={x:Static svc:LocalizationManager.Instance}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <c:EmptyState Icon="SwapHorizontal" Title="{Binding L[no_data]}" IsVisible="{Binding IsEmpty}" />
        </Panel>
    </DockPanel>
</UserControl>
