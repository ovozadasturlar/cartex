<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.MainView"
             x:CompileBindings="False">

    <DockPanel Background="{DynamicResource AppBg}">

        <!-- ===== DESKTOP SIDEBAR (docked left) ===== -->
        <Border DockPanel.Dock="Left" Width="250"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding !IsTouchMode}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16" Spacing="2">
                    <TextBlock Text="Cartex POS" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                </StackPanel>

                <Separator DockPanel.Dock="Top" Background="{DynamicResource BorderBrush}" Height="1" />

                <StackPanel DockPanel.Dock="Bottom" Margin="12,8" Spacing="6">
                    <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="0,0,0,4" />

                    <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="☀️" FontSize="14" VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                          OnContent="🌙" OffContent=""
                                          Padding="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="👆" FontSize="14" VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="{Binding IsTouchMode, Mode=TwoWay}"
                                          OnContent="" OffContent=""
                                          Padding="0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding CurrentLanguage, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" Margin="4,0" MinHeight="32">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <ListBox ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                         Margin="0,8" Padding="4" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="{Binding Icon}" FontSize="18"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Border Grid.Column="2" Width="4" Height="20" CornerRadius="2"
                                            Background="{DynamicResource BrandPrimaryBrush}"
                                            IsVisible="{Binding IsActive}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== DESKTOP HEADER (docked top) ===== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,14"
                IsVisible="{Binding !IsTouchMode}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" FontSize="14"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding UserRole}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="{Binding L[logout]}" Command="{Binding LogoutCommand}"
                            Classes="danger" Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TOUCH BOTTOM TAB BAR (docked bottom) ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="4,2"
                IsVisible="{Binding IsTouchMode}">
            <Grid>
                <ItemsControl ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="4,6" MinHeight="60"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding $parent[UserControl].DataContext.SelectMenuItemCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="24"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="80" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ===== TOUCH SETTINGS OVERLAY (docked top, only in touch mode) ===== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,6"
                IsVisible="{Binding IsTouchSettingsVisible}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="☀️" FontSize="16" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                  OnContent="🌙" OffContent="" Padding="0" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding CurrentLanguage, Mode=TwoWay}"
                          MinWidth="140" MinHeight="40" Margin="16,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageDisplayConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="👆" FontSize="16" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding IsTouchMode, Mode=TwoWay}"
                                  OnContent="" OffContent="" Padding="0" />
                </StackPanel>
                <Button Grid.Column="4" Content="✕" FontSize="18"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding ToggleTouchSettingsCommand}"
                        Padding="8,4" MinHeight="40" />
            </Grid>
        </Border>

        <!-- ===== TOUCH TOP BAR with settings gear (docked top) ===== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,8"
                IsVisible="{Binding IsTouchMode}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="⚙️" FontSize="22"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding ToggleTouchSettingsCommand}"
                        Padding="8,4" MinHeight="48" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="🚪" FontSize="22"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding LogoutCommand}"
                        Padding="8,4" MinHeight="48" />
            </Grid>
        </Border>

        <!-- ===== SINGLE CONTENT AREA (fills remaining space) ===== -->
        <ContentControl Content="{Binding CurrentPage}" />

    </DockPanel>
</UserControl>
