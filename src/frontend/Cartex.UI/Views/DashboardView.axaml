<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.DashboardView"
             x:CompileBindings="False">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20">

            <TextBlock Text="{Binding WelcomeMessage}" Classes="title" />

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                         Height="4" Margin="0,0,0,4" />

            <TextBlock Text="{Binding L[quick_actions]}" Classes="subtitle" Margin="0,12,0,0" />

            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{Binding L[new_sale]}" Classes="brand" Margin="0,0,12,12"
                        MinWidth="160" MinHeight="60" FontSize="16"
                        Command="{Binding GoToSalesCommand}"
                        HorizontalContentAlignment="Center" />
                <Button Content="{Binding L[add_product]}" Classes="success" Margin="0,0,12,12"
                        MinWidth="160" MinHeight="60" FontSize="16"
                        Command="{Binding GoToProductsCommand}"
                        HorizontalContentAlignment="Center" />
                <Button Content="{Binding L[customers]}" Classes="outline" Margin="0,0,12,12"
                        MinWidth="160" MinHeight="60" FontSize="16"
                        Command="{Binding GoToCustomersCommand}"
                        HorizontalContentAlignment="Center" />
            </WrapPanel>

            <Grid ColumnDefinitions="*,*,*,*" Margin="0,8,0,0">
                <Border Classes="card" Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="Cart" Width="36" Height="36" HorizontalAlignment="Center"
                                         Foreground="{DynamicResource BrandPrimaryBrush}" />
                        <TextBlock Text="{Binding L[today_sales]}" Classes="muted"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TodaySales, StringFormat={}{0:N0}}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Grid.Column="1" Margin="4,0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="CashMultiple" Width="36" Height="36" HorizontalAlignment="Center"
                                         Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{Binding L[today_profit]}" Classes="muted"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TodayProfit, StringFormat={}{0:N0}}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Grid.Column="2" Margin="4,0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="AlertCircleOutline" Width="36" Height="36" HorizontalAlignment="Center"
                                         Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{Binding L[low_stock]}" Classes="muted"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LowStockCount}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Grid.Column="3" Margin="8,0,0,0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="Package" Width="36" Height="36" HorizontalAlignment="Center"
                                         Foreground="{DynamicResource InfoBrush}" />
                        <TextBlock Text="{Binding L[total_products]}" Classes="muted"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalProducts}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource InfoBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="2.5*,12,*" Margin="0,8,0,0">
                <Border Classes="card" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[cash_flow]}" Classes="subtitle" Margin="0,0,0,12" />
                        <lvc:CartesianChart Series="{Binding CashFlowSeries}"
                                            XAxes="{Binding CashFlowXAxes}"
                                            YAxes="{Binding CashFlowYAxes}"
                                            MinHeight="280"
                                            LegendPosition="Top"
                                            LegendTextSize="12"
                                            TooltipTextSize="12" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[category_breakdown]}" Classes="subtitle" Margin="0,0,0,12" />
                        <c:MiniBarChart Columns="{Binding CategoryBars}" />
                    </DockPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">

                <Border Classes="card" Grid.Column="0" Margin="0,0,8,0" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[recent_transactions]}"
                                   Classes="subtitle" Margin="0,0,0,12" />
                        <ScrollViewer MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding RecentTransactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10"
                                                Background="{DynamicResource AppBg}"
                                                CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding OperationType, Converter={x:Static conv:EnumLocalizationConverter.Instance}, ConverterParameter=op}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Amount, StringFormat={}{0:N0}}"
                                                           FontWeight="Bold" FontSize="16"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrandPrimaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Classes="card" Grid.Column="1" Margin="8,0,0,0" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[low_stock_alert]}"
                                   Classes="subtitle" Margin="0,0,0,12" />
                        <ScrollViewer MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding LowStockItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10"
                                                Background="{DynamicResource AppBg}"
                                                CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding ProductName}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding OnHand, StringFormat={}{0:N0}}"
                                                           FontWeight="Bold" FontSize="16"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            </Grid>

            <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                <Border Classes="card" Grid.Column="0" Margin="0,0,8,0" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[top_customer_profit]}"
                                   Classes="subtitle" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding TopCustomers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Profit, StringFormat={}{0:N0}}"
                                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border Classes="card" Grid.Column="1" Margin="8,0,0,0" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding L[top_product]}"
                                   Classes="subtitle" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Profit, StringFormat={}{0:N0}}"
                                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InfoBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
