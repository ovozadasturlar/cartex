<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:conv="using:Cartex.UI.Converters"
             xmlns:vm="using:Cartex.UI.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="Cartex.UI.Views.DesktopShell"
             x:CompileBindings="False">

    <DockPanel Background="{DynamicResource AppBg}">

        <Border DockPanel.Dock="Left"
                Width="{Binding IsSidebarCollapsed, Converter={x:Static conv:SidebarWidthConverter.Instance}}"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <DockPanel>

                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="12,12,8,10">
                    <Image Source="avares://Cartex.UI/Assets/logo.png"
                           Width="{Binding IsSidebarCollapsed, Converter={x:Static conv:SidebarWidthConverter.LogoSize}}"
                           Height="{Binding IsSidebarCollapsed, Converter={x:Static conv:SidebarWidthConverter.LogoSize}}"
                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="CARTEX" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource BrandPrimaryBrush}"
                               IsVisible="{Binding !IsSidebarCollapsed}" />
                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                            Padding="6" Cursor="Hand" VerticalAlignment="Center"
                            Command="{Binding ToggleSidebarCommand}"
                            IsVisible="{Binding !IsSidebarCollapsed}">
                        <mi:MaterialIcon Kind="Menu" Width="20" Height="20"
                                         Foreground="{DynamicResource TextSecondary}" />
                    </Button>
                </Grid>

                <Button DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                        Padding="0,6" Cursor="Hand" HorizontalAlignment="Center"
                        Command="{Binding ToggleSidebarCommand}"
                        IsVisible="{Binding IsSidebarCollapsed}"
                        ToolTip.Tip="Expand sidebar">
                    <mi:MaterialIcon Kind="Menu" Width="20" Height="20"
                                     Foreground="{DynamicResource TextSecondary}" />
                </Button>

                <Separator DockPanel.Dock="Top" Background="{DynamicResource BorderBrush}" Height="1" />

                <Border DockPanel.Dock="Bottom" Padding="8,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource BrandPrimaryBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserInitial}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                    IsVisible="{Binding !IsSidebarCollapsed}">
                            <TextBlock Text="{Binding UserDisplayName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="120" />
                            <TextBlock Text="{Binding UserRole}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="120" />
                        </StackPanel>
                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                Padding="6" Cursor="Hand" VerticalAlignment="Center"
                                Command="{Binding LogoutCommand}"
                                IsVisible="{Binding !IsSidebarCollapsed}"
                                ToolTip.Tip="{Binding L[logout]}">
                            <mi:MaterialIcon Kind="Logout" Width="18" Height="18"
                                             Foreground="{DynamicResource TextSecondary}" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,4" Spacing="2">
                    <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Center">
                        <Panel>
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="8,6" Cursor="Hand" HorizontalAlignment="Center"
                                    Command="{Binding ToggleThemePopupCommand}"
                                    ToolTip.Tip="Theme">
                                <mi:MaterialIcon Kind="{Binding ThemeIcon}" Width="18" Height="18" />
                            </Button>
                            <Popup IsOpen="{Binding IsThemePopupOpen, Mode=TwoWay}"
                                   Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource CardBg}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="4" MinWidth="160">
                                    <StackPanel Spacing="2">
                                        <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding SelectThemeCommand}"
                                                CommandParameter="Light">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="WeatherSunny" Width="18" Height="18" />
                                                <TextBlock Text="Light" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding SelectThemeCommand}"
                                                CommandParameter="Dark">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="WeatherNight" Width="18" Height="18" />
                                                <TextBlock Text="Dark" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Panel>

                        <Panel>
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="8,6" Cursor="Hand" HorizontalAlignment="Left"
                                    Command="{Binding ToggleModePopupCommand}"
                                    ToolTip.Tip="Mode">
                                <mi:MaterialIcon Kind="{Binding ModeIcon}" Width="18" Height="18" />
                            </Button>
                            <Popup IsOpen="{Binding IsModePopupOpen, Mode=TwoWay}"
                                   Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource CardBg}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="4" MinWidth="160">
                                    <StackPanel Spacing="2">
                                        <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding SelectModeCommand}"
                                                CommandParameter="Desktop">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="Monitor" Width="18" Height="18" />
                                                <TextBlock Text="Desktop" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding SelectModeCommand}"
                                                CommandParameter="Touch">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="GestureTap" Width="18" Height="18" />
                                                <TextBlock Text="Touch" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Panel>

                        <Panel>
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="8,6" Cursor="Hand" HorizontalAlignment="Center"
                                    Command="{Binding ToggleLanguagePopupCommand}"
                                    ToolTip.Tip="Language">
                                <mi:MaterialIcon Kind="Translate" Width="18" Height="18" />
                            </Button>
                            <Popup IsOpen="{Binding IsLanguagePopupOpen, Mode=TwoWay}"
                                   Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource CardBg}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="4" MinWidth="180">
                                    <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Padding="12,8"
                                                        Command="{Binding $parent[UserControl].DataContext.SelectLanguageCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageDisplayConverter.Instance}}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Panel>
                    </Grid>
                </StackPanel>

                <Separator DockPanel.Dock="Bottom" Background="{DynamicResource BorderBrush}" Height="1" />

                <ScrollViewer Margin="0,4">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Panel Margin="0,1,8,1">
                                    <Border CornerRadius="0,8,8,0" Background="Transparent"
                                            Classes.nav-active="{Binding IsActive}">
                                        <Button Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Command="{Binding $parent[UserControl].DataContext.SelectMenuItemCommand}"
                                                CommandParameter="{Binding}" Padding="16,10"
                                                ToolTip.Tip="{Binding Title}">
                                            <Grid ColumnDefinitions="22,*">
                                                <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20"
                                                    Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                                    VerticalAlignment="Center" Margin="14,0,0,0"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    IsVisible="{Binding !$parent[UserControl].DataContext.IsSidebarCollapsed}" />
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <Border Width="3" CornerRadius="0,1.5,1.5,0"
                                            Background="{DynamicResource BrandPrimaryBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                            Margin="0,4" IsVisible="{Binding IsActive}" />
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                           Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:dddd, dd MMMM yyyy}'}" />
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentPage}" />

    </DockPanel>
</UserControl>
