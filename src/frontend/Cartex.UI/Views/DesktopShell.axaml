<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:conv="using:Cartex.UI.Converters"
             x:Class="Cartex.UI.Views.DesktopShell"
             x:CompileBindings="False">

    <DockPanel Background="{DynamicResource AppBg}">

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="250"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo + App name -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,16,12" Spacing="10">
                    <Image Source="avares://Cartex.UI/Assets/logo.png" Width="36" Height="36" />
                    <TextBlock Text="Cartex POS" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                </StackPanel>

                <Separator DockPanel.Dock="Top" Background="{DynamicResource BorderBrush}" Height="1" />

                <!-- Settings: Theme, Mode, Language popup buttons -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8" Spacing="6">
                    <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="0,0,0,4" />

                    <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                        <!-- Theme popup button -->
                        <Panel>
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="10,6" Cursor="Hand"
                                    Command="{Binding ToggleThemePopupCommand}">
                                <mi:MaterialIcon Kind="{Binding ThemeIcon}" Width="20" Height="20" />
                            </Button>
                            <Popup IsOpen="{Binding IsThemePopupOpen, Mode=TwoWay}"
                                   Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource CardBg}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="4" MinWidth="160">
                                    <StackPanel Spacing="2">
                                        <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding SelectThemeCommand}"
                                                CommandParameter="Light">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="WeatherSunny" Width="18" Height="18" />
                                                <TextBlock Text="Light" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding SelectThemeCommand}"
                                                CommandParameter="Dark">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="WeatherNight" Width="18" Height="18" />
                                                <TextBlock Text="Dark" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Panel>

                        <!-- Mode popup button -->
                        <Panel Margin="8,0">
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="10,6" Cursor="Hand"
                                    Command="{Binding ToggleModePopupCommand}">
                                <mi:MaterialIcon Kind="{Binding ModeIcon}" Width="20" Height="20" />
                            </Button>
                            <Popup IsOpen="{Binding IsModePopupOpen, Mode=TwoWay}"
                                   Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource CardBg}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="4" MinWidth="160">
                                    <StackPanel Spacing="2">
                                        <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding SelectModeCommand}"
                                                CommandParameter="Desktop">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="Monitor" Width="18" Height="18" />
                                                <TextBlock Text="Desktop" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding SelectModeCommand}"
                                                CommandParameter="Touch">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mi:MaterialIcon Kind="GestureTap" Width="18" Height="18" />
                                                <TextBlock Text="Touch" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Panel>

                        <!-- Language popup button -->
                        <Panel>
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="10,6" Cursor="Hand"
                                    Command="{Binding ToggleLanguagePopupCommand}">
                                <mi:MaterialIcon Kind="Translate" Width="20" Height="20" />
                            </Button>
                            <Popup IsOpen="{Binding IsLanguagePopupOpen, Mode=TwoWay}"
                                   Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource CardBg}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="4" MinWidth="180">
                                    <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Padding="12,8"
                                                        Command="{Binding $parent[UserControl].DataContext.SelectLanguageCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageDisplayConverter.Instance}}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Panel>
                    </Grid>
                </StackPanel>

                <!-- Menu items -->
                <ListBox ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                         Margin="0,8" Padding="4" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Border Grid.Column="2" Width="4" Height="20" CornerRadius="2"
                                            Background="{DynamicResource BrandPrimaryBrush}"
                                            IsVisible="{Binding IsActive}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" FontSize="14"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding UserRole}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Classes="danger" Padding="12,6"
                            Command="{Binding LogoutCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="Logout" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding L[logout]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ContentControl Content="{Binding CurrentPage}" />

    </DockPanel>
</UserControl>
