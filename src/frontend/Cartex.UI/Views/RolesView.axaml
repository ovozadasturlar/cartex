<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cartex.UI.Views.RolesView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Text="{Binding L[roles]}" Classes="title" />
            <Button Grid.Column="1" Content="{Binding L[refresh]}" Classes="outline"
                    Command="{Binding LoadCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*">

            <DataGrid x:Name="RolesGrid"
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      CornerRadius="6"
                      Margin="0,0,8,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="60" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=OneWay}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Classes="card" Margin="8,0,0,0" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding L[permissions]}" Classes="subtitle" />

                    <TextBlock Text="{Binding SelectedRole.Name}"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource BrandPrimaryBrush}" />

                    <ScrollViewer MaxHeight="400">
                        <ItemsControl ItemsSource="{Binding SelectedRole.Permissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="True" IsEnabled="False" Margin="4,2"
                                              Content="{Binding}" FontSize="13"
                                              Foreground="{DynamicResource TextPrimary}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Top" Height="4" Margin="0,8,0,0" />
    </Grid>
</UserControl>
