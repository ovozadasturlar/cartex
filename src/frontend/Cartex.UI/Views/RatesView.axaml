<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cartex.UI.Controls"
             xmlns:svc="using:Cartex.UI.Services"
             x:Class="Cartex.UI.Views.RatesView"
             x:CompileBindings="False">

    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left" Spacing="16">
            <c:PageHeader Title="{Binding L[exchange_rates]}" />

            <Border Background="{DynamicResource DangerBg}" CornerRadius="10" Padding="12,10"
                    IsVisible="{Binding IsFeatureOff}">
                <TextBlock Text="{Binding L[multicurrency_off_hint]}" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" />
            </Border>

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding L[base_currency]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BaseCurrency}" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                        <ComboBox MinWidth="110" ItemsSource="{Binding Codes}" SelectedItem="{Binding NewCode}" />
                        <NumericUpDown Grid.Column="2" Value="{Binding NewRate}" Minimum="0" FormatString="N2"
                                       ShowButtonSpinner="False" MinHeight="38" />
                        <Button Grid.Column="4" Classes="brand" MinWidth="120" HorizontalContentAlignment="Center"
                                Command="{Binding SaveCommand}" Content="{Binding L[save]}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Rates}" SelectedItem="{Binding SelectedRate}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="240">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="Auto" Binding="{Binding Code}"
                                            Header="{Binding [currency], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="*" Binding="{Binding Rate, StringFormat='{}{0:N2}'}"
                                            Header="{Binding [rate], Source={x:Static svc:LocalizationManager.Instance}}" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding EffectiveAt, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                            Header="{Binding [date], Source={x:Static svc:LocalizationManager.Instance}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Background="{DynamicResource CardBg}" CornerRadius="12" ClipToBounds="True"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    IsVisible="{Binding History.Count}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[rate_history]}" Classes="subtitle" Margin="16,12,16,4" />
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding Rate, StringFormat='{}{0:N2}'}"
                                                Header="{Binding [rate], Source={x:Static svc:LocalizationManager.Instance}}" />
                            <DataGridTextColumn Width="Auto" Binding="{Binding EffectiveAt, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                Header="{Binding [date], Source={x:Static svc:LocalizationManager.Instance}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
