<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cartex.UI.ViewModels"
             x:Class="Cartex.UI.Views.SettingsView"
             x:CompileBindings="False">

    <TabControl Margin="16">
        <TabItem Header="{Binding L[users]}">
            <ContentControl Content="{Binding UsersVm}" Margin="0,8,0,0" />
        </TabItem>
        <TabItem Header="{Binding L[customers]}">
            <ContentControl Content="{Binding CustomersVm}" Margin="0,8,0,0" />
        </TabItem>
        <TabItem Header="{Binding L[roles]}">
            <ContentControl Content="{Binding RolesVm}" Margin="0,8,0,0" />
        </TabItem>
        <TabItem Header="{Binding L[general]}">
            <ScrollViewer Padding="24">
                <StackPanel Spacing="16" MaxWidth="600">
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding L[api_url]}" Classes="subtitle" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding ApiUrl, Mode=TwoWay}" Classes="search" />
                                <Button Grid.Column="1" Content="{Binding L[save]}"
                                        Classes="brand" Margin="8,0,0,0"
                                        Command="{Binding SaveApiUrlCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding L[appearance]}" Classes="subtitle" />
                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Text="{Binding L[theme]}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedTheme}" MinWidth="200" />

                                <TextBlock Grid.Row="1" Text="{Binding L[mode]}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableModes}"
                                          SelectedItem="{Binding SelectedMode}" MinWidth="200" Margin="0,8,0,0" />

                                <TextBlock Grid.Row="2" Text="{Binding L[language]}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableLanguages}"
                                          SelectedItem="{Binding SelectedLanguage}" MinWidth="200" Margin="0,8,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
