<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cartex.UI.ViewModels"
             x:Class="Cartex.UI.Views.SalesView"
             x:CompileBindings="False">

    <Grid ColumnDefinitions="*,360" Margin="16">

        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBox Watermark="{Binding L[scan_barcode]}"
                         Text="{Binding BarcodeInput, Mode=TwoWay}"
                         Classes="search" MinHeight="44" FontSize="16" />
                <Button Grid.Column="1" Content="{Binding L[add]}"
                        Classes="brand" Margin="8,0,0,0" MinHeight="44"
                        Command="{Binding AddByBarcodeCommand}" />
            </Grid>

            <DataGrid Grid.Row="1"
                      x:Name="StocksGrid" ItemsSource="{Binding AvailableStocks}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      CornerRadius="6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="*" />
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80" />
                    <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice}" Width="100" />
                    <DataGridTemplateColumn Header="" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+" Classes="brand" Padding="8,2"
                                        Command="{Binding $parent[UserControl].((vm:SalesViewModel)DataContext).AddStockToCartCommand}"
                                        CommandParameter="{Binding}" MinHeight="28" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Classes="card" Padding="16">
            <DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="{Binding L[cart]}"
                           Classes="subtitle" Margin="0,0,0,12" />

                <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                    <Separator Background="{DynamicResource BorderBrush}" Height="1" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                        <TextBlock Text="{Binding L[total]}" FontWeight="Bold" FontSize="16"
                                   Grid.Row="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2}}"
                                   Grid.Row="0" Grid.Column="1" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource BrandPrimaryBrush}" />

                        <TextBlock Text="{Binding L[cash]}" Grid.Row="1" Margin="0,8,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                        <TextBox Text="{Binding PaidCash, Mode=TwoWay}" Grid.Row="1" Grid.Column="1"
                                 Margin="0,8,0,0" MinHeight="36" />

                        <TextBlock Text="{Binding L[card]}" Grid.Row="2" Margin="0,6,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                        <TextBox Text="{Binding PaidCard, Mode=TwoWay}" Grid.Row="2" Grid.Column="1"
                                 Margin="0,6,0,0" MinHeight="36" />

                        <TextBlock Text="{Binding L[bonus]}" Grid.Row="3" Margin="0,6,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                        <TextBox Text="{Binding PaidBonus, Mode=TwoWay}" Grid.Row="3" Grid.Column="1"
                                 Margin="0,6,0,0" MinHeight="36" />

                        <TextBlock Text="{Binding L[change]}" Grid.Row="4" Margin="0,8,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding ChangeAmount, StringFormat={}{0:N2}}"
                                   Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"
                                   HorizontalAlignment="Right" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}" FontSize="16" />
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap" Margin="0,4" />

                    <Button Content="{Binding L[complete_sale]}"
                            Classes="success"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            MinHeight="56" FontSize="18" FontWeight="Bold"
                            Command="{Binding CompleteSaleCommand}"
                            IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding CartItems}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="8"
                                        Background="{DynamicResource AppBg}"
                                        CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                                <Run Text="{Binding Quantity}" />
                                                <Run Text=" × " />
                                                <Run Text="{Binding UnitPrice, StringFormat={}{0:N2}}" />
                                                <Run Text=" = " />
                                                <Run Text="{Binding LineTotal, StringFormat={}{0:N2}}" FontWeight="Bold" />
                                            </TextBlock>
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="1" Value="{Binding Quantity, Mode=TwoWay}"
                                                       Minimum="0.01" Increment="1" FormatString="N2"
                                                       Width="100" Margin="8,0" MinHeight="32" />
                                        <Button Grid.Column="2" Content="✕" Classes="danger"
                                                Padding="6,2" MinHeight="28"
                                                Command="{Binding $parent[UserControl].((vm:SalesViewModel)DataContext).RemoveCartItemCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
