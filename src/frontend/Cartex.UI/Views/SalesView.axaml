<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Cartex.UI.Controls"
             x:Class="Cartex.UI.Views.SalesView"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Button.pcard">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Width" Value="158" />
            <Setter Property="Height" Value="104" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.pcard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
        </Style>

        <Style Selector="Button.chip">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.chip.active">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.step">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHover}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.paybtn">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,430" Background="{DynamicResource AppBg}">

        <DockPanel Grid.Column="0" Margin="16,16,8,16">

            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,12">
                <TextBox x:Name="ScanBox" Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="{Binding L[scan_barcode]}" BorderThickness="0" FontSize="16" MinHeight="44"
                         Background="Transparent">
                    <TextBox.InnerLeftContent>
                        <mi:MaterialIcon Kind="BarcodeScan" Width="22" Height="22" Margin="10,0,4,0"
                                         Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </TextBox.InnerLeftContent>
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ScanCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
            </Border>

            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="chip" Classes.active="{Binding IsSelected}"
                                    Command="{Binding $parent[UserControl].DataContext.SelectCategoryCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer>
                <Panel>
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="pcard"
                                        Command="{Binding $parent[UserControl].DataContext.AddStockToCartCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid RowDefinitions="*,Auto">
                                        <TextBlock Text="{Binding ProductName}" TextWrapping="Wrap"
                                                   FontSize="13" FontWeight="SemiBold" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding SellingPrice, StringFormat='{}{0:N0}'}"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{DynamicResource BrandPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Quantity, StringFormat='{}{0:N0}'}" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <c:EmptyState Icon="PackageVariant" Title="{Binding L[no_data]}"
                                  IsVisible="{Binding !Products.Count}" />
                </Panel>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Column="1" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="16">

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                    <TextBlock Text="{Binding L[cart]}" Classes="h2" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="paybtn" Padding="10,6" Margin="0,0,8,0"
                            Command="{Binding ToggleHeldPanelCommand}" ToolTip.Tip="{Binding L[held_sales]}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="PauseCircleOutline" Width="18" Height="18" />
                            <TextBlock Text="{Binding HeldSales.Count}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="paybtn" Padding="8,6"
                            Command="{Binding ClearCartCommand}" ToolTip.Tip="{Binding L[cancel]}"
                            IsEnabled="{Binding !IsCartEmpty}">
                        <mi:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18"
                                         Foreground="{DynamicResource DangerBrush}" />
                    </Button>
                </Grid>

                <Border DockPanel.Dock="Top" Margin="0,0,0,10" CornerRadius="8"
                        Background="{DynamicResource AppBg}" Padding="10,8">
                    <Panel>
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding ToggleCustomerPanelCommand}"
                                IsVisible="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="AccountPlusOutline" Width="20" Height="20"
                                                 Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding L[customer]}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Button>
                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCustomer.FullName}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding SelectedCustomer.CashbackBalance, StringFormat='{}{0:N0} 🎁'}" />
                            </StackPanel>
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4"
                                    Cursor="Hand" Command="{Binding ClearCustomerCommand}">
                                <mi:MaterialIcon Kind="Close" Width="16" Height="16"
                                                 Foreground="{DynamicResource TextMuted}" />
                            </Button>
                        </Grid>
                    </Panel>
                </Border>

                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding L[subtotal]}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat='{}{0:N0}'}"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,120">
                            <TextBlock Text="{Binding L[discount]}" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding DiscountAmount}" Minimum="0"
                                           FormatString="N0" ShowButtonSpinner="False" MinHeight="34" />
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Height="1" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding L[total]}" Classes="h3" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource BrandPrimaryBrush}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{Binding L[cash]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <NumericUpDown Value="{Binding PaidCash}" Minimum="0" FormatString="N0"
                                               ShowButtonSpinner="False" MinHeight="38" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0">
                                <TextBlock Text="{Binding L[card]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <NumericUpDown Value="{Binding PaidCard}" Minimum="0" FormatString="N0"
                                               ShowButtonSpinner="False" MinHeight="38" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="{Binding L[bonus]}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <NumericUpDown Value="{Binding PaidBonus}" Minimum="0" FormatString="N0"
                                               ShowButtonSpinner="False" MinHeight="38" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*">
                            <Button Classes="paybtn" Padding="12,8" Command="{Binding PayExactCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="CashMultiple" Width="16" Height="16" />
                                    <TextBlock Text="{Binding L[exact]}" />
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Right" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding ChangeAmount}"
                                           Text="{Binding ChangeAmount, StringFormat='{}{0:N0}'}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}"
                                           IsVisible="{Binding DebtAmount}"
                                           Text="{Binding DebtAmount, StringFormat='{}{0:N0}'}" />
                            </StackPanel>
                        </Grid>

                        <Button Classes="brand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                MinHeight="50" FontSize="17" Command="{Binding CompleteSaleCommand}"
                                IsEnabled="{Binding !IsCartEmpty}"
                                Content="{Binding L[complete_sale]}" />

                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Center" Padding="6"
                                Command="{Binding OpenReceiptCommand}" IsVisible="{Binding HasLastReceipt}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="ReceiptTextOutline" Width="16" Height="16"
                                                 Foreground="{DynamicResource BrandPrimaryBrush}" />
                                <TextBlock Text="{Binding L[recent_transactions]}" FontSize="12"
                                           Foreground="{DynamicResource BrandPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer>
                    <Panel>
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="170"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                           Text="{Binding UnitPrice, StringFormat='{}{0:N0}'}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center" Margin="6,0">
                                                <Button Classes="step" Command="{Binding $parent[UserControl].DataContext.DecrementCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Minus" Width="14" Height="14" />
                                                </Button>
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:0.##}'}" MinWidth="28"
                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <Button Classes="step" Command="{Binding $parent[UserControl].DataContext.IncrementCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="64">
                                                <TextBlock Text="{Binding LineTotal, StringFormat='{}{0:N0}'}"
                                                           FontWeight="SemiBold" TextAlignment="Right"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <Button Background="Transparent" BorderThickness="0" Padding="2"
                                                        HorizontalAlignment="Right" Cursor="Hand"
                                                        Command="{Binding $parent[UserControl].DataContext.RemoveItemCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Close" Width="14" Height="14"
                                                                     Foreground="{DynamicResource TextMuted}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <c:EmptyState Icon="CartOutline" Title="{Binding L[no_items]}"
                                      IsVisible="{Binding IsCartEmpty}" Margin="0,40,0,0" />
                    </Panel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <Popup IsOpen="{Binding IsCustomerPanelOpen, Mode=TwoWay}" Placement="Center" IsLightDismissEnabled="True">
            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Width="420" Height="460"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16"
                    BoxShadow="0 12 40 0 #33000000">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[customers]}" Classes="h3" Margin="0,0,0,10" />
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBox Text="{Binding CustomerSearch, Mode=TwoWay}" Watermark="{Binding L[phone]}" MinHeight="40">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCustomerCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="brand" Margin="8,0,0,0" Command="{Binding SearchCustomerCommand}">
                            <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="White" />
                        </Button>
                    </Grid>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding CustomerResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Padding="10,8" Cursor="Hand"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[ItemsControl].DataContext.SelectCustomerCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Phone}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Text="{Binding CashbackBalance, StringFormat='{}{0:N0} 🎁'}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <Popup IsOpen="{Binding IsHeldPanelOpen, Mode=TwoWay}" Placement="Center" IsLightDismissEnabled="True">
            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Width="380" MaxHeight="460"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16"
                    BoxShadow="0 12 40 0 #33000000">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding L[held_sales]}" Classes="h3" Margin="0,0,0,10" />
                    <ScrollViewer>
                        <Panel>
                            <ItemsControl ItemsSource="{Binding HeldSales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <Button Grid.Column="1" Classes="brand" Padding="10,6" Margin="0,0,6,0"
                                                    Command="{Binding $parent[ItemsControl].DataContext.ResumeSaleCommand}"
                                                    CommandParameter="{Binding}" Content="{Binding $parent[ItemsControl].DataContext.L[resume]}" />
                                            <Button Grid.Column="2" Classes="paybtn" Padding="8,6"
                                                    Command="{Binding $parent[ItemsControl].DataContext.DiscardHeldCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Close" Width="14" Height="14"
                                                                 Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding L[no_data]}" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,20"
                                       IsVisible="{Binding !HeldSales.Count}" />
                        </Panel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

    </Grid>
</UserControl>
