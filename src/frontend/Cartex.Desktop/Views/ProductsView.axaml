<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cartex.Desktop.ViewModels"
             x:Class="Cartex.Desktop.Views.ProductsView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*" Margin="24">

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBox Watermark="{Binding L[search]}"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     Classes="search" MinWidth="300" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding L[refresh]}" Classes="outline"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  CornerRadius="6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="{Binding $parent[UserControl].((vm:ProductsViewModel)DataContext).L[name]}"
                                    Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="{Binding $parent[UserControl].((vm:ProductsViewModel)DataContext).L[category]}"
                                    Binding="{Binding CategoryName}" Width="150" />
                <DataGridTextColumn Header="{Binding $parent[UserControl].((vm:ProductsViewModel)DataContext).L[unit]}"
                                    Binding="{Binding UnitName}" Width="100" />
                <DataGridTextColumn Header="{Binding $parent[UserControl].((vm:ProductsViewModel)DataContext).L[min_stock]}"
                                    Binding="{Binding MinStock}" Width="100" />
                <DataGridTextColumn Header="{Binding $parent[UserControl].((vm:ProductsViewModel)DataContext).L[barcode]}"
                                    Binding="{Binding Barcodes[0]}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Top" Height="4" />
    </Grid>
</UserControl>
