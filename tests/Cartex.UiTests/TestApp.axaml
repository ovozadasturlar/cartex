<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Cartex.UI"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:uSemi="using:Ursa.Themes.Semi"
             x:Class="Cartex.UiTests.TestApp"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <ui:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Cartex.UI/Themes/Colors.axaml" />
                <ResourceInclude Source="avares://Cartex.UI/Themes/Brushes.axaml" />
                <ResourceInclude Source="avares://Cartex.UI/Themes/ThemeBrushes.axaml" />
                <ResourceInclude Source="avares://Cartex.UI/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="en-US" />
        <uSemi:UrsaSemiTheme Locale="en-US" />
        <StyleInclude Source="avares://Material.Icons.Avalonia/MaterialIconStyles.axaml" />
        <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />
        <StyleInclude Source="avares://Cartex.UI/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
